// 048B exploded views and Visualize: static guide text, no document state.
static bool onboarding048B(const AgentSession&,const std::string& topic,arkjson::Value& out){
    using V=arkjson::Value;if(topic!="exploded_views")return false;
    auto list=[](std::initializer_list<const char*> lines){V rows=V::makeArr();for(const auto* line:lines)rows.arr.push_back(V::makeStr(line));return rows;};
    out.set("tools",list({"doc_info","assembly_info","explode_info","doc_preview","doc_apply","motion_info","visualize_render","snapshot"}));
    out.set("authorization",V::makeStr("Author exploded views and produce visualize_render images only when the user explicitly asks for an exploded view, an assembly image or an assembly drawing, the same rule as 2D drawings. explode_info discovery stays available. Studio controls remain manual."));
    out.set("rules",list({
        "An exploded view is a named display layout over assembly instances: ordered steps, each moving a set of instances along a world direction by a distance. explode.set{name,steps:[{instances:[id|unique name],direction:+X|-X|+Y|-Y|+Z|-Z|[x,y,z],distance:mm number or parameter expression,with_previous?:bool,label?}],description?,replace?:true} creates or replaces one view; explode.rename{name,new_name}; explode.remove{name}. All use doc_apply/doc_preview with the observed expected_revision, are atomic and undoable.",
        "Factor t in [0,1] plays steps in order: every step owns one equal slice of t and moves linearly inside it; with_previous:true shares the previous step's slice. A step naming a group moves its descendants; offsets of several steps accumulate. Pattern instances move with all copies.",
        "Exploded positions are display transforms only. They never change B-rep, mates, placements, mass properties or clearance, and changing the factor never changes the revision. Measure, drive and inspect clearance on the assembled design.",
        "Rejections are explicit and atomic: EXPLODE_UNKNOWN_INSTANCE, EXPLODE_AMBIGUOUS_INSTANCE, EXPLODE_DUPLICATE_INSTANCE, EXPLODE_ZERO_DIRECTION, EXPLODE_NONFINITE_DISTANCE (|distance| <= 1e6 mm), EXPLODE_INVALID_EXPRESSION, EXPLODE_STEP_CAPACITY (64 steps, 256 instances per step), EXPLODE_CAPACITY (16 views), EXPLODE_NAME_CONFLICT (replace:false or rename onto an existing view), EXPLODE_NOT_FOUND, EXPLODE_VIEW_IN_USE (rename/remove while a motion channel drives the view), EXPLODE_INVALID.",
        "explode_info{} lists views; {name} returns resolved steps with unit direction, distance_mm, slice and factor_range; {name,factor} returns each moved occurrence's offset_mm; {propose:{axis?:auto|+X..-Z,scope?:leaf|top,gap_mm?,instances?,name?}} suggests an uncommitted explode.set from display bounding boxes. Review a proposal with the user before committing it.",
        "Link to the animation skeleton: a motion graph channel without mate may declare explode_view:<view name>; its value (0..1, MOTION_EXPLODE_RANGE otherwise) drives that view's factor. MOTION_UNKNOWN_EXPLODE_VIEW and MOTION_DUPLICATE_EXPLODE_VIEW reject. motion.bake stores the factor per frame in the channel coordinates (unit factor, explode_view in the bake channel row); Baked Motions playback applies it over the baked joint poses. A motion with only explode channels can be baked.",
        "visualize_render{exploded_view?,explode_factor?,motion?,motion_time_s?,view?,camera?,projection?,lighting?,background?,resolution?,samples?,balloons?,bom_table?,title?,expected_revision?} returns an inline PNG of display tessellation. balloons attach bom_inspect item numbers to the most visible occurrence of each item; bom_table draws item, name and quantity. A stale baked motion rejects with VISUALIZE_MOTION_STALE; a motion that already drives the requested view rejects with VISUALIZE_EXPLODE_CONFLICT. The image is presentation evidence, never geometric, clearance or manufacturing authority."}));
    V example,binding;
    arkjson::parse(R"JSON({"commands":[{"op":"explode.set","name":"Service","steps":[{"instances":["Lid"],"direction":"+Z","distance":"lid_lift","label":"Lid"},{"instances":["Screw A","Screw B"],"direction":"+Z","distance":40,"with_previous":true},{"instances":["Cartridge"],"direction":[1,0,0],"distance":120}]}]})JSON",example);
    arkjson::parse(R"JSON({"commands":[{"op":"motion.graph.set","name":"Explode and open","graph":{"channels":[{"name":"explode","explode_view":"Service","from":0,"curve":{"type":"sequence","items":[{"type":"ease","duration":2,"to":1},{"type":"hold","duration":1},{"type":"ease","duration":2,"to":0}]}},{"name":"door","mate":2,"from":0,"curve":{"type":"ease","duration":5,"to":90}}]}},{"op":"motion.bake","name":"Explode and open","fps":30}]})JSON",binding);
    out.set("explode_example",example);out.set("motion_binding_example",binding);
    out.set("next_step",V::makeStr("For a requested exploded view: assembly_info for instance names and grounding -> explode_info{propose:{}} or author steps -> doc_preview then doc_apply explode.set with expected_revision -> explode_info{name,factor:1} -> visualize_render{exploded_view,balloons:true,bom_table:true} only if the user asked for an image. In Studio, Model > Explode opens the Exploded Views and Visualize panel."));
    return true;
}
// Motion topic pointer to the explode binding.
static void onboardingExplodeMotion048B(arkjson::Value& r){r.set("explode_binding",arkjson::Value::makeStr("048B: a channel without mate may declare explode_view:<exploded view name> with values 0..1 to animate that exploded view with the joints; load agent_onboard{topic:exploded_views}."));}
