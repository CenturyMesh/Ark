// Static domain instructions: no vendor accounts, document state or network I/O.
static bool onboarding035B(const AgentSession& session,const std::string& topic,arkjson::Value& out){
    using V=arkjson::Value;if(topic!="plastics"&&topic!="vendors")return false;
    auto list=[](std::initializer_list<const char*> lines){V rows=V::makeArr();for(const auto* line:lines)rows.arr.push_back(V::makeStr(line));return rows;};
    if(topic=="plastics"){
        out.set("tools",list({"context_graph","object_context","native_inspect","geometry_query","doc_preview","doc_apply","manufacturing_inspect"}));
        out.set("rules",list({
            "Start with the intended finished part: overall envelope, interfaces, wall thickness and explicit material/process requirements. Hollow walls, reinforce, support a screw, fit a lid and separate a part are design intentions, not demands to design a mold. In Studio these actions live in Plastics. Do not create manufacturing drawings unless requested.",
            "Hollow walls uses native_solid inputs:[source], p:{op:shell,thickness:<signed mm>}, native:{faces:[semantic face names]}. Negative thickness hollows inward; selected faces open the solid. Inspect exact semantic faces first. Draft uses the existing native draft recipe with inspected faces/pull/neutral plane; read solids onboarding for the exact operation contract. Unsupported offsets or bad resulting B-rep reject atomically.",
            "Add a support with retained native_solid inputs:[source], native:{op:rib|gusset|mount_pad|boss|screw_support|nut_seat|lid_lip|lid_groove,source_face:<exact planar face>}, and p:{op:<same>,cx,cy,...}. Rib/gusset dimensions:length,thickness,height; boss/screw_support:radius,height,bore_radius; mount_pad:width,depth,height; nut_seat:across_flats,depth,angle; lid_lip:width,depth,wall,height; lid_groove:width,depth,wall,groove_depth. Coordinates use the measured support frame, not guessed global axes. Inspect source topology and native report. Disconnected additions and invalid pockets reject; a support envelope does not certify a purchased fastener or fit.",
            "Part separation is an explicit retained plane cut using the existing plane/solid recipes; inspect the intended kept side. Automatic mold parting, shut-off surfaces, core/cavity generation, shrinkage compensation, mold flow, undercut accessibility and ejection qualification are not established by these part-design tools.",
            "When molding or printing is required, read manufacturing onboarding and author the actual manufacturing route/process. Do not invent resin shrinkage, fit, minimum walls or ratings. Preview/check B-rep validity and the requested dimensions before one expected_revision publication. Keep assumptions and unmeasured process acceptance explicit."
        }));
        V example;arkjson::parse(R"({"commands":[{"op":"feature.add","type":"native_solid","name":"Wall rib","inputs":[1],"native":{"op":"rib","source_face":"z_max"},"p":{"op":"rib","cx":0,"cy":0,"length":20,"thickness":2,"height":8}}]})",example);example.set("expected_revision",V::makeNum((double)session.revision));out.set("example_doc_apply",example);out.set("example_scope",V::makeStr("Replace source 1 and z_max with inspected source/face; illustrative dimensions are not a verified target recipe."));
        out.set("next_step",V::makeStr("Locate the target with context_graph, inspect its exact planar support, then preview one coherent finished-part change."));
    }else{
        out.set("tools",list({"library_vendors","library_search","library_source_search","library_source_page","library_fetch","library_get","library_ingest","library_insert","context_graph"}));
        out.set("rules",list({
            "Search the local library first by exact manufacturer/reference and known dimensions. Inspect library_vendors{operation:list} to discover supported source IDs, approved network domains, site access, API access and adapter status. Approval permits a source request; it does not certify the vendor, product, geometry, stock or commercial terms. Read-only roles can list policy; only writable roles can update it.",
            "Changing local policy is library_vendors{operation:update,vendor:<observed id>,approved:<bool>,expected_revision:<observed policy revision>}. This revision belongs to the vendor policy, separately from library record revisions and CAD expected_revision. Do not approve sources merely to evade a rejected request; respect the user's sourcing requirements.",
            "For an approved source, library_source_search{source:<observed vendor id>,query:<exact known part/manufacturer>,root?} returns lexical candidates or an explicit unavailable/access error. Read an actual product page with library_source_page{url,vendor,root?}; retain observed download/resource links. Public Windows HTTPS fetching does not execute JavaScript or reuse browser login cookies. A browser login and an authorized API adapter are different capabilities; an unconfigured/partner-required API is not working merely because it is listed.",
            "Only fetch an observed actual STEP resource. library_fetch validates the bytes, source policy and native body inventory, retains original SHA256/download evidence and stores the component locally. If multiple solids are present, choose an explicit body_index or all_bodies after inspection. An HTML login page, ZIP archive or a site homepage is not a STEP file. Never fabricate a model URL or product match.",
            "Inspect library_get, compare the required manufacturer/reference/dimensions and source/license evidence, then library_insert at current CAD expected_revision. Document sourcing_status:selected needs genuine product evidence; a downloaded valid solid alone does not prove the requested product. Missing credentials, unavailable APIs, blocked pages and unmatched dimensions remain explicit unresolved requirements. Never put passwords, cookies, tokens or signed credential URLs into project graphs, notes or BOM."
        }));
        out.set("next_step",V::makeStr("List approved sources and their real access state, then search the exact requested part. Use components onboarding for local ingestion/placement and preserve every failed attempt."));
    }
    return true;
}
