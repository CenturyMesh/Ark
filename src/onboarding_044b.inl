// 044B Skeleton Motion: static guide text for the motion topic.
static void onboardingSkeletonMotion044B(arkjson::Value& r){
    using V=arkjson::Value;
    auto list=[](std::initializer_list<const char*> strings){V a=V::makeArr();for(auto s:strings)a.arr.push_back(V::makeStr(s));return a;};
    V guide=V::makeObj();
    guide.set("purpose",V::makeStr("Skeleton motion animates existing assembly joints with a persisted vector motion graph, then bakes it through the joint solver for playback in Studio's Baked Motions panel. The skeleton is the set of revolute (deg) and prismatic (mm) mates with a grounded moving side; author those joints, limits and grounding first with the assembly contract. Graphs are segments and composition nodes, never keyframe lists."));
    guide.set("operations",list({
        "motion.graph.set{name,graph} creates or replaces a named graph after validating joints, limits, continuity and couplings. Replacing the graph of a baked motion keeps its bake, now reported stale (graph_changed).",
        "motion.bake{name,fps?:1..240 default 30} evaluates the graph at fps, drives every bound joint frame by frame with the same solver, limits and residual checks as assembly.drive, and stores only moving instances as float32 column-major poses plus measured joint coordinates. It records source_revision, source_digest (assembly, mates, parameters and solved placements) and graph_digest.",
        "motion.rename{name,new_name} and motion.remove{name}. All motion operations use doc_apply/doc_preview with the observed expected_revision, are atomic and undoable, and never change authored placements.",
        "motion_info{} lists motions with stale status; motion_info{name} returns graph, joint bindings, C0/C1 continuity, sampled ranges and the bake summary; motion_info{graph} validates without writing; motion_info{name,time_s,solve?} evaluates channel values and optionally solved instance matrices; motion_info{name,frame} decodes one baked frame. Reads never change revision or placements."}));
    guide.set("graph",V::makeStr("graph:{channels:[channel],duration_s?:total (default longest curve; shorter channels hold their end value),allow_jumps?:false,description?}. channel:{name:identifier,mate?:numeric revolute/prismatic mate ID,from?:start value,curve:node | expr:coupling}. A curve channel without from starts at the joint's current measured coordinate (B relative to A, the assembly.drive coordinate). A channel without mate is a signal used only by couplings. expr channels are couplings evaluated with the expression engine over other channel names, t (seconds) and document parameters, e.g. elbow expr \"0.5*shoulder+10\"; cyclic couplings reject."));
    guide.set("nodes",list({
        "Segments (duration in s; values are numbers or parameter expressions; from defaults to the previous end value): hold{duration,value?}, linear{duration,to}, ease{duration,to,ease:in|out|in_out}, bezier{duration,to,c1:[t,v],c2:[t,v]} cubic Bezier in (time,value) with control times strictly inside (0,duration), sine{duration,amplitude,period_s,center?,phase_deg?}, spring{duration,to,frequency_hz,damping?}, function{duration,expr in t,u=t/duration,from}.",
        "Composition: sequence{items} plays in order and chains start values; parallel{items,combine:add|min|max} layers items (add: later items start from 0); delay{seconds,item} holds the item's start; repeat{count,item}; ping_pong{count?,item} plays forward then mirrored back; reverse{item}; time_scale{item,factor | duration}; offset{item,value?,gain?}. Nesting is bounded to 16 levels and 512 nodes."}));
    guide.set("validation",list({
        "Rejections are explicit and atomic: MOTION_UNKNOWN_JOINT, MOTION_UNSUPPORTED_JOINT (only revolute/prismatic), MOTION_DUPLICATE_JOINT, MOTION_JOINT_NOT_DRIVABLE (no grounded moving side), MOTION_LIMIT_VIOLATION (graph sampled at 240 Hz plus every segment boundary against evaluated limits), MOTION_DISCONTINUITY (a value jump between segments unless allow_jumps:true), MOTION_NONFINITE, MOTION_INVALID_EXPRESSION, MOTION_COUPLING_CYCLE, MOTION_BEZIER_NOT_MONOTONIC.",
        "Bake rejections: MOTION_BAKE_REJECTED (the joint solver refused a frame, with frame, time, channel and solver code), MOTION_CHANNEL_CONFLICT (a coupled or shared joint cannot follow two channels), MOTION_FRAME_STEP_TOO_LARGE (unlimited revolute turning 180 deg or more between frames; raise fps), MOTION_BAKE_CAPACITY (16384 moving instance-frames per motion, 7201 frames, 2 MiB of frames per document). Do not widen limits or tolerances to pass; change the graph or the joints.",
        "Continuity is reported per channel as C1, C0 (velocity break) or discontinuous, with loop_continuity for end-to-start playback. A bake becomes stale when the assembly, mates, parameters or solved placements change (assembly_changed) or the graph changes (graph_changed); it stays playable and is flagged until motion.bake runs again."}));
    guide.set("limits",V::makeStr("Ideal kinematics only: poses come from joint coordinates, grounded supports and couplings. There is no dynamics, inertia, force, contact or continuous collision checking; clearance_checked and dynamics_checked are false. Check sampled clearance separately with assembly_info sweep or collision_inspect. Playback in Studio overrides display transforms only and shows baked frames, never interpolated poses."));
    V door,robot;
    arkjson::parse(R"JSON({"commands":[{"op":"motion.graph.set","name":"Window down and up","graph":{"channels":[{"name":"glass","mate":1,"from":0,"curve":{"type":"sequence","items":[{"type":"ease","duration":2,"to":"-glass_travel","ease":"in_out"},{"type":"hold","duration":0.5},{"type":"ease","duration":2,"to":0}]}}]}},{"op":"motion.bake","name":"Window down and up","fps":30}]})JSON",door);
    arkjson::parse(R"JSON({"commands":[{"op":"motion.graph.set","name":"Robot wave","graph":{"channels":[{"name":"shoulder","mate":1,"from":0,"curve":{"type":"sequence","items":[{"type":"ease","duration":1,"to":30},{"type":"sine","duration":2,"amplitude":15,"period_s":1},{"type":"ease","duration":1,"to":0}]}},{"name":"elbow","mate":2,"expr":"0.5*shoulder+10"},{"name":"wrist","mate":3,"from":0,"curve":{"type":"ping_pong","count":2,"item":{"type":"bezier","duration":1,"to":40,"c1":[0.3,0],"c2":[0.7,40]}}}]}},{"op":"motion.bake","name":"Robot wave","fps":30}]})JSON",robot);
    guide.set("door_glass_example",door);guide.set("robot_wave_example",robot);
    guide.set("workflow",V::makeStr("Inspect assembly_info for mate IDs, types, limits and grounding -> motion_info{graph} to validate -> doc_apply motion.graph.set and motion.bake with expected_revision -> motion_info{name} for stale status and continuity. The user plays, scrubs, loops, renames or deletes baked motions in Studio Model > Motions."));
    r.set("skeleton_motion",guide);
}
