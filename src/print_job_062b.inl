static Mat4 plateTransform062(const V& item){const auto& a=get(item,"placement");require(a.t==V::Arr&&a.arr.size()==16,"plate placement needs 16 values");Mat4 m;for(int i=0;i<16;++i){require(a.arr[i].t==V::Num&&std::isfinite(a.arr[i].num)&&std::abs(a.arr[i].num)<1e6,"invalid plate placement");m.m[i]=a.arr[i].num;}require(m.m[3]==0&&m.m[7]==0&&m.m[11]==0&&m.m[15]==1,"plate placement must be affine");auto x=m.transformDir({1,0,0}),y=m.transformDir({0,1,0}),z=m.transformDir({0,0,1});require(std::abs(x.lensq()-1)<1e-9&&std::abs(y.lensq()-1)<1e-9&&std::abs(z.lensq()-1)<1e-9&&std::abs(x.dot(y))<1e-9&&std::abs(x.dot(z))<1e-9&&std::abs(y.dot(z))<1e-9&&x.cross(y).dot(z)>0,"plate placement must be rigid and right-handed");return m;}
static void validatePlate062(const V& data){
