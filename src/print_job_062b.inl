    const auto& items=get(data,"items");require(items.t==V::Arr&&!items.arr.empty()&&items.arr.size()<=1024,"plate needs 1..1024 items");for(const auto& item:items.arr){keys(item,{"part","placement","copy"});text(item,"part");plateTransform062(item);require(num(item,"copy")>=0&&num(item,"copy")==std::floor(num(item,"copy")),"invalid plate copy");}
