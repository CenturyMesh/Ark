static AABB printSourceBounds062(const Body& b){const auto& a=get(get(b.nativeData,"report"),"bounds_mm");require(a.t==V::Arr&&a.arr.size()==6,"exact source bounds required");AABB box;box.grow({a.arr[0].num,a.arr[1].num,a.arr[2].num});box.grow({a.arr[3].num,a.arr[4].num,a.arr[5].num});return box;}
Mesh printPlateMesh062(const Document& d,const Graph& g,const V& plate){
    validatePlate062(plate);auto bed=vec(plate,"bed_mm");double margin=num(plate,"margin_mm"),gap=num(plate,"gap_mm");Mesh mesh;std::vector<AABB> placed;
    for(const auto& item:get(plate,"items").arr){const auto& source=g.data(text(item,"part"),"part");require(sourceDigest(d,source)==text(source,"source_sha256"),"STALE_SOURCE: plate part changed; prepare the job again");const auto* b=body(d,(u64)num(source,"feature"));auto transform=plateTransform062(item);auto bounds=printSourceBounds062(*b).transformed(transform);
