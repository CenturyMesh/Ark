void enrichModeling031BSchemas(V& tools){
    auto json=[](const char* text){V v;if(!arkjson::parse(text,v))throw std::runtime_error("Invalid built-in031B schema");return v;};
    for(auto& tool:tools.arr){const auto* name=tool.find("name");if(!name)continue;const auto* source=tool.find("inputSchema");if(!source||!source->find("properties"))continue;V schema=*source,props=*source->find("properties");
        if(name->str=="mesh_inspect")props.set("self_intersections",json(R"({"type":"boolean","description":"Run a complete bounded indexed triangle self-intersection diagnosis; capacity exhaustion rejects instead of returning partial clearance."})"));
        if(name->str=="reference_inspect")props.set("detail",json(R"({"type":"string","enum":["full","frame"],"description":"frame requires reference or find and omits the full topology inventory."})"));
        if(name->str=="assembly_info")props.set("sweep",json(R"({"type":"object","properties":{"driver":{"type":["integer","string"]},"mate":{"type":"integer","minimum":1},"mode":{"type":"string","enum":["rotate","translate"]},"from":{"type":"number"},"to":{"type":"number"},"samples":{"type":"integer","minimum":2,"maximum":65},"pairs":{"type":"array","maxItems":64,"items":{"type":"object","properties":{"a":{"type":["integer","string"]},"b":{"type":["integer","string"]},"copy_a":{"type":"integer","minimum":0,"maximum":31},"copy_b":{"type":"integer","minimum":0,"maximum":31}},"required":["a","b"],"additionalProperties":false}},"cables":{"type":"array","maxItems":32,"items":{"type":"integer","minimum":1}},"collision_mode":{"type":"string","enum":["exact","mesh"]}},"required":["driver","from","to","samples"],"additionalProperties":false,"description":"Read-only sampled joint-pose inspection. Exact pairs measure actual common volume/distance; mesh pairs retain triangle authority. Cable occurrence bindings re-evaluate at each pose. No between-sample or dynamics guarantee."})"));
        if(name->str=="geometry_query")if(const auto* qs=props.find("queries"))if(const auto* it=qs->find("items")){
            V queries=*qs,item=*it,fields=item.find("properties")?*item.find("properties"):V::makeObj();
            if(!fields.find("action"))fields.set("action",json(R"({"type":"string","enum":["references","properties","curve","surface","continuity","point_distance","section"]})"));
            fields.set("filter",json(R"({"type":"object","properties":{"kind":{"type":"string","enum":["face","edge","axis"]},"surface":{"type":"string"},"normal":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"axis":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"radius_mm":{"type":"number","exclusiveMinimum":0},"near":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},"within_mm":{"type":"number","minimum":0},"adjacent_to":{"type":"string"},"tolerance_mm":{"type":"number","exclusiveMinimum":0},"angle_tolerance_deg":{"type":"number","exclusiveMinimum":0},"coaxial_origin":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}},"additionalProperties":false,"description":"Nested inside each references action, e.g. queries:[{action:references,filter:{kind:face,surface:plane}}]. Tolerances select references; they do not loosen geometry construction."})"));item.set("properties",fields);queries.set("items",item);props.set("queries",queries);schema.set("additionalProperties",V::makeBool(false));
        }
        if(name->str=="library_source_page")if(const auto* description=tool.find("description"))tool.set("description",V::makeStr(description->str+" Returns observed resolved HTTPS links and resource_links (STEP/IGES/PDF/drawings); resource types are inferred and target bytes remain unverified."));
        schema.set("properties",props);tool.set("inputSchema",schema);
    }
}
