constexpr double vertexPullTolerance=1e-6;
V withNativeVertexInventory(V result){
    const auto* encoded=result.find("brep_base64");if(!encoded||encoded->t!=V::Str)return result;
    const std::string hash=digest(encoded->str);TopTools_IndexedMapOfShape vertices;TopExp::MapShapes(readBrep(encoded->str),TopAbs_VERTEX,vertices);
    V topology=result.find("topology")?*result.find("topology"):V::makeObj(),rows=V::makeArr();topology.set("brep_sha256",V::makeStr(hash));
    const bool complete=vertices.Extent()<=16384;if(complete)for(int i=1;i<=vertices.Extent();++i){const auto p=BRep_Tool::Pnt(TopoDS::Vertex(vertices(i)));V row=V::makeObj();row.set("name",V::makeStr("vertex."+std::to_string(i-1)));row.set("point_mm",xyz(p));row.set("source_topology",V::makeStr(hash));row.set("persistent",V::makeBool(false));rows.arr.push_back(row);}
    topology.set("vertices",rows);topology.set("vertex_inventory_complete",V::makeBool(complete));topology.set("vertex_reference_scope",V::makeStr("current_exact_brep_digest"));result.set("topology",topology);return result;
}
struct VertexPullFace {TopoDS_Face source;std::vector<int> indices;std::vector<gp_Pnt> points;gp_Vec normal;std::vector<TopoDS_Face> replacements;};
gp_Vec polygonNormal(const std::vector<gp_Pnt>& points){gp_Vec normal;for(size_t i=1;i+1<points.size();++i)normal+=gp_Vec(points[0],points[i]).Crossed(gp_Vec(points[0],points[i+1]));return normal;}
double signedPolygonVolume(const std::vector<gp_Pnt>& points){double v=0;for(size_t i=1;i+1<points.size();++i)v+=points[0].XYZ().Dot(points[i].XYZ().Crossed(points[i+1].XYZ()))/6;return v;}
void convexPullPolygon(const std::vector<gp_Pnt>& points,const gp_Vec& normal){
    for(size_t i=0;i<points.size();++i){const auto& a=points[i];const auto& b=points[(i+1)%points.size()];const auto& c=points[(i+2)%points.size()];if(a.Distance(b)<=vertexPullTolerance||gp_Vec(a,b).Crossed(gp_Vec(b,c)).Dot(normal)<=1e-12)throw std::runtime_error("Vertex pull requires nondegenerate convex triangle/quad boundaries");}
}
TopoDS_Face pullPlanarFace(const std::vector<gp_Pnt>& points,const gp_Vec& priorNormal){
    const auto normal=polygonNormal(points);if(normal.Magnitude()<=1e-12||normal.Dot(priorNormal)<=1e-12)throw std::runtime_error("Vertex displacement degenerates or reverses an incident face");convexPullPolygon(points,normal.Normalized());
    BRepBuilderAPI_MakePolygon wire;for(auto p:points)wire.Add(p);wire.Close();if(!wire.IsDone())throw std::runtime_error("Vertex pull face wire failed");BRepBuilderAPI_MakeFace face(wire.Wire(),true);if(!face.IsDone()||!BRepCheck_Analyzer(face.Face()).IsValid())throw std::runtime_error("Vertex pull did not build a valid exact planar face");return face.Face();
}
bool unchangedPullEdge(const TopoDS_Shape& a,const TopoDS_Shape& b){
    if(BRepAdaptor_Curve(TopoDS::Edge(a)).GetType()!=GeomAbs_Line||BRepAdaptor_Curve(TopoDS::Edge(b)).GetType()!=GeomAbs_Line)return false;
    TopoDS_Vertex av,bv,cv,dv;TopExp::Vertices(TopoDS::Edge(a),av,bv);TopExp::Vertices(TopoDS::Edge(b),cv,dv);if(av.IsNull()||bv.IsNull()||cv.IsNull()||dv.IsNull())return false;
    const auto p=BRep_Tool::Pnt(av),q=BRep_Tool::Pnt(bv),r=BRep_Tool::Pnt(cv),s=BRep_Tool::Pnt(dv);return (p.Distance(r)<=vertexPullTolerance&&q.Distance(s)<=vertexPullTolerance)||(p.Distance(s)<=vertexPullTolerance&&q.Distance(r)<=vertexPullTolerance);
}
void validatePullSelfInterference(const TopoDS_Shape& shape,const char* context){
    BOPAlgo_ArgumentAnalyzer analyzer;analyzer.SetShape1(shape);analyzer.SelfInterMode()=true;analyzer.ArgumentTypeMode()=false;analyzer.SmallEdgeMode()=false;analyzer.RebuildFaceMode()=false;analyzer.TangentMode()=false;analyzer.MergeVertexMode()=false;analyzer.MergeEdgeMode()=false;analyzer.ContinuityMode()=false;analyzer.CurveOnSurfaceMode()=false;analyzer.StopOnFirstFaulty()=true;analyzer.SetRunParallel(false);analyzer.Perform();if(analyzer.HasErrors()||analyzer.HasFaulty())throw std::runtime_error(std::string(context)+" has exact self-interference");
}
