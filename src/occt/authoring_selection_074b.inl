    auto output=retained.size()==1?finish(result,refs):finishBodies(result,refs);output=bodyInventory074(std::move(output),result);receipt.set("source_bodies",std::move(rows));receipt.set("retained_volume_mm3",V::makeNum(kept));receipt.set("explicitly_omitted_volume_mm3",V::makeNum(omitted));receipt.set("source_body_count",V::makeNum(solids.size()));receipt.set("retained_body_count",V::makeNum(retained.size()));V report=need(output,"report");report.set("body_selection",receipt);output.set("report",std::move(report));return output;
}
