    else{if(points->t!=V::Arr||points->arr.empty()||points->arr.size()>solids.size())throw std::runtime_error("Body selection needs 1..source_body_count interior points");for(const auto& coordinates:points->arr){const auto p=point(coordinates,"Body interior point");int found=-1;for(size_t i=0;i<solids.size();++i){BRepClass3d_SolidClassifier where(solids[i],p,Precision::Confusion());if(where.State()==TopAbs_ON)throw std::runtime_error("Body selection point lies on a boundary");if(where.State()==TopAbs_IN){if(found>=0)throw std::runtime_error("Body selection point lies in overlapping bodies");found=(int)i;}}if(found<0||!selected.insert((size_t)found).second)throw std::runtime_error("Body point selects no body or repeats an earlier body");}receipt.set("selection",V::makeStr("strict_interior_points"));receipt.set("points_mm",*points);}
