// Source-owned selection features. Points are predicates on the exact B-rep;
// they never select the nearest face/body or change the source geometry.
V authoringSelection074(const V& request){
    const auto op=word(request,"op"),encoded=word(request,"input_brep"),identity=digest(encoded);const auto input=readBrep(encoded);const auto solids=checkedSolids074(input);auto refs=inputRefs(request,"input_brep","input_topology",input);V receipt=V::makeObj();
    receipt.set("source_brep_sha256",V::makeStr(identity));receipt.set("geometry_authority",V::makeStr("exact_brep"));receipt.set("nearest_selection",V::makeBool(false));
    if(op=="reference_anchor"){
        const auto alias=word(request,"alias");if(alias.size()>160||alias.find("@ark.")!=std::string::npos)throw std::runtime_error("Anchor alias must be a semantic name of at most160 characters");for(const auto& ref:refs)if(ref.name==alias)throw std::runtime_error("Anchor alias already exists; choose a distinct semantic name");const auto witness=point(need(request,"point"),"Anchor point");std::vector<TopoDS_Shape> candidates;
        if(const auto* source=request.find("source_reference")){if(source->t!=V::Str||source->str.empty())throw std::runtime_error("Anchor source_reference must be a named face");const Ref* owner=nullptr;for(const auto& ref:refs)if(ref.name==source->str)owner=&ref;if(!owner||owner->kind!="face"||owner->status=="obsolete"||owner->status=="deleted")throw std::runtime_error("Anchor source face is missing, obsolete or deleted");if(selectable(owner->status))candidates.push_back(owner->shape);else if(owner->status=="split")candidates=owner->descendants;if(candidates.empty())throw std::runtime_error("Anchor source face has no verifiable current descendants");receipt.set("source_reference",*source);receipt.set("candidate_scope",V::makeStr("source_face_descendants"));}
