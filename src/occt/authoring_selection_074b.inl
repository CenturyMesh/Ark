        for(const auto& candidate:candidates){if(candidate.ShapeType()!=TopAbs_FACE||indexOf(input,candidate,TopAbs_FACE)<0)throw std::runtime_error("Anchor lineage contains a noncurrent face");const auto face=TopoDS::Face(candidate);const double tolerance=BRep_Tool::Tolerance(face);GeomAPI_ProjectPointOnSurf projected(witness,BRep_Tool::Surface(face));bool inside=false;
            for(int i=1;i<=projected.NbPoints();++i){if(projected.Distance(i)>tolerance)continue;double u=0,v=0;projected.Parameters(i,u,v);BRepClass_FaceClassifier classified(face,gp_Pnt2d(u,v),tolerance);if(classified.State()==TopAbs_ON)throw std::runtime_error("Anchor point lies on a face boundary; choose an interior point");if(classified.State()==TopAbs_IN){inside=true;uv.arr={V::makeNum(u),V::makeNum(v)};}}
            if(inside){selected=face;++matches;}
        }
