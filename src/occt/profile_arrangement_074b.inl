    for(size_t i=0;i<cells.size();++i){auto& cell=cells[i];V row=V::makeObj(),sources=V::makeArr(),box=V::makeArr();std::set<std::string> allNames;std::vector<std::pair<std::string,TopoDS_Edge>> edges;for(const auto& edge:shapes(cell.face,TopAbs_EDGE)){const int part=unique.FindIndex(edge);if(!part)throw std::runtime_error("Cell boundary is not bound to an authored split edge");for(const auto& name:aliases[(size_t)part-1])allNames.insert(name);edges.push_back({"cell."+std::to_string(i)+".edge."+std::to_string(part-1),TopoDS::Edge(edge)});}for(const auto& name:allNames)sources.arr.push_back(V::makeStr(name));for(double value:cell.box)box.arr.push_back(V::makeNum(value));row.set("index",V::makeNum(i));row.set("label",V::makeStr("Cell "+std::to_string(i+1)));row.set("area_mm2",V::makeNum(cell.area));row.set("hole_count",V::makeNum(shapes(cell.face,TopAbs_WIRE).size()-1));row.set("source_edges",std::move(sources));row.set("bounds_local_mm",std::move(box));row.set("selected",V::makeBool(selected[i]));
        auto inside=[&](const gp_Pnt& point){BRepClass_FaceClassifier classification(cell.face,point,1e-7);if(classification.State()!=TopAbs_IN)return false;for(const auto& edge:edges){BRepExtrema_DistShapeShape distance(BRepBuilderAPI_MakeVertex(point).Vertex(),edge.second);if(!distance.IsDone()||distance.Value()<=1e-6)return false;}return true;};
        gp_Pnt point=cell.center;bool found=inside(point);for(int grid:{17,65}){for(int y=1;y<grid&&!found;++y)for(int x=1;x<grid&&!found;++x){gp_Pnt candidate(cell.box[0]+(cell.box[3]-cell.box[0])*x/grid,cell.box[1]+(cell.box[4]-cell.box[1])*y/grid,0);if(inside(candidate)){point=candidate;found=true;}}if(found)break;}if(found){V seed=V::makeArr();seed.arr={V::makeNum(point.X()),V::makeNum(point.Y())};row.set("seed_point",std::move(seed));}
        rows.arr.push_back(std::move(row));if(!selected[i])continue;selectedRows.arr.push_back(V::makeNum(i));BRepBuilderAPI_Transform moved(cell.face,placement,true);if(!moved.IsDone())throw std::runtime_error("Arrangement frame placement failed");for(const auto& edge:edges){auto placed=moved.ModifiedShape(edge.second);if(placed.IsNull())throw std::runtime_error("Arrangement boundary lost during frame placement");result.edges.push_back({edge.first,TopoDS::Edge(placed)});}result.faces.push_back(TopoDS::Face(moved.Shape()));result.labels.push_back("Cell "+std::to_string(i+1));
    }
