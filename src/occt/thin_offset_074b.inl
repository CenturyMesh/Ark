}
TopoDS_Shape offsetRegionFaces074(const TopoDS_Shape& offset,const gp_Vec& normal){
    
    const auto wires=shapes(offset,TopAbs_WIRE);if(wires.empty()||wires.size()>256)throw std::runtime_error("Thin offset did not produce 1..256 closed boundaries");
    std::vector<TopoDS_Face> faces;std::vector<double> areas;std::vector<int> depth(wires.size(),0),parent(wires.size(),-1);
    for(const auto& wire:wires){if(!BRep_Tool::IsClosed(wire))throw std::runtime_error("Thin offset produced an open boundary");auto face=boundedThinFace074(TopoDS::Wire(wire),normal);if(thinNormal073(face).Dot(normal)<0)face.Reverse();faces.push_back(face);areas.push_back(std::abs(properties(face,'a')));}
    for(size_t i=0;i<wires.size();++i)for(size_t j=0;j<wires.size();++j)if(i!=j){
        BRepExtrema_DistShapeShape separation(wires[i],wires[j]);if(!separation.IsDone()||separation.Value()<=Precision::Confusion())throw std::runtime_error("Thin offset boundaries touch or intersect; no boundary is discarded");
        const auto edges=shapes(wires[i],TopAbs_EDGE);if(edges.empty())throw std::runtime_error("Thin offset contains an empty boundary");BRepAdaptor_Curve curve(TopoDS::Edge(edges.front()));BRepClass_FaceClassifier where(faces[j],curve.Value((curve.FirstParameter()+curve.LastParameter())*.5),Precision::Confusion());
        if(where.State()==TopAbs_IN){++depth[i];if(parent[i]<0||areas[j]<areas[(size_t)parent[i]])parent[i]=(int)j;}
    }
    
    std::vector<TopoDS_Shape> result;for(size_t i=0;i<faces.size();++i)if(depth[i]%2==0){BRepBuilderAPI_MakeFace maker(faces[i]);double expected=areas[i];bool added=false;for(size_t j=0;j<faces.size();++j)if(parent[j]==(int)i&&depth[j]%2){auto hole=BRepTools::OuterWire(faces[j]);hole.Reverse();maker.Add(hole);added=true;expected-=areas[j];}if(added&&!maker.IsDone())throw std::runtime_error("Thin offset holes could not be retained");auto face=added?maker.Face():faces[i];checkThinFace073(face);if(expected<=0||std::abs(std::abs(properties(face,'a'))-expected)>std::max(1e-9,areas[i]*1e-9))throw std::runtime_error("Thin offset boundary area is inconsistent");result.push_back(face);}
    if(result.empty())throw std::runtime_error("Thin offset has no retained region");return result.size()==1?result.front():compound(result);
}
ThinOffset074 thinOffset074(const TopoDS_Face& source,const TopoDS_Wire& openSource,const gp_Vec& normal,const V& request){
    
    if(!openSource.IsNull())return thinOpenOffset074(openSource,normal,request);
    if(source.IsNull()||BRepAdaptor_Surface(source).GetType()!=GeomAbs_Plane)throw std::runtime_error("Thin offset source must be an exact planar region");checkThinFace073(source);
    const double thickness=positive(request,"thickness");if(thickness<=1e-6)throw std::runtime_error("Thin thickness must exceed 1e-6 mm");const auto side=word(request,"thin_side"),join=request.find("thin_join")?word(request,"thin_join"):"arc";
    if(side!="inside"&&side!="outside"&&side!="symmetric")throw std::runtime_error("Closed offset thin side must be inside, outside or symmetric");if(join!="arc"&&join!="intersection")throw std::runtime_error("Thin join must be arc or intersection");
    const auto sourceWires=shapes(source,TopAbs_WIRE);const auto outerWire=BRepTools::OuterWire(source);
    auto offset=[&](double distance){
        if(distance==0)return TopoDS_Shape(source);std::vector<TopoDS_Shape> boundaries;
        // Offset each exact closed boundary independently. For a hole the
        // material-facing direction is opposite to that of its bounded disk.
        // Reconstruct nesting below and reject topology changes/intersections.
        // This construction also avoids OCCT8's multi-wire Perform crash.
        for(const auto& boundary:sourceWires){
            const auto disk=boundedThinFace074(TopoDS::Wire(boundary),normal);const double amount=boundary.IsSame(outerWire)?distance:-distance;
            
            BRepOffsetAPI_MakeOffset maker(disk,join=="arc"?GeomAbs_Arc:GeomAbs_Intersection,false);maker.SetApprox(false);maker.Perform(amount);
            if(!maker.IsDone()||maker.Shape().IsNull())throw std::runtime_error("Exact thin offset failed; requested thickness and tolerance were not changed");const auto outputWires=shapes(maker.Shape(),TopAbs_WIRE);if(outputWires.size()!=1||!BRep_Tool::IsClosed(outputWires.front()))throw std::runtime_error("Thin offset collapsed or split a boundary; choose a smaller thickness");
            for(const auto& edge:shapes(boundary,TopAbs_EDGE)){bool retained=false;for(TopTools_ListIteratorOfListOfShape it(maker.Generated(edge));it.More();it.Next())if(indexOf(maker.Shape(),it.Value(),TopAbs_EDGE)>=0){retained=true;break;}if(!retained)throw std::runtime_error("Thin offset lost an authored boundary edge; reduce thickness or repair the profile");}
            boundaries.push_back(outputWires.front());
        }
        return offsetRegionFaces074(compound(boundaries),normal);
    };
    const double outside=side=="outside"?thickness:side=="symmetric"?thickness*.5:0,inside=side=="inside"?-thickness:side=="symmetric"?-thickness*.5:0;
    auto outer=offset(outside),inner=offset(inside);BRepAlgoAPI_Cut containment(inner,outer);containment.SetNonDestructive(true);containment.Build();if(!containment.IsDone()||containment.HasErrors()||!shapes(containment.Shape(),TopAbs_FACE).empty())throw std::runtime_error("Thin offset reversed nesting or lost an inner region");
    BRepAlgoAPI_Cut band(outer,inner);band.SetNonDestructive(true);band.SetRunParallel(nativeThreadBudget()>1);band.Build();if(!band.IsDone()||band.HasErrors())throw std::runtime_error("Exact thin offset band failed");const auto faces=shapes(band.Shape(),TopAbs_FACE);if(faces.empty()||faces.size()>64)throw std::runtime_error("Thin offset must retain 1..64 positive wall regions");
    const bool bodies=request.find("result_mode")&&word(request,"result_mode")=="bodies";if(faces.size()>1&&!bodies)throw std::runtime_error("Thin offset contains separate walls around holes; explicitly select result_mode bodies to retain every wall");
    ThinOffset074 out;double area=0;for(size_t i=0;i<faces.size();++i){ThinProfile073 part;part.face=TopoDS::Face(faces[i]);if(thinNormal073(part.face).Dot(normal)<0)part.face.Reverse();checkThinFace073(part.face);area+=std::abs(properties(part.face,'a'));size_t edgeIndex=0;for(const auto& edge:shapes(part.face,TopAbs_EDGE))part.edges.push_back({"thin.wall."+std::to_string(i)+".edge."+std::to_string(edgeIndex++),TopoDS::Edge(edge)});out.parts.push_back(std::move(part));}
    const double expected=std::abs(properties(outer,'a'))-std::abs(properties(inner,'a'));if(expected<=0||std::abs(area-expected)>std::max(1e-8,expected*1e-8))throw std::runtime_error("Thin offset walls do not conserve exact band area");
    out.report.set("method",V::makeStr("offset"));out.report.set("join",V::makeStr(join));out.report.set("side",V::makeStr(side));out.report.set("thickness_mm",V::makeNum(thickness));out.report.set("source_boundaries",V::makeNum(sourceWires.size()));out.report.set("wall_regions",V::makeNum(faces.size()));out.report.set("area_mm2",V::makeNum(area));out.report.set("curve_approximation",V::makeBool(false));out.report.set("discarded_boundaries",V::makeNum(0));out.report.set("tolerance_changed",V::makeBool(false));return out;
}
