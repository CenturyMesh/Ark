    if(sourceEdges.size()==1&&BRepAdaptor_Curve(sourceEdges.front()).GetType()==GeomAbs_Line){auto part=thinProfile073(source,normal,thickness,side,{});ThinOffset074 result;result.report=part.report;result.report.set("method",V::makeStr("offset"));result.report.set("join",V::makeStr(join));result.parts.push_back(std::move(part));return result;}
    TopoDS_Vertex sourceStart,sourceEnd;TopExp::Vertices(source,sourceStart,sourceEnd);if(sourceStart.IsNull()||sourceEnd.IsNull())throw std::runtime_error("Open thin offset has no endpoints");
    auto directedTangent=[](const TopoDS_Edge& edge,bool end){BRepAdaptor_Curve curve(edge);const bool reversed=edge.Orientation()==TopAbs_REVERSED;gp_Pnt p;gp_Vec tangent;curve.D1((end!=reversed)?curve.LastParameter():curve.FirstParameter(),p,tangent);if(reversed)tangent.Reverse();if(tangent.Magnitude()<=1e-12)throw std::runtime_error("Thin endpoint tangent is undefined");tangent.Normalize();return tangent;};
    const gp_Vec startLeft=normal.Crossed(directedTangent(sourceEdges.front(),false)),endLeft=normal.Crossed(directedTangent(sourceEdges.back(),true));if(std::abs(startLeft.Magnitude()-1)>1e-10||std::abs(endLeft.Magnitude()-1)>1e-10)throw std::runtime_error("Thin path endpoints leave the source plane");
    BRepLib_FindSurface support(source,-1,true,false);const auto plane=Handle(Geom_Plane)::DownCast(support.Surface());if(!support.Found()||plane.IsNull())throw std::runtime_error("Open offset path must define one exact plane");const auto supportPlane=plane->Pln().Transformed(support.Location().Transformation());const double alignment=gp_Vec(supportPlane.Axis().Direction()).Dot(normal);if(std::abs(std::abs(alignment)-1)>1e-10)throw std::runtime_error("Open offset support plane differs from the declared source plane");
    auto offset=[&](double left){if(left==0)return source;BRepOffsetAPI_MakeOffset maker(source,join=="arc"?GeomAbs_Arc:GeomAbs_Intersection,true);maker.SetApprox(false);maker.Perform(-left*(alignment>0?1.:-1.));if(!maker.IsDone())throw std::runtime_error("Open exact thin offset failed without approximation");const auto wires=shapes(maker.Shape(),TopAbs_WIRE);if(wires.size()!=1||BRep_Tool::IsClosed(wires.front()))throw std::runtime_error("Open thin offset split or closed the source; no fragment is discarded");auto wire=TopoDS::Wire(wires.front());TopoDS_Vertex a,b;TopExp::Vertices(wire,a,b);if(a.IsNull()||b.IsNull())throw std::runtime_error("Open thin offset lost its endpoints");const auto expectedStart=BRep_Tool::Pnt(sourceStart).Translated(startLeft*left),expectedEnd=BRep_Tool::Pnt(sourceEnd).Translated(endLeft*left);auto matches=[](const TopoDS_Vertex& v,const gp_Pnt& expected,const TopoDS_Vertex& original){return BRep_Tool::Pnt(v).Distance(expected)<=BRep_Tool::Tolerance(v)+BRep_Tool::Tolerance(original);};if(matches(a,expectedEnd,sourceEnd)&&matches(b,expectedStart,sourceStart)){wire.Reverse();std::swap(a,b);}if(!matches(a,expectedStart,sourceStart)||!matches(b,expectedEnd,sourceEnd))throw std::runtime_error("Open offset endpoint direction differs from the explicit left/right contract");return wire;};
    const double a=side=="left"?thickness:side=="symmetric"?thickness*.5:0,b=side=="right"?-thickness:side=="symmetric"?-thickness*.5:0;auto left=offset(a),right=offset(b);TopoDS_Vertex a0,a1,b0,b1;TopExp::Vertices(left,a0,a1);TopExp::Vertices(right,b0,b1);
    BRepBuilderAPI_MakeWire boundary;std::vector<std::string> names;auto append=[&](const TopoDS_Wire& wire,const char* label){size_t index=0;for(BRepTools_WireExplorer walk(wire);walk.More();walk.Next()){boundary.Add(walk.Current());if(!boundary.IsDone())throw std::runtime_error("Thin offset boundary cannot join exactly");names.push_back(std::string(label)+std::to_string(index++));}};append(left,"thin.left.");boundary.Add(BRepBuilderAPI_MakeEdge(a1,b1).Edge());names.push_back("thin.end");right.Reverse();append(right,"thin.right.");boundary.Add(BRepBuilderAPI_MakeEdge(b0,a0).Edge());names.push_back("thin.start");if(!boundary.IsDone())throw std::runtime_error("Thin offset caps did not close the exact boundary");BRepBuilderAPI_MakeFace maker(boundary.Wire(),true);if(!maker.IsDone())throw std::runtime_error("Open thin offset did not form one planar wall");ThinProfile073 part;part.face=maker.Face();if(thinNormal073(part.face).Dot(normal)<0)part.face.Reverse();checkThinFace073(part.face);size_t index=0;for(BRepTools_WireExplorer walk(boundary.Wire());walk.More();walk.Next())part.edges.push_back({index<names.size()?names[index]:"thin.boundary."+std::to_string(index),walk.Current()}),++index;
