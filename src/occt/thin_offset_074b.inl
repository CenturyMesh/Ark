// Explicit OCCT offset construction. The analytic073 path remains the default.
// Input and output curves stay exact; SetApprox(false) forbids arc/line fitting.
struct ThinOffset074 {std::vector<ThinProfile073> parts;V report=V::makeObj();};
TopoDS_Face boundedThinFace074(TopoDS_Wire wire,const gp_Vec& normal){
    TopoDS_Vertex first,last;TopExp::Vertices(wire,first,last);if(first.IsNull())throw std::runtime_error("Thin boundary has no exact vertex");const gp_Pln plane(BRep_Tool::Pnt(first),gp_Dir(normal));
    auto make=[&](){BRepBuilderAPI_MakeFace maker(plane,wire,true);if(!maker.IsDone())throw std::runtime_error("Thin boundary is not an exact planar loop");return maker.Face();};auto face=make();BRepTopAdaptor_FClass2d where(face,Precision::Confusion());if(where.PerformInfinitePoint()==TopAbs_IN){wire.Reverse();face=make();}BRepTopAdaptor_FClass2d bounded(face,Precision::Confusion());if(bounded.PerformInfinitePoint()!=TopAbs_OUT)throw std::runtime_error("Thin boundary has no unambiguous bounded interior");checkThinFace073(face);return face;
}
ThinOffset074 thinOpenOffset074(const TopoDS_Wire& source,const gp_Vec& normal,const V& request){
    const double thickness=positive(request,"thickness");if(thickness<=1e-6)throw std::runtime_error("Thin thickness must exceed 1e-6 mm");const auto side=word(request,"thin_side"),join=request.find("thin_join")?word(request,"thin_join"):"arc";
    if(side!="left"&&side!="right"&&side!="symmetric")throw std::runtime_error("Open offset thin side must be left, right or symmetric");if(join!="arc"&&join!="intersection")throw std::runtime_error("Thin join must be arc or intersection");
