// Native thin profiles: exact straight offset chains and one circular arc/circle.
// No spline approximation, topology healing, or discarded offset fragments.
struct ThinProfile073 {TopoDS_Face face;std::vector<std::pair<std::string,TopoDS_Edge>> edges;V report=V::makeObj();};
void checkThinFace073(const TopoDS_Face& face){if(face.IsNull()||!BRepCheck_Analyzer(face).IsValid()||std::abs(properties(face,'a'))<=1e-9)throw std::runtime_error("Thin profile has invalid or zero-area boundaries");BRepAlgoAPI_Check checked(face,false,true);if(!checked.IsValid())throw std::runtime_error("Thin profile self-intersects; reduce thickness or repair the source");}
gp_Vec thinNormal073(const TopoDS_Face& face){gp_Vec result(BRepAdaptor_Surface(face).Plane().Axis().Direction());if(face.Orientation()==TopAbs_REVERSED)result.Reverse();return result;}
ThinProfile073 thinProfile073(const TopoDS_Wire& source,const gp_Vec& sourceNormal,double thickness,const std::string& side,const std::vector<std::pair<std::string,TopoDS_Edge>>& sourceNames){
    if(!std::isfinite(thickness)||thickness<=1e-6||thickness>1e8)throw std::runtime_error("Thin thickness must be finite and greater than 1e-6 mm");
    gp_Vec normal=sourceNormal;normal.Normalize();std::vector<TopoDS_Edge> ordered;std::vector<gp_Pnt> points;
    for(BRepTools_WireExplorer walk(source);walk.More();walk.Next()){ordered.push_back(walk.Current());TopoDS_Vertex a,b;TopExp::Vertices(walk.Current(),a,b,true);if(a.IsNull()||b.IsNull())throw std::runtime_error("Thin profile edge has no endpoints");if(points.empty())points.push_back(BRep_Tool::Pnt(a));else if(points.back().Distance(BRep_Tool::Pnt(a))>1e-7)throw std::runtime_error("Thin profile edges are not one ordered connected chain");points.push_back(BRep_Tool::Pnt(b));}
    if(ordered.empty()||ordered.size()!=shapes(source,TopAbs_EDGE).size())throw std::runtime_error("Thin profile must be one connected unbranched wire");
    const bool closed=BRep_Tool::IsClosed(source);
    if(closed?(side!="inside"&&side!="outside"&&side!="symmetric"):(side!="left"&&side!="right"&&side!="symmetric"))throw std::runtime_error(closed?"Closed thin profile side must be inside, outside or symmetric":"Open thin profile side must be left, right or symmetric");
    auto name=[&](size_t index){for(const auto& item:sourceNames)if(item.second.IsSame(ordered[index]))return item.first;return std::string("profile.")+std::to_string(index);};
    ThinProfile073 out;
    auto wire=[&](const std::vector<TopoDS_Edge>& edges,const std::vector<std::string>& names){BRepBuilderAPI_MakeWire builder;for(size_t i=0;i<edges.size();++i){builder.Add(edges[i]);if(!builder.IsDone())throw std::runtime_error("Thin boundary failed to join exactly");out.edges.push_back({names[i],builder.Edge()});}return builder.Wire();};
    auto faceOf=[&](const TopoDS_Wire& boundary){BRepBuilderAPI_MakeFace builder(boundary,true);if(!builder.IsDone())throw std::runtime_error("Thin boundary is not planar");TopoDS_Face result=builder.Face();if(thinNormal073(result).Dot(normal)<0)result.Reverse();checkThinFace073(result);return result;};
    auto ring=[&](const TopoDS_Wire& outer,const TopoDS_Wire& inner){TopoDS_Face outside=faceOf(outer),inside=faceOf(inner);BRepAlgoAPI_Cut uncovered(inside,outside);if(!uncovered.IsDone()||uncovered.HasErrors()||!shapes(uncovered.Shape(),TopAbs_FACE).empty())throw std::runtime_error("Thin offset boundaries intersect or reverse nesting");auto hole=BRepTools::OuterWire(inside);if(thinNormal073(inside).Dot(thinNormal073(outside))>0)hole.Reverse();BRepBuilderAPI_MakeFace builder(outside);builder.Add(hole);if(!builder.IsDone())throw std::runtime_error("Thin annular profile failed");out.face=builder.Face();checkThinFace073(out.face);const double expected=std::abs(properties(outside,'a'))-std::abs(properties(inside,'a'));if(expected<=0||std::abs(std::abs(properties(out.face,'a'))-expected)>std::max(1e-9,expected*1e-9))throw std::runtime_error("Thin profile area does not retain both offset boundaries");};
    BRepAdaptor_Curve first(ordered.front());
    if(ordered.size()==1&&first.GetType()==GeomAbs_Circle){
        const gp_Circ circle=first.Circle();const double radius=circle.Radius();
        if(closed){const double outer=radius+(side=="outside"?thickness:side=="symmetric"?thickness*.5:0),inner=radius-(side=="inside"?thickness:side=="symmetric"?thickness*.5:0);if(inner<=1e-6)throw std::runtime_error("Thin circle thickness collapses its inner boundary");auto make=[&](double r,const std::string& prefix){const TopoDS_Edge edge=BRepBuilderAPI_MakeEdge(gp_Circ(circle.Position(),r)).Edge();return wire({edge},{prefix+name(0)});};ring(make(outer,"thin.outer."),make(inner,"thin.inner."));}
        else{
            double u0=first.FirstParameter(),u1=first.LastParameter();if(ordered[0].Orientation()==TopAbs_REVERSED)std::swap(u0,u1);const double sense=(u1>u0?1.:-1.)*(gp_Vec(circle.Axis().Direction()).Dot(normal)>0?1.:-1.);
            const double a=side=="left"?thickness:side=="symmetric"?thickness*.5:0,b=side=="right"?-thickness:side=="symmetric"?-thickness*.5:0;
            auto offset=[&](double amount){const double r=radius-sense*amount;if(r<=1e-6)throw std::runtime_error("Thin arc thickness collapses its radius");BRepBuilderAPI_MakeEdge builder(gp_Circ(circle.Position(),r),std::min(u0,u1),std::max(u0,u1));if(!builder.IsDone())throw std::runtime_error("Thin analytic arc offset failed");auto edge=builder.Edge();if(u1<u0)edge.Reverse();return edge;};
            auto ea=offset(a),eb=offset(b);TopoDS_Vertex a0,a1,b0,b1;TopExp::Vertices(ea,a0,a1,true);TopExp::Vertices(eb,b0,b1,true);auto end=BRepBuilderAPI_MakeEdge(BRep_Tool::Pnt(a1),BRep_Tool::Pnt(b1)).Edge(),start=BRepBuilderAPI_MakeEdge(BRep_Tool::Pnt(b0),BRep_Tool::Pnt(a0)).Edge();eb.Reverse();out.face=faceOf(wire({ea,end,eb,start},{"thin.left."+name(0),"thin.end","thin.right."+name(0),"thin.start"}));
        }
        out.report.set("profile_domain",V::makeStr(closed?"circle":"single_circular_arc"));
    }else{
        for(const auto& edge:ordered)if(BRepAdaptor_Curve(edge).GetType()!=GeomAbs_Line)throw std::runtime_error("Thin extrusion supports exact line chains, one circle or one circular arc; mixed arcs/splines need separate supported profiles");
        if(closed){if(points.front().Distance(points.back())>1e-7)throw std::runtime_error("Closed thin profile has an open seam");points.pop_back();if(points.size()<3)throw std::runtime_error("Thin closed polygon needs three edges");}
        const size_t count=points.size(),segments=closed?count:count-1;std::vector<gp_Vec> tangents,left;
        for(size_t i=0;i<segments;++i){gp_Vec direction(points[i],points[(i+1)%count]);if(direction.Magnitude()<=1e-7)throw std::runtime_error("Thin profile contains a degenerate segment");direction.Normalize();if(std::abs(direction.Dot(normal))>1e-10)throw std::runtime_error("Thin path is not in its declared sketch plane");tangents.push_back(direction);left.push_back(normal.Crossed(direction));}
        auto offset=[&](double amount){std::vector<gp_Pnt> result;result.reserve(count);for(size_t i=0;i<count;++i){if(!closed&&(i==0||i+1==count)){result.push_back(points[i].Translated(left[i?segments-1:0]*amount));continue;}const size_t before=(i+segments-1)%segments,after=i%segments;const auto p=points[i].Translated(left[before]*amount),q=points[i].Translated(left[after]*amount);const double denominator=normal.Dot(tangents[before].Crossed(tangents[after]));if(std::abs(denominator)<1e-12){if(tangents[before].Dot(tangents[after])<0)throw std::runtime_error("Thin path reverses or backtracks");result.push_back(p);}else result.push_back(p.Translated(tangents[before]*(normal.Dot(gp_Vec(p,q).Crossed(tangents[after]))/denominator)));}for(size_t i=0;i<segments;++i)if(gp_Vec(result[i],result[(i+1)%count]).Dot(tangents[i])<=1e-7)throw std::runtime_error("Thin thickness collapses or reverses a profile edge");return result;};
        auto polygon=[&](const std::vector<gp_Pnt>& vertices,const std::string& prefix){std::vector<TopoDS_Edge> edges;std::vector<std::string> names;for(size_t i=0;i<vertices.size();++i){edges.push_back(BRepBuilderAPI_MakeEdge(vertices[i],vertices[(i+1)%vertices.size()]).Edge());names.push_back(prefix+name(i));}return wire(edges,names);};
        if(closed){double signedArea=0;for(size_t i=1;i+1<count;++i)signedArea+=normal.Dot(gp_Vec(points[0],points[i]).Crossed(gp_Vec(points[0],points[i+1])))*.5;if(std::abs(signedArea)<=1e-9)throw std::runtime_error("Thin profile has zero oriented area");const double winding=signedArea>0?1.:-1.;const double a=side=="outside"?-winding*thickness:side=="symmetric"?-winding*thickness*.5:0,b=side=="inside"?winding*thickness:side=="symmetric"?winding*thickness*.5:0;ring(polygon(offset(a),"thin.outer."),polygon(offset(b),"thin.inner."));}
        else{const double a=side=="left"?thickness:side=="symmetric"?thickness*.5:0,b=side=="right"?-thickness:side=="symmetric"?-thickness*.5:0;const auto ap=offset(a),bp=offset(b);std::vector<TopoDS_Edge> edges;std::vector<std::string> names;for(size_t i=0;i<segments;++i){edges.push_back(BRepBuilderAPI_MakeEdge(ap[i],ap[i+1]).Edge());names.push_back("thin.left."+name(i));}edges.push_back(BRepBuilderAPI_MakeEdge(ap.back(),bp.back()).Edge());names.push_back("thin.end");for(size_t i=segments;i>0;--i){edges.push_back(BRepBuilderAPI_MakeEdge(bp[i],bp[i-1]).Edge());names.push_back("thin.right."+name(i-1));}edges.push_back(BRepBuilderAPI_MakeEdge(bp.front(),ap.front()).Edge());names.push_back("thin.start");out.face=faceOf(wire(edges,names));}
        out.report.set("profile_domain",V::makeStr(closed?"closed_line_polygon":"open_line_chain"));out.report.set("corner_join",V::makeStr("exact_miter"));
    }
    out.report.set("side",V::makeStr(side));out.report.set("thickness_mm",V::makeNum(thickness));out.report.set("profile_closed",V::makeBool(closed));out.report.set("wall_area_mm2",V::makeNum(std::abs(properties(out.face,'a'))));out.report.set("self_interference_checked",V::makeBool(true));out.report.set("curve_approximation",V::makeBool(false));return out;
}
