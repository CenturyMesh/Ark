static void fit(){RECT r{};GetClientRect(state.window,&r);double minX=1e30,maxX=-1e30,minY=1e30,maxY=-1e30;for(const auto& n:state.nodes)if(n.visible){minX=std::min(minX,n.x);maxX=std::max(maxX,n.x+184);minY=std::min(minY,n.y);maxY=std::max(maxY,n.y+72);}if(minX>maxX)return;state.zoom=std::clamp(std::min((canvasRight()-64.)/std::max(200.,maxX-minX),(r.bottom-215.)/std::max(180.,maxY-minY)),.18,1.35);state.panX=32-minX*state.zoom+(canvasRight()-64-(maxX-minX)*state.zoom)*.5;state.panY=150-minY*state.zoom+(r.bottom-215-(maxY-minY)*state.zoom)*.5;}
static void refresh(bool reset=false){
