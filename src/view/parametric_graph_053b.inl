    if(m==WM_SIZE){RECT r{};GetClientRect(w,&r);MoveWindow(state.search,r.right-245,33,222,28,TRUE);InvalidateRect(w,nullptr,FALSE);return 0;}
    if(m==WM_GETMINMAXINFO){auto* p=(MINMAXINFO*)lp;p->ptMinTrackSize={1060,620};return 0;}
    if(m==WM_CTLCOLOREDIT){SetTextColor((HDC)wp,RGB(220,231,243));SetBkColor((HDC)wp,RGB(25,37,53));return (LRESULT)state.background;}
    if(m==WM_COMMAND&&LOWORD(wp)==1&&HIWORD(wp)==EN_CHANGE){wchar_t value[256]{};int length=GetWindowTextW(state.search,value,256);int bytes=WideCharToMultiByte(CP_UTF8,0,value,length,nullptr,0,nullptr,nullptr);state.query.resize((size_t)bytes);if(bytes)WideCharToMultiByte(CP_UTF8,0,value,length,state.query.data(),bytes,nullptr,nullptr);visibility();fit();InvalidateRect(w,nullptr,FALSE);return 0;}
    if(m==WM_TIMER){if(state.revision!=g_session.revision||state.epoch!=g_documentEpoch)refresh();return 0;}
    if(m==WM_ERASEBKGND)return 1;
    if(m==WM_PAINT||m==WM_PRINTCLIENT){PAINTSTRUCT ps{};HDC target=m==WM_PAINT?BeginPaint(w,&ps):(HDC)wp;RECT r{};GetClientRect(w,&r);HDC dc=CreateCompatibleDC(target);auto bitmap=CreateCompatibleBitmap(target,std::max(1L,r.right),std::max(1L,r.bottom));auto old=SelectObject(dc,bitmap);paint(dc,r);BitBlt(target,0,0,r.right,r.bottom,dc,0,0,SRCCOPY);SelectObject(dc,old);DeleteObject(bitmap);DeleteDC(dc);if(m==WM_PAINT)EndPaint(w,&ps);return 0;}
    if(m==WM_LBUTTONDOWN){int x=GET_X_LPARAM(lp),y=GET_Y_LPARAM(lp);for(int i=0;i<7;++i){auto r=buttonRect(i);POINT p{x,y};if(PtInRect(&r,p)){action(i);return 0;}}if(y>=130&&x<canvasRight()){SetFocus(w);state.dragging=true;state.moved=false;state.start=state.last={x,y};state.dragNode=hit(x,y);if(state.dragNode>=0)select((size_t)state.dragNode);SetCapture(w);}return 0;}
    if(m==WM_MOUSEMOVE&&state.dragging){POINT p{GET_X_LPARAM(lp),GET_Y_LPARAM(lp)};int dx=p.x-state.last.x,dy=p.y-state.last.y;state.moved|=std::abs(p.x-state.start.x)+std::abs(p.y-state.start.y)>3;if(state.dragNode>=0){state.nodes[state.dragNode].x+=dx/state.zoom;state.nodes[state.dragNode].y+=dy/state.zoom;}else{state.panX+=dx;state.panY+=dy;}state.last=p;InvalidateRect(w,nullptr,FALSE);return 0;}
    if(m==WM_LBUTTONUP||m==WM_CAPTURECHANGED){state.dragging=false;if(m==WM_LBUTTONUP)ReleaseCapture();return 0;}
    if(m==WM_LBUTTONDBLCLK){int i=hit(GET_X_LPARAM(lp),GET_Y_LPARAM(lp));if(i>=0){auto key=state.nodes[i].key;if(state.collapsed.count(key))state.collapsed.erase(key);else state.collapsed.insert(key);visibility();InvalidateRect(w,nullptr,FALSE);}return 0;}
    if(m==WM_MOUSEWHEEL){POINT p{GET_X_LPARAM(lp),GET_Y_LPARAM(lp)};ScreenToClient(w,&p);double old=state.zoom;state.zoom=std::clamp(old*std::pow(1.15,GET_WHEEL_DELTA_WPARAM(wp)/120.),.15,2.5);state.panX=p.x-(p.x-state.panX)*state.zoom/old;state.panY=p.y-(p.y-state.panY)*state.zoom/old;InvalidateRect(w,nullptr,FALSE);return 0;}
    if(m==WM_KEYDOWN){if(wp==VK_ESCAPE){DestroyWindow(w);return 0;}if(wp=='F'){fit();InvalidateRect(w,nullptr,FALSE);return 0;}}
    if(m==WM_CLOSE){DestroyWindow(w);return 0;}if(m==WM_DESTROY){KillTimer(w,1);DeleteObject(state.font);DeleteObject(state.title);DeleteObject(state.small);DeleteObject(state.background);state.window=nullptr;state.search=nullptr;state.dragging=false;return 0;}
    return DefWindowProcW(w,m,wp,lp);
}
static void open(){if(state.window){ShowWindow(state.window,SW_RESTORE);SetForegroundWindow(state.window);refresh();return;}WNDCLASSW wc{};wc.style=CS_DBLCLKS;wc.lpfnWndProc=procedure;wc.hInstance=GetModuleHandle(nullptr);wc.hCursor=LoadCursor(nullptr,IDC_ARROW);wc.lpszClassName=L"ARKParametricGraph053B";RegisterClassW(&wc);state.collapsed.clear();state.selected.clear();state.query.clear();state.focus=false;HWND w=CreateWindowExW(WS_EX_APPWINDOW,wc.lpszClassName,L"ARK / Neural Parametric View",WS_OVERLAPPEDWINDOW,80,60,1400,850,g_window,nullptr,wc.hInstance,nullptr);if(!w)throw std::runtime_error("Cannot open parametric graph window");refresh(true);ShowWindow(w,SW_SHOW);UpdateWindow(w);}
}
static bool parametricComponentAction053B(int id){using namespace parametric_view_053b;if(id==49000){open();return true;}if(id>=49001&&id<=49005){action(id-48999);return true;}return false;}
