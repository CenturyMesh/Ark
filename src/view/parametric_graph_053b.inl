    try{auto graph=parametricGraphSnapshot(g_doc,g_session.revision);std::map<std::string,size_t> index;std::map<std::string,std::pair<double,double>> prior;for(const auto& n:state.nodes)prior[n.key]={n.x,n.y};state.nodes.clear();state.edges.clear();std::array<int,6> counts{};
        for(const auto& item:field(graph,"nodes").obj){const auto& row=item.second;Node n;n.key=item.first;n.kind=field(row,"kind").asStr();n.name=field(row,"name").asStr();n.facts=field(row,"facts");if(n.name.empty())n.name=n.key;
            const int col=n.kind=="params"?0:n.kind=="planes"||n.kind=="materials"?1:n.kind=="sketches"?2:n.kind=="feature"?3:n.kind=="component"?5:4;
            n.x=col*224.;n.y=counts[col]++*126.+(col%2)*36.;if(col==5){n.x=2.5*224.;n.y=-145.+(counts[col]-1)*100.;}if(!reset&&prior.count(n.key)){n.x=prior[n.key].first;n.y=prior[n.key].second;}
