    std::map<u64,std::vector<u64>> branches;for(const auto& m:g_doc.mates)if(isMechanicalMate(m.type))branches[m.a].push_back(m.id);std::vector<EditorField> shares;std::vector<u64> ids;for(const auto& [node,edges]:branches)if(edges.size()>1)for(u64 id:edges){shares.push_back({"Power fraction / mate "+std::to_string(id),""});ids.push_back(id);}if(!shares.empty()){if(!editFields("Branch power allocation","Declare load fractions for all outgoing mates at each branch. Each branch must sum to 1; speed ratio alone cannot determine torque sharing.",shares))return;V split=V::makeObj();for(size_t i=0;i<ids.size();++i)split.set(std::to_string(ids[i]),V::makeNum(formNumber(shares[i].value)));a.set("power_splits",split);}if(revision!=g_session.revision)throw std::runtime_error("Drawing changed; inspect again.");start("transmission_inspect",a);
