static bool transmissionAction061(int action){if(action<49700||action>49706)return false;using namespace transmission_view061;try{switch(action){case 49700:show();break;case 49701:start("transmission_inspect",arguments("inspect"));break;case 49702:edit();break;case 49703:analyze();break;case 49704:optimize();break;case 49705:prepare();break;case 49706:*g_transmission061.cancel=true;g_transmission061.message="Cancellation requested.";refresh();break;}}catch(const std::exception& e){g_transmission061.message=e.what();g_status=e.what();g_error=true;refresh();}return true;}
static void advanceTransmission061(){using namespace transmission_view061;auto& s=g_transmission061;if(s.worker.valid()&&s.worker.wait_for(std::chrono::milliseconds(0))==std::future_status::ready){try{auto result=s.worker.get();if(s.cancel->load())throw std::runtime_error("Calculation cancelled; CAD unchanged.");if(get(result,"isError").b)throw std::runtime_error(text(get(result,"structuredContent"),"error"));s.result=get(result,"structuredContent");s.stale=s.revision!=g_session.revision||s.epoch!=g_objectDocumentEpoch;s.candidates=V::makeArr();s.candidatesShown=s.result.find("candidates")!=nullptr;if(s.candidatesShown){s.candidates=get(s.result,"candidates");for(const auto& option:get(s.result,"best_by_form_and_topology").arr)if(std::none_of(s.candidates.arr.begin(),s.candidates.arr.end(),[&](const V& c){return text(c,"candidate_id")==text(option,"candidate_id");}))s.candidates.arr.push_back(option);}s.selected=0;s.message=s.stale?"Calculation completed on an older revision; recalculate before edits.":s.candidatesShown?(s.candidates.arr.empty()?"No candidate satisfied the declared bounds. Inspect the constraints; CAD is unchanged.":"Candidates ranked within the declared search. Select one and bind it to existing mates."):"Current mechanical mate study / source and assumptions retained.";}catch(const std::exception& e){s.message=e.what();}refresh();}else if(!s.result.isNull()&&!s.stale&&(s.revision!=g_session.revision||s.epoch!=g_objectDocumentEpoch)){s.stale=true;refresh();}}
