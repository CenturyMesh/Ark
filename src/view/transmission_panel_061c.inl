static void start(const char* tool,V args){auto& s=g_transmission061;if(s.worker.valid())throw std::runtime_error("A transmission calculation is already running.");s.cancel=std::make_shared<std::atomic_bool>(false);auto cancel=s.cancel;s.revision=g_session.revision;s.epoch=g_objectDocumentEpoch;s.stale=false;args.set("expected_revision",V::makeNum(s.revision));Document snapshot=g_doc;const auto revision=s.revision;std::string name=tool;s.message="Calculating on a private assembly snapshot...";s.worker=std::async(std::launch::async,[snapshot=std::move(snapshot),revision,args,name,cancel]() mutable{NativeRequestControlScope control([cancel]{return cancel->load();},120000);AgentSession session;session.document=std::move(snapshot);session.revision=revision;return session.call(name,args);});refresh();}
