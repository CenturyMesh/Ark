struct Context {
    u64 revision=g_session.revision,epoch=g_documentEpoch,source=0;std::optional<Body> heldSource;
    void current()const{if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("The drawing changed during review. Reopen the current source and prepare again.");if(source){const auto* now=sourceBody(source);if(!now||!heldSource||now->nativeData.ownerIdentity()!=heldSource->nativeData.ownerIdentity())throw std::runtime_error("The exact source changed during review. Inspect it again.");}}
