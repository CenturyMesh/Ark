static V currentInventory(const Context& context){context.current();const auto& data=context.heldSource->nativeData.metadata();const auto& report=at(data,"report");const auto& bodies=at(report,"bodies");if(bodies.t==V::Arr&&!bodies.arr.empty())return bodies;const auto& solids=at(at(data,"topology"),"solids");return solids.t==V::Arr?solids:V::makeArr();}
