};
static V expressionPoint(const std::vector<EditorField>& fields,size_t first){V point=V::makeArr();for(size_t i=0;i<3;++i){const auto value=trimField(fields[first+i].value);if(value.empty())throw std::runtime_error("Enter all three source-local point coordinates");(void)formNumber(value);point.arr.push_back(V::makeStr(value));}return point;}
