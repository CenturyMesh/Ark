    struct TemporaryImage {std::filesystem::path file;~TemporaryImage(){std::error_code error;std::filesystem::remove(file,error);}} cleanup{file};invoke("snapshot",capture,context);HBITMAP bitmap=candidateReviewBitmap(path);if(!bitmap)throw std::runtime_error("Could not display the checked candidate");struct BitmapOwner {HBITMAP value;~BitmapOwner(){DeleteObject(value);}} bitmapOwner{bitmap};
