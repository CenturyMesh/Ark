static void referenceJumpDialog(){
    using V=arkjson::Value;if(g_picked.empty())throw std::runtime_error("Select a named face or edge first");const auto source=g_picked.back();if(source.kind!="face"&&source.kind!="edge")throw std::runtime_error("Select a named face or edge first");const u64 revision=g_session.revision,epoch=g_documentEpoch;
    V args=V::makeObj();args.set("id",V::makeNum((double)source.feature));args.set("reference",V::makeStr(source.name));args.set("kind",V::makeStr("all"));auto result=runTool("reference_navigate",args);if(g_error)throw std::runtime_error(g_status);const auto& neighbors=*result.find("structuredContent")->find("neighbors");std::vector<std::string> labels;std::vector<V> targets;for(const auto& row:neighbors.arr){auto kind=row.find("kind")->asStr();if(kind=="face"||kind=="edge"){labels.push_back(kind+" / "+row.find("reference")->asStr());targets.push_back(row);}}if(labels.empty())throw std::runtime_error("No adjacent named face or edge; inspect the source topology");
    std::vector<EditorField> fields{{"Adjacent reference",labels.front(),false,labels}};if(!editFields("Jump to adjacent reference",("From "+source.kind+" / "+source.name).c_str(),fields))return;if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Selection changed after inspection; select again");auto at=std::find(labels.begin(),labels.end(),fields[0].value);if(at==labels.end())throw std::runtime_error("Choose a listed adjacent reference");V select=V::makeObj();select.set("id",V::makeNum((double)source.feature));select.set("reference",*targets[(size_t)std::distance(labels.begin(),at)].find("reference"));select.set("expected_revision",V::makeNum((double)revision));if(source.instance){select.set("instance",V::makeNum((double)source.instance));select.set("copy",V::makeNum(source.copy));}runTool("selection_set",select);
}
