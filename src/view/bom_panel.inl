// Native BOM table. A captured revision is required for every edit/export.
struct BomPanel {HWND window=nullptr,list=nullptr,header=nullptr;HFONT font=nullptr;arkjson::Value bom;u64 revision=0,epoch=0;bool done=false;};
static int g_bomSmokeAction=0;static std::string g_bomExportTestPath;
static std::wstring bomWide(const std::string& s){int n=MultiByteToWideChar(CP_UTF8,0,s.c_str(),-1,nullptr,0);std::wstring w((size_t)std::max(n,1),0);if(n)MultiByteToWideChar(CP_UTF8,0,s.c_str(),-1,w.data(),n);return w;}
static std::string bomText(const arkjson::Value& v,const char* key){auto* p=v.find(key);return p?p->asStr():"";}
static void bomTableRefresh(BomPanel& state){
    using V=arkjson::Value;state.bom=inspectBom(g_doc,g_session.revision);state.revision=g_session.revision;state.epoch=g_documentEpoch;ListView_DeleteAllItems(state.list);const auto& items=state.bom.find("items")->arr;size_t missing=0;
    auto cell=[&](int row,int column,const std::string& text){auto w=bomWide(text);LVITEMW item{};item.iItem=row;item.iSubItem=column;item.pszText=w.data();SendMessageW(state.list,LVM_SETITEMTEXTW,row,(LPARAM)&item);};
    for(size_t i=0;i<items.size();++i){const auto& row=items[i];const auto& meta=*row.find("metadata");auto name=bomWide(bomText(meta,"part_number"));LVITEMW entry{};entry.mask=LVIF_TEXT;entry.iItem=(int)i;entry.pszText=name.data();SendMessageW(state.list,LVM_INSERTITEMW,0,(LPARAM)&entry);
        cell((int)i,1,bomText(meta,"description").empty()?bomText(row,"name"):bomText(meta,"description"));cell((int)i,2,std::to_string((int)row.find("quantity")->num));cell((int)i,3,bomText(row,"material"));cell((int)i,4,bomText(meta,"procurement"));cell((int)i,6,bomText(meta,"manufacturer_part_number"));cell((int)i,7,bomText(meta,"supplier_part_number"));cell((int)i,8,bomText(meta,"source_url"));std::string gaps;for(const auto& gap:row.find("missing_or_review_required")->arr){if(!gaps.empty())gaps+=", ";gaps+=gap.str;}cell((int)i,5,gaps.empty()?"Complete metadata":gaps);if(!gaps.empty())++missing;
    }
    std::string message="BOM / revision "+std::to_string(state.revision)+" / "+std::to_string(items.size())+" definitions / "+std::to_string(state.bom.find("occurrences")->arr.size())+" occurrences / "+std::to_string(missing)+" incomplete / fasteners: "+std::to_string((int)state.bom.find("fastener_quantity")->num)+" (connections require review)";
    if(!state.bom.find("issues")->arr.empty()||!state.bom.find("unplaced_annotated_definitions")->arr.empty())message+=" / document issues: see Review";
    SetWindowTextW(state.header,bomWide(message).c_str());if(!items.empty())ListView_SetItemState(state.list,0,LVIS_SELECTED|LVIS_FOCUSED,LVIS_SELECTED|LVIS_FOCUSED);
}
static void bomEditSelected(BomPanel& state,bool sourcing){
    using V=arkjson::Value;int selection=ListView_GetNextItem(state.list,-1,LVNI_SELECTED);const auto& rows=state.bom.find("items")->arr;if(selection<0||(size_t)selection>=rows.size())throw std::runtime_error("Select a BOM row first");if(state.revision!=g_session.revision||state.epoch!=g_documentEpoch)throw std::runtime_error("BOM snapshot changed; Refresh before editing");
    auto row=rows[(size_t)selection];auto meta=*row.find("metadata");auto get=[&](const char* key){return bomText(meta,key);};std::vector<EditorField> fields;
    if(sourcing)fields={{"Manufacturer",get("manufacturer")},{"Manufacturer reference",get("manufacturer_part_number")},{"Supplier",get("supplier")},{"Supplier reference",get("supplier_part_number")},{"Source URL / HTTPS",get("source_url")},{"Datasheet URL / HTTPS",get("datasheet_url")},{"Sourcing status",get("sourcing_status").empty()?"unresolved":get("sourcing_status"),false,{"unresolved","candidate","selected"}}};
    else fields={{"Internal part number",get("part_number")},{"Description",get("description")},{"Category",get("category")},{"Make / buy",get("procurement").empty()?"unspecified":get("procurement"),false,{"unspecified","make","buy"}},{"Representation",get("representation").empty()?"unspecified":get("representation"),false,{"unspecified","exact","exact_imported","simplified","envelope"}},{"Existing material name",bomText(row,"material")},{"Manufacturing route",bomText(row,"manufacturing_route")}};
    EnableWindow(state.window,FALSE);bool accepted=false;try{accepted=editFields(sourcing?"BOM / sourcing":"BOM / part metadata",sourcing?"Keep references and links backed by supplier evidence. Unknown sourcing remains unresolved.":"Edits apply to this definition and every occurrence. Material must exist in the document; blank remains unknown.",fields);}catch(...){EnableWindow(state.window,TRUE);throw;}EnableWindow(state.window,TRUE);if(!accepted)return;if(state.epoch!=g_documentEpoch)throw std::runtime_error("Project changed during BOM edit");
    const char* basic[]={"part_number","description","category","procurement","representation"};const char* commercial[]={"manufacturer","manufacturer_part_number","supplier","supplier_part_number","source_url","datasheet_url","sourcing_status"};for(size_t i=0;i<(sourcing?7u:5u);++i)meta.set(sourcing?commercial[i]:basic[i],V::makeStr(trimField(fields[i].value)));
    V command=V::makeObj(),commands=V::makeArr(),args=V::makeObj();command.set("op",V::makeStr("feature.edit"));command.set("id",*row.find("feature"));command.set("part",meta);if(!sourcing){if(trimField(fields[5].value)!=bomText(row,"material"))command.set("material",V::makeStr(trimField(fields[5].value)));V manufacturing=V::makeObj();manufacturing.set("route",V::makeStr(trimField(fields[6].value).empty()?"unspecified":trimField(fields[6].value)));if(trimField(fields[6].value)!=bomText(row,"manufacturing_route"))command.set("manufacturing",manufacturing);}commands.arr.push_back(command);args.set("commands",commands);args.set("expected_revision",V::makeNum((double)state.revision));runTool("doc_apply",args);if(g_error)throw std::runtime_error(g_status);bomTableRefresh(state);
}
static void bomExportSnapshot(BomPanel& state){
    using V=arkjson::Value;if(state.revision!=g_session.revision||state.epoch!=g_documentEpoch)throw std::runtime_error("BOM snapshot changed; Refresh before exporting");std::string path=g_bomExportTestPath;
    if(path.empty()){wchar_t file[32768]=L"BOM.json";OPENFILENAMEW choose{};choose.lStructSize=sizeof choose;choose.hwndOwner=state.window;choose.lpstrFilter=L"BOM JSON\0*.json\0\0";choose.lpstrFile=file;choose.nMaxFile=32768;choose.lpstrDefExt=L"json";choose.Flags=OFN_PATHMUSTEXIST|OFN_NOCHANGEDIR;if(!GetSaveFileNameW(&choose))return;auto encoded=std::filesystem::path(file).u8string();path=std::string(encoded.begin(),encoded.end());}
    V args=V::makeObj();args.set("path",V::makeStr(path));args.set("expected_revision",V::makeNum((double)state.revision));runTool("bom_export",args);if(g_error)throw std::runtime_error(g_status);SetWindowTextW(state.header,L"BOM exported as local JSON. Existing exports are never overwritten.");
}
static void bomCapture(HWND h,const std::string& path){RECT r{};GetWindowRect(h,&r);int width=r.right-r.left,height=r.bottom-r.top;HDC screen=GetDC(h),dc=CreateCompatibleDC(screen);BITMAPINFO info{};info.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);info.bmiHeader.biWidth=width;info.bmiHeader.biHeight=-height;info.bmiHeader.biPlanes=1;info.bmiHeader.biBitCount=32;info.bmiHeader.biCompression=BI_RGB;void* bits=nullptr;auto bitmap=CreateDIBSection(screen,&info,DIB_RGB_COLORS,&bits,nullptr,0);auto old=SelectObject(dc,bitmap);if(PrintWindow(h,dc,0)){Image image;image.w=width;image.h=height;image.px.resize((size_t)width*height*3);for(size_t i=0;i<(size_t)width*height;++i){auto* pixel=(unsigned char*)bits+i*4;image.px[i*3]=pixel[2];image.px[i*3+1]=pixel[1];image.px[i*3+2]=pixel[0];}writePNG(path.c_str(),image);}SelectObject(dc,old);DeleteObject(bitmap);DeleteDC(dc);ReleaseDC(h,screen);}
static LRESULT CALLBACK bomPanelProc(HWND window,UINT message,WPARAM w,LPARAM l){
    auto* state=(BomPanel*)GetWindowLongPtr(window,GWLP_USERDATA);if(message==WM_NCCREATE){state=(BomPanel*)((CREATESTRUCT*)l)->lpCreateParams;SetWindowLongPtr(window,GWLP_USERDATA,(LONG_PTR)state);state->window=window;}if(!state)return DefWindowProc(window,message,w,l);
    if(message==WM_CLOSE){state->done=true;return 0;}
    if(message==WM_SIZE&&state->list){int width=LOWORD(l),height=HIWORD(l);MoveWindow(state->header,16,12,width-32,44,TRUE);MoveWindow(state->list,16,62,width-32,std::max(100,height-124),TRUE);for(int i=0;i<6;++i)MoveWindow(GetDlgItem(window,501+i),16+i*150,height-48,140,32,TRUE);return 0;}
    if(message==WM_TIMER){if(g_dialogSmoke){KillTimer(window,902);if(g_bomSmokeAction)SendMessage(window,WM_COMMAND,g_bomSmokeAction,0);if(!g_dialogShot.empty()){bomCapture(window,g_dialogShot);g_dialogShot.clear();}state->done=true;}else if(state->revision!=g_session.revision||state->epoch!=g_documentEpoch)SetWindowTextW(state->header,L"BOM snapshot is stale. Refresh before editing or exporting.");return 0;}
    if(message==WM_COMMAND){try{switch(LOWORD(w)){case 501:bomTableRefresh(*state);break;case 502:bomEditSelected(*state,false);break;case 503:bomEditSelected(*state,true);break;case 504:bomExportSnapshot(*state);break;case 505:{std::vector<EditorField> fields{{"BOM evidence",readableJson(state->bom)}};editFields("BOM / complete snapshot","Missing fields and document issues are explicit. This is a local read-only report.",fields,true,"Close",nullptr,true);break;}case 506:state->done=true;break;}}catch(const std::exception& error){g_error=true;g_status=error.what();SetWindowTextW(state->header,bomWide(g_status).c_str());}return 0;}
    return DefWindowProc(window,message,w,l);
}
static void showBomPanel(){
    if(g_busy)throw std::runtime_error("Wait for the current document operation before opening BOM");INITCOMMONCONTROLSEX controls{sizeof controls,ICC_LISTVIEW_CLASSES};InitCommonControlsEx(&controls);WNDCLASSW wc{};wc.lpfnWndProc=bomPanelProc;wc.hInstance=GetModuleHandle(nullptr);wc.lpszClassName=L"ARK_BOM_PANEL";wc.hbrBackground=(HBRUSH)(COLOR_WINDOW+1);wc.hCursor=LoadCursor(nullptr,IDC_ARROW);RegisterClassW(&wc);BomPanel state;state.font=CreateFontW(-15,0,0,0,FW_NORMAL,0,0,0,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");RECT parent{};GetWindowRect(g_window,&parent);auto window=CreateWindowExW(WS_EX_DLGMODALFRAME,wc.lpszClassName,L"ARK / Bill of materials",WS_OVERLAPPEDWINDOW,parent.left+30,parent.top+45,1160,670,g_window,nullptr,wc.hInstance,&state);
    auto control=[&](const wchar_t* cls,const wchar_t* title,DWORD style,int id){HWND h=CreateWindowExW(0,cls,title,WS_CHILD|WS_VISIBLE|style,0,0,100,30,window,(HMENU)(INT_PTR)id,wc.hInstance,nullptr);SendMessage(h,WM_SETFONT,(WPARAM)state.font,TRUE);return h;};state.header=control(L"STATIC",L"BOM",0,500);state.list=control(WC_LISTVIEWW,L"",WS_TABSTOP|LVS_REPORT|LVS_SINGLESEL|LVS_SHOWSELALWAYS,510);ListView_SetExtendedListViewStyle(state.list,LVS_EX_FULLROWSELECT|LVS_EX_GRIDLINES|LVS_EX_DOUBLEBUFFER);
    const wchar_t* columns[]={L"Part number",L"Description / part",L"Qty",L"Material",L"Make/buy",L"Missing / review required",L"Manufacturer ref",L"Supplier ref",L"Source URL"};const int widths[]={135,235,50,110,90,300,140,140,230};for(int i=0;i<9;++i){LVCOLUMNW column{};column.mask=LVCF_TEXT|LVCF_WIDTH;column.pszText=const_cast<wchar_t*>(columns[i]);column.cx=widths[i];SendMessageW(state.list,LVM_INSERTCOLUMNW,i,(LPARAM)&column);}const wchar_t* labels[]={L"Refresh",L"Edit part",L"Sourcing",L"Export JSON",L"Review",L"Close"};for(int i=0;i<6;++i)control(L"BUTTON",labels[i],WS_TABSTOP|BS_PUSHBUTTON,501+i);
    bomTableRefresh(state);RECT bounds{};GetClientRect(window,&bounds);SendMessage(window,WM_SIZE,0,MAKELPARAM(bounds.right,bounds.bottom));EnableWindow(g_window,FALSE);ShowWindow(window,SW_SHOW);UpdateWindow(window);SetTimer(window,902,g_dialogSmoke?250:500,nullptr);MSG message{};while(!state.done&&GetMessage(&message,nullptr,0,0)>0){if(message.message==WM_KEYDOWN&&message.wParam==VK_ESCAPE){state.done=true;break;}if(!IsDialogMessage(window,&message)){TranslateMessage(&message);DispatchMessage(&message);}if(!g_busy){drainUiTools();pollTeam(false);}}KillTimer(window,902);EnableWindow(g_window,TRUE);DestroyWindow(window);DeleteObject(state.font);SetActiveWindow(g_window);
}
