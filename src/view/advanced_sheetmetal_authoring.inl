// Include after the sheet helpers and applyUiCommandAtRevision declaration.
// Every modal edit captures both revision and document epoch before opening.
static arkjson::Value advancedSheetRow(const Feature& source,const char* key,std::string& entity,bool editing,const char* title){
    using V=arkjson::Value;if(!editing)return V::makeObj();entity=sheetEntityIdDialog(source,key,title);if(entity.empty())return V{};
    for(auto& row:sheetEntityRows(source,key).arr)if(row.find("id")&&row.find("id")->asStr()==entity)return row;throw std::runtime_error("Sheet recipe no longer exists");
}
static std::string advancedSheetField(const arkjson::Value& row,const char* key,const char* fallback){auto value=row.find(key);return value?sheetFieldText(*value):std::string(fallback);}
static void applyAdvancedSheetRecipe(u64 id,u64 revision,u64 epoch,const char* operation,const char* key,const std::string& entity,arkjson::Value recipe){
    using V=arkjson::Value;V command=V::makeObj();command.set("op",V::makeStr(std::string(operation)+(entity.empty()?".add":".edit")));command.set("id",V::makeNum((double)id));
    if(entity.empty())command.set(key,recipe);else {command.set("entity",V::makeStr(entity));command.set("values",recipe);}applyUiCommandAtRevision(command,revision,epoch);
}
static void removeAdvancedSheetDialog(const char* key,const char* operation,const char* title){
    using V=arkjson::Value;const Feature source=*authoredSheet();const u64 revision=g_session.revision,epoch=g_documentEpoch;auto entity=sheetEntityIdDialog(source,key,title);if(entity.empty())return;
    V command=V::makeObj();command.set("op",V::makeStr(std::string(operation)+".remove"));command.set("id",V::makeNum((double)source.id));command.set("entity",V::makeStr(entity));applyUiCommandAtRevision(command,revision,epoch);
}
