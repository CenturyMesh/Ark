struct ReferencePointerHit {bool hit=false;int body=-1,face=-1,edge=-1;SelectionItem item;std::string error;};
static ReferencePointerHit g_hoverReference;
static std::vector<float> g_hoverReferenceFill,g_hoverReferenceLines;
static std::string g_hoverReferenceHint;
static std::vector<double> g_hoverReferenceGeometryKey,g_hoverReferenceQueryKey;
static u64 g_hoverReferenceGeneration=1;
static bool sameReference(const SelectionItem& a,const SelectionItem& b){return a.kind==b.kind&&a.feature==b.feature&&a.instance==b.instance&&a.copy==b.copy&&a.owner==b.owner&&a.name==b.name&&a.meshTriangles==b.meshTriangles&&a.meshVertices==b.meshVertices&&a.topology==b.topology;}
static std::string pointerReferenceLabel(const ReferencePointerHit& hit){if(hit.item.kind=="mesh_face")return hit.item.meshTriangles.size()>1?"Mesh coplanar patch / "+std::to_string(hit.item.meshTriangles.size())+" source triangles":"Mesh triangle "+std::to_string(hit.face)+" / sampled geometry";if(hit.item.kind=="mesh_edge")return "Mesh edge / source vertices "+hit.item.name;return hit.item.name.rfind("@ark.",0)==0?hit.item.kind+" "+std::to_string(1+(hit.face>=0?hit.face:hit.edge)):hit.item.kind+" "+hit.item.name;}
static void clearSelectionHover(){if(g_hoverReference.hit||!g_hoverReferenceFill.empty()||!g_hoverReferenceLines.empty())++g_hoverReferenceGeneration;g_hoverReference={};g_hoverReferenceFill.clear();g_hoverReferenceLines.clear();g_hoverReferenceHint.clear();g_hoverReferenceGeometryKey.clear();g_hoverReferenceQueryKey.clear();}
static void activateSelectionMode(int mode){
    cancelDirectAuthoring();cancelSketchEditing();cancelSketchDrawing();cancelComponentMove();if(measurementActive())endMeasurement();g_componentDragIntent={};g_cameraDrag.active=false;ReleaseCapture();
    if(mode!=g_pickKind||mode==0){g_picked.clear();refreshSelectionLines();}clearDatumSelection();clearSelectionHover();g_pickKind=mode;g_navMode=0;g_dragged=false;
    if(mode==2)g_showEdges=true;if(mode==3){g_showSketches=true;rebuildSketchOverlay();}
    static const char* names[]={"Body","Face","Edge","Curve"};g_status=mode==0?"Body selection / click selects one part / drag moves the part / middle mouse orbits / Esc clears":std::string(names[std::clamp(mode,0,3)])+" selection / click replaces / Ctrl or Shift adds or removes / middle mouse orbits / Esc exits";
}
// Indexed mesh authority is deliberately separate from native topology. Cache
// adjacency once per displayed mesh upload; face patches use the same bounded
// seed-relative coplanarity criterion as directMeshPatch.
struct MeshPointerTopology {std::string fingerprint;std::vector<std::pair<u32,u32>> edges;std::vector<std::vector<u32>> neighbors;std::vector<Vec3> normals,origins;std::map<u32,std::vector<u32>> patches;};
static u64 g_meshPointerSerial=~u64(0);
static std::map<size_t,MeshPointerTopology> g_meshPointerTopologies;
static MeshPointerTopology& meshPointerTopology(size_t part){
    if(g_meshPointerSerial!=g_displayMeshSerial){g_meshPointerTopologies.clear();g_meshPointerSerial=g_displayMeshSerial;}
    auto found=g_meshPointerTopologies.find(part);if(found!=g_meshPointerTopologies.end())return found->second;const auto& mesh=g_cpuMeshes[part];MeshPointerTopology topology;topology.fingerprint=meshTopologyFingerprint(mesh);topology.neighbors.resize(mesh.triCount());topology.normals.reserve(mesh.triCount());topology.origins.reserve(mesh.triCount());std::map<std::pair<u32,u32>,std::vector<u32>> edges;
    for(u32 triangle=0;triangle<mesh.triCount();++triangle){topology.normals.push_back(directTriangleNormal(mesh,triangle));topology.origins.push_back(directMeshPoint(mesh,mesh.idx[(size_t)triangle*3]));for(int k=0;k<3;++k){u32 a=mesh.idx[(size_t)triangle*3+k],b=mesh.idx[(size_t)triangle*3+(k+1)%3];if(b<a)std::swap(a,b);edges[{a,b}].push_back(triangle);}}
    for(const auto& edge:edges){topology.edges.push_back(edge.first);for(u32 a:edge.second)for(u32 b:edge.second)if(a!=b)topology.neighbors[a].push_back(b);}return g_meshPointerTopologies.emplace(part,std::move(topology)).first->second;
}
static std::vector<u32> pointerMeshPatch(size_t part,u32 seed){
    auto& topology=meshPointerTopology(part);auto found=topology.patches.find(seed);if(found!=topology.patches.end())return found->second;if(seed>=topology.normals.size())return {};std::vector<u32> patch{seed};std::set<u32> seen{seed};const auto normal=topology.normals[seed],origin=topology.origins[seed];
    for(size_t cursor=0;cursor<patch.size();++cursor)for(u32 neighbor:topology.neighbors[patch[cursor]])if(!seen.count(neighbor)&&topology.normals[neighbor].dot(normal)>=std::cos(deg2rad(3.))&&std::abs(normal.dot(topology.origins[neighbor]-origin))<=1e-4){seen.insert(neighbor);if(patch.size()==4096){topology.patches[seed]={};return {};}patch.push_back(neighbor);}std::sort(patch.begin(),patch.end());if(topology.patches.size()>=4096)topology.patches.clear();topology.patches[seed]=patch;return patch;
}
static bool meshPointerBody(size_t body){auto* feature=g_doc.find(g_bodyIds[body]);return feature&&!isNativeFeature(feature->type)&&feature->type!=FeatureType::SourceTube&&feature->type!=FeatureType::NotchedTube;}
struct ProjectedReferenceEdge {size_t body,edge;Vec3 a,b;float ax,ay,bx,by;double aw,bw;u32 meshA=~u32(0),meshB=~u32(0);};
static std::vector<ProjectedReferenceEdge> g_projectedReferenceEdges;
static std::vector<double> g_projectedReferenceKey;
static void projectReferenceEdges(bool curvesOnly){
    auto vp=cameraProjection()*cameraView();std::vector<double> key{(double)g_displayMeshSerial,(double)g_documentEpoch,(double)viewX,(double)viewY,(double)viewW,(double)viewH,curvesOnly?1.:0.};key.insert(key.end(),vp.m,vp.m+16);
    for(size_t body=0;body<g_bodyIds.size();++body){key.push_back(displayInstance(body)?1.:0.);key.insert(key.end(),g_instanceWorld[body].m,g_instanceWorld[body].m+16);}
    if(key==g_projectedReferenceKey)return;g_projectedReferenceKey=std::move(key);g_projectedReferenceEdges.clear();
    auto project=[&](Vec3 point,float& x,float& y,double& w){w=vp.m[3]*point.x+vp.m[7]*point.y+vp.m[11]*point.z+vp.m[15];if(w<=1e-6)return false;auto clip=vp.transformPoint(point);if(clip.z < -w)return false;x=viewX+(float)((clip.x/w+1)*.5*viewW);y=viewY+(float)((1-clip.y/w)*.5*viewH);return true;};
    auto append=[&](ProjectedReferenceEdge edge){auto nearDistance=[&](Vec3 point){auto clip=vp.transformPoint(point);return clip.z+vp.m[3]*point.x+vp.m[7]*point.y+vp.m[11]*point.z+vp.m[15];};double a=nearDistance(edge.a),b=nearDistance(edge.b);if(a<0&&b<0)return;if(a<0)edge.a=Vec3::lerpV(edge.a,edge.b,std::clamp((-a+1e-7)/(b-a),0.,1.));else if(b<0)edge.b=Vec3::lerpV(edge.a,edge.b,std::clamp((a-1e-7)/(a-b),0.,1.));if(project(edge.a,edge.ax,edge.ay,edge.aw)&&project(edge.b,edge.bx,edge.by,edge.bw))g_projectedReferenceEdges.push_back(edge);};
    for(size_t body=0;body<g_bodyIds.size();++body){if(!displayInstance(body))continue;auto* feature=g_doc.find(g_bodyIds[body]);if(curvesOnly&&(!feature||!isCurveFeature(feature->type)))continue;size_t part=g_instancePart[body];if(part>=g_partPicks.size())continue;const auto& pick=g_partPicks[part];
        bool named=false;for(size_t edge=0;edge<pick.edges.size()&&edge<pick.edgeNames.size();++edge){if(pick.edgeNames[edge].empty())continue;named=true;if(edge<pick.edgeVisible.size()&&!pick.edgeVisible[edge])continue;const auto& points=pick.edges[edge];
            for(size_t segment=1;segment<points.size();++segment)append({body,edge,g_instanceWorld[body].transformPoint(points[segment-1]),g_instanceWorld[body].transformPoint(points[segment]),0,0,0,0,0,0});
        }
        if(!curvesOnly&&!named&&meshPointerBody(body)){const auto& mesh=g_cpuMeshes[part];const auto& topology=meshPointerTopology(part);for(size_t edge=0;edge<topology.edges.size();++edge){auto vertices=topology.edges[edge];append({body,edge,g_instanceWorld[body].transformPoint(directMeshPoint(mesh,vertices.first)),g_instanceWorld[body].transformPoint(directMeshPoint(mesh,vertices.second)),0,0,0,0,0,0,vertices.first,vertices.second});}}
    }
}
static ReferencePointerHit namedEdgeAtPointer(int mx,int my,bool curvesOnly=false){
    struct Candidate {const ProjectedReferenceEdge* edge;float pixels,sx,sy;Vec3 world;};projectReferenceEdges(curvesOnly);std::map<std::pair<size_t,size_t>,Candidate> distinct;
    for(const auto& edge:g_projectedReferenceEdges){if(mx<std::min(edge.ax,edge.bx)-11||mx>std::max(edge.ax,edge.bx)+11||my<std::min(edge.ay,edge.by)-11||my>std::max(edge.ay,edge.by)+11)continue;float dx=edge.bx-edge.ax,dy=edge.by-edge.ay,t=std::clamp(((mx-edge.ax)*dx+(my-edge.ay)*dy)/std::max(1e-6f,dx*dx+dy*dy),0.f,1.f),sx=edge.ax+t*dx,sy=edge.ay+t*dy,pixels=std::hypot(sx-mx,sy-my);if(pixels>11)continue;
        double denominator=(1-t)/edge.aw+t/edge.bw;double worldT=(t/edge.bw)/denominator;Candidate candidate{&edge,pixels,sx,sy,edge.a+(edge.b-edge.a)*worldT};auto k=std::make_pair(edge.body,edge.edge);auto found=distinct.find(k);if(found==distinct.end()||pixels<found->second.pixels)distinct[k]=candidate;
    }
    std::vector<Candidate> candidates;for(const auto& entry:distinct)candidates.push_back(entry.second);std::sort(candidates.begin(),candidates.end(),[](const Candidate& a,const Candidate& b){if(a.pixels!=b.pixels)return a.pixels<b.pixels;return a.edge->body!=b.edge->body?a.edge->body<b.edge->body:a.edge->edge<b.edge->edge;});
    size_t probes=0;for(const auto& candidate:candidates){if(++probes>64)break;Vec3 rayOrigin,rayDirection;viewRay((int)std::lround(candidate.sx),(int)std::lround(candidate.sy),rayOrigin,rayDirection);double candidateDepth=(candidate.world-rayOrigin).dot(rayDirection);if(candidateDepth<0)continue;
        auto blocker=pickSurface((int)std::lround(candidate.sx),(int)std::lround(candidate.sy));if(blocker.hit){double mmPerPixel=2*(g_cameraOrtho?std::max(2.,dist*std::tan(35*K_PI/360.)):candidateDepth*std::tan(35*K_PI/360.))/std::max(viewH,1);if(blocker.distance+std::max(.02,mmPerPixel*1.5)<candidateDepth)continue;}
        const auto& edge=*candidate.edge;ReferencePointerHit result;result.hit=true;result.body=(int)edge.body;result.edge=(int)edge.edge;if(edge.meshA!=~u32(0)){result.item={g_bodyIds[edge.body],"mesh_edge",std::to_string(edge.meshA)+" : "+std::to_string(edge.meshB),"",g_instanceIds[edge.body],g_instanceCopies[edge.body]};result.item.meshVertices={edge.meshA,edge.meshB};result.item.topology=meshPointerTopology(g_instancePart[edge.body]).fingerprint;}else result.item={g_bodyIds[edge.body],"edge",g_partPicks[g_instancePart[edge.body]].edgeNames[edge.edge],"",g_instanceIds[edge.body],g_instanceCopies[edge.body]};return result;
    }return {};
}
static ReferencePointerHit referenceAtPointer(int mx,int my){
    if(g_pickKind==2||g_pickKind==3){if(g_pickKind==3){float best=8;const CurveSample* chosen=nullptr;for(const auto& sample:g_curveSamples){float ax,ay,bx,by;if(!projectScreen(sample.a,ax,ay)||!projectScreen(sample.b,bx,by))continue;float dx=bx-ax,dy=by-ay,t=std::clamp(((mx-ax)*dx+(my-ay)*dy)/std::max(1e-6f,dx*dx+dy*dy),0.f,1.f),pixels=std::hypot(ax+t*dx-mx,ay+t*dy-my);if(pixels<best){best=pixels;chosen=&sample;}}if(chosen){ReferencePointerHit result;result.hit=true;result.item.kind="curve";result.item.owner=chosen->sketch;result.item.name=chosen->name;return result;}}
        if(g_allSheetsFlat||g_stockMode)return {};return namedEdgeAtPointer(mx,my,g_pickKind==3);
    }
    if(g_pickKind!=1||g_allSheetsFlat||g_stockMode)return {};auto hit=pickSurface(mx,my);if(!hit.hit)return {};size_t part=g_instancePart[(size_t)hit.body];if(part>=g_partPicks.size())return {};const auto& pick=g_partPicks[part];
    for(size_t face=0;face<pick.faces.size()&&face<pick.faceNames.size();++face){auto span=pick.faces[face];if((int)hit.triangle>=span.first&&(int)hit.triangle<span.first+span.second&&!pick.faceNames[face].empty()){ReferencePointerHit result;result.hit=true;result.body=hit.body;result.face=(int)face;result.item={g_bodyIds[(size_t)hit.body],"face",pick.faceNames[face],"",g_instanceIds[(size_t)hit.body],g_instanceCopies[(size_t)hit.body]};return result;}}
    if(meshPointerBody((size_t)hit.body)){ReferencePointerHit result;result.body=hit.body;result.face=(int)hit.triangle;result.item={g_bodyIds[(size_t)hit.body],"mesh_face",std::to_string(hit.triangle),"",g_instanceIds[(size_t)hit.body],g_instanceCopies[(size_t)hit.body]};result.item.meshTriangles=pointerMeshPatch(part,hit.triangle);if(result.item.meshTriangles.empty()){result.error="Coplanar mesh patch exceeds 4096 source triangles / split the source patch before selecting";return result;}result.hit=true;result.item.name=std::to_string(result.item.meshTriangles.front());result.item.topology=meshPointerTopology(part).fingerprint;return result;}
    return {};
}
static void selectPointerReference(const ReferencePointerHit& hit,bool additive){
    if(hit.body>=0)selBody=hit.body;if(additive){toggleSelection(hit.item);g_status="Selection updated / "+std::to_string(g_picked.size())+" references";}else{g_picked={hit.item};refreshSelectionLines();g_status="Selected "+pointerReferenceLabel(hit);}
}
static bool pickNamedEdgeScreen(int mx,int my,bool curvesOnly=false){auto hit=namedEdgeAtPointer(mx,my,curvesOnly);if(!hit.hit)return false;selectPointerReference(hit,false);return true;}
static void pickReference(int mx,int my,bool additive=false){
    g_viewportContainer=0;
    if(g_pickKind==4){if(!pickDatumScreen(mx,my))g_status="Click a visible construction datum";return;}if((g_pickKind==1||g_pickKind==2)&&(g_allSheetsFlat||g_stockMode)){g_status="Preview meshes have no exact face or edge authority / Return to Formed before reference picking";return;}g_explorerFeature=0;g_selectedExplorerEntity.reset();auto hit=referenceAtPointer(mx,my);if(hit.hit){selectPointerReference(hit,additive);return;}
    if(!additive){g_picked.clear();refreshSelectionLines();}if(!hit.error.empty()){g_error=true;g_status=hit.error;return;}auto surface=pickSurface(mx,my);if(surface.hit){size_t part=g_instancePart[(size_t)surface.body];bool empty=part>=g_partPicks.size()||(g_pickKind==1?std::none_of(g_partPicks[part].faceNames.begin(),g_partPicks[part].faceNames.end(),[](const std::string& name){return !name.empty();}):std::none_of(g_partPicks[part].edgeNames.begin(),g_partPicks[part].edgeNames.end(),[](const std::string& name){return !name.empty();}));if(empty){selBody=surface.body;g_status="This displayed body has no selectable references at this pointer / use source geometry controls";return;}}
    g_status=g_allSheetsFlat||g_stockMode?"Return to Formed for exact face or edge picking":g_pickKind==2?"No visible edge within 11 pixels / move onto a visible edge":"No selectable reference here / hover highlights the next click target";
}
static void updateSelectionHover(int x,int y){
    if(g_pickKind<1||g_pickKind>3||g_directAuthoring.active||g_sketchEditing.active||g_sketchDrawing.active||g_componentMove.armed||g_toolsOpen||x<viewX||y<viewY||x>=viewX+viewW||y>=viewY+viewH){clearSelectionHover();return;}
    for(const auto& zone:g_zones)if(x>=zone.x&&x<=zone.x+zone.w&&y>=zone.y&&y<=zone.y+zone.h){clearSelectionHover();return;}
    auto vp=cameraProjection()*cameraView();std::vector<double> queryKey{(double)x,(double)y,(double)g_pickKind,(double)g_displayMeshSerial,(double)g_session.revision,(double)g_documentEpoch,(double)viewX,(double)viewY,(double)viewW,(double)viewH,g_showSketches?1.:0.,g_allSheetsFlat?1.:0.,g_stockMode?1.:0.};queryKey.insert(queryKey.end(),vp.m,vp.m+16);for(size_t body=0;body<g_instanceWorld.size();++body){queryKey.push_back(displayInstance(body)?1.:0.);queryKey.insert(queryKey.end(),g_instanceWorld[body].m,g_instanceWorld[body].m+16);}if(queryKey==g_hoverReferenceQueryKey)return;
    auto hit=referenceAtPointer(x,y);std::vector<double> geometryKey{(double)g_displayMeshSerial,(double)g_session.revision,(double)g_documentEpoch};if(hit.body>=0)geometryKey.insert(geometryKey.end(),g_instanceWorld[(size_t)hit.body].m,g_instanceWorld[(size_t)hit.body].m+16);if(hit.hit&&g_hoverReference.hit&&sameReference(hit.item,g_hoverReference.item)&&hit.body==g_hoverReference.body&&geometryKey==g_hoverReferenceGeometryKey){g_hoverReferenceQueryKey=std::move(queryKey);return;}clearSelectionHover();g_hoverReferenceQueryKey=std::move(queryKey);g_hoverReference=hit;g_hoverReferenceGeometryKey=std::move(geometryKey);++g_hoverReferenceGeneration;if(!hit.hit){g_hoverReferenceHint=hit.error;return;}
    g_hoverReferenceHint=pointerReferenceLabel(hit);auto put=[&](std::vector<float>& list,Vec3 point){list.insert(list.end(),{(float)point.x,(float)point.y,(float)point.z});};if(hit.body<0){for(const auto& sample:g_curveSamples)if(sample.sketch==hit.item.owner&&sample.name==hit.item.name){put(g_hoverReferenceLines,sample.a);put(g_hoverReferenceLines,sample.b);}return;}size_t part=g_instancePart[(size_t)hit.body];const auto& world=g_instanceWorld[(size_t)hit.body];const auto& pick=g_partPicks[part];
    if(hit.item.kind=="mesh_edge"){const auto& mesh=g_cpuMeshes[part];for(u32 vertex:hit.item.meshVertices)put(g_hoverReferenceLines,world.transformPoint(directMeshPoint(mesh,vertex)));return;}
    if(hit.item.kind=="mesh_face"){const auto& mesh=g_cpuMeshes[part];using Point=std::array<float,3>;std::map<std::pair<Point,Point>,unsigned> boundary;for(u32 triangle:hit.item.meshTriangles){Point points[3];for(int k=0;k<3;++k){auto p=directMeshPoint(mesh,mesh.idx[(size_t)triangle*3+k]);put(g_hoverReferenceFill,world.transformPoint(p));points[k]={(float)p.x,(float)p.y,(float)p.z};}for(int k=0;k<3;++k){auto a=points[k],b=points[(k+1)%3];if(b<a)std::swap(a,b);++boundary[{a,b}];}}for(const auto& edge:boundary)if(edge.second==1)for(const auto& p:{edge.first.first,edge.first.second})put(g_hoverReferenceLines,world.transformPoint({p[0],p[1],p[2]}));return;}
    if(hit.edge>=0){const auto& points=pick.edges[(size_t)hit.edge];for(size_t i=1;i<points.size();++i){put(g_hoverReferenceLines,world.transformPoint(points[i-1]));put(g_hoverReferenceLines,world.transformPoint(points[i]));}}
    if(hit.face>=0){auto span=pick.faces[(size_t)hit.face];const auto& mesh=g_cpuMeshes[part];for(int triangle=span.first;triangle<span.first+span.second;++triangle)for(int corner=0;corner<3;++corner)put(g_hoverReferenceFill,world.transformPoint(directMeshPoint(mesh,mesh.idx[(size_t)triangle*3+corner])));}
}
