static bool surfaceQualityAction068B(int id){using namespace surface_quality_068b;if(id<50000||id>50004)return false;if(id==50000)analyze();else if(id==50001)seam();else if(id==50002)match();else if(id==50003)hide();else apply();return true;}
static void drawSurfaceQuality068B(){
    using namespace surface_quality_068b;
    if(!state.active)return;
    if(!currentDisplay()){state.active=false;state.candidate.clear();return;}
    static GLuint vao=0,vbo=0;if(!vao){glGenVertexArrays(1,&vao);glGenBuffers(1,&vbo);}
    glViewport(viewX,winH-viewY-viewH,viewW,viewH);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);glUseProgram(pSketch);
    const auto matrix=cameraProjection()*cameraView();float vp[16];for(int i=0;i<16;++i)vp[i]=(float)matrix.m[i];glUniformMatrix4fv(glGetUniformLocation(pSketch,"vp"),1,GL_FALSE,vp);
    glBindVertexArray(vao);glBindBuffer(GL_ARRAY_BUFFER,vbo);glEnableVertexAttribArray(0);glVertexAttribPointer(0,3,GL_FLOAT,GL_FALSE,12,nullptr);
    auto draw=[&](const std::vector<float>& data,GLenum mode,float r,float g,float b,float a){if(data.empty())return;glBufferData(GL_ARRAY_BUFFER,(GLsizeiptr)(data.size()*sizeof(float)),data.data(),GL_DYNAMIC_DRAW);glUniform4f(glGetUniformLocation(pSketch,"tint"),r,g,b,a);glDrawArrays(mode,0,(GLsizei)(data.size()/3));};
    if(state.mode<2&&state.n>=3){
        std::array<std::vector<float>,32> groups;const auto eye=camEye();const double pi=std::acos(-1.);
        struct ColoredPoint {Vec3 point;double value;};
        auto scalar=[&](const Sample& sample){if(state.mode==0)return std::clamp(sample.curvature/std::max(state.maximum,1e-12),0.,1.);Vec3 normal=sample.normal,view=eye-sample.point;if(normal.len()<1e-12||view.len()<1e-12)return 0.;normal=normal*(1/normal.len());view=view*(1/view.len());const auto reflected=normal*(2*normal.dot(view))-view;return (reflected.x+reflected.z*.37)*45/pi;};
        auto put=[&](int band,Vec3 p){groups[band].insert(groups[band].end(),{(float)p.x,(float)p.y,(float)p.z});};
        auto clip=[](const std::vector<ColoredPoint>& polygon,double cut,bool greater){std::vector<ColoredPoint> out;if(polygon.empty())return out;out.reserve(6);auto a=polygon.back();bool insideA=greater?a.value>=cut:a.value<=cut;for(const auto& b:polygon){const bool insideB=greater?b.value>=cut:b.value<=cut;if(insideA!=insideB){const double t=(cut-a.value)/(b.value-a.value);out.push_back({a.point+(b.point-a.point)*t,cut});}if(insideB)out.push_back(b);a=b;insideA=insideB;}return out;};
        if(state.cells){
            // Clip display triangles by the interpolated sample scalar. Unlike
            // one colour per triangle, adjacent cells share smooth stripe edges.
            for(int u=0;u<state.n-1;++u)for(int v=0;v<state.n-1;++v)for(int triangle=0;triangle<2;++triangle){
                const int i=u*state.n+v;const int indices[2][3]={{i,i+state.n,i+1},{i+1,i+state.n,i+state.n+1}};
                const auto& a=state.samples[indices[triangle][0]],&b=state.samples[indices[triangle][1]],&c=state.samples[indices[triangle][2]];if(!a.valid||!b.valid||!c.valid)continue;
                const double factor=state.mode==0?32.:1.;std::vector<ColoredPoint> vertices{{a.point,scalar(a)*factor},{b.point,scalar(b)*factor},{c.point,scalar(c)*factor}};
                int first=(int)std::floor(std::min({vertices[0].value,vertices[1].value,vertices[2].value})),last=(int)std::floor(std::max({vertices[0].value,vertices[1].value,vertices[2].value}));if(state.mode==0){first=std::clamp(first,0,31);last=std::clamp(last,0,31);}
                for(int band=first;band<=last;++band){auto polygon=clip(clip(vertices,(double)band,true),(double)band+1,false);const int color=state.mode==0?band:band%2==0?31:0;for(size_t k=1;k+1<polygon.size();++k){put(color,polygon[0].point);put(color,polygon[k].point);put(color,polygon[k+1].point);}}
            }
        }else for(const auto& sample:state.samples)if(sample.valid){const auto value=scalar(sample);const int color=state.mode==0?std::clamp((int)(31*value),0,31):(int)std::floor(value)%2==0?31:0;put(color,sample.point);}
        glPointSize(5);glEnable(GL_DEPTH_TEST);glDepthMask(GL_FALSE);glEnable(GL_POLYGON_OFFSET_FILL);glPolygonOffset(-2,-2);
        for(int i=0;i<32;++i){const float t=i/31.f;if(state.mode==1)draw(groups[i],state.cells?GL_TRIANGLES:GL_POINTS,t>.5f?.95f:.025f,t>.5f?.95f:.025f,t>.5f?.95f:.025f,.98f);else draw(groups[i],state.cells?GL_TRIANGLES:GL_POINTS,.1f+.85f*t,.3f+.5f*(1-std::abs(t*2-1)),.9f-.8f*t,.94f);}
        glDisable(GL_POLYGON_OFFSET_FILL);glDepthMask(GL_TRUE);glPointSize(1);
    }
