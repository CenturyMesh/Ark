static void analyze(){const u64 revision=g_session.revision,epoch=g_documentEpoch;std::vector<EditorField> fields{pickField("Source feature",selectedFeatureId(),4),pickField("Exact face / blank for one face","",1),choiceField("Display","Curvature",{"Curvature","Zebra reflections"}),{"Grid samples per direction","25"}};if(!editFields("Surface quality","Native curvature values come from exact surface derivatives. Zebra and the interpolated overlay are visual diagnostics, not geometric proof.",fields))return;current(revision,epoch);const u64 id=featureIdField(fields[0].value);const auto world=frame(id);V request=args("quality",id,revision);if(!trimField(fields[1].value).empty())request.set("reference",V::makeStr(trimField(fields[1].value)));request.set("samples",V::makeNum(surface_workflow_059c::integer(fields[3].value,3,65,"Grid samples")));const auto data=invoke(request);current(revision,epoch);start(revision,epoch,world,id);state.mode=fields[2].value=="Curvature"?0:1;state.n=(int)at(data,"grid_size").num;state.cells=at(data,"display_grid_cells_safe").b;state.maximum=at(data,"max_abs_curvature_per_mm").num;for(const auto& row:at(data,"samples").arr){Sample s;s.valid=at(row,"valid").b;if(s.valid){s.point=world.transformPoint(surfacePoint059(at(row,"point_mm")));const auto n=surfacePoint059(at(row,"normal"));s.normal={world.m[0]*n.x+world.m[4]*n.y+world.m[8]*n.z,world.m[1]*n.x+world.m[5]*n.y+world.m[9]*n.z,world.m[2]*n.x+world.m[6]*n.y+world.m[10]*n.z};s.curvature=std::max(std::abs(at(row,"max_curvature_per_mm").num),std::abs(at(row,"min_curvature_per_mm").num));}state.samples.push_back(s);}std::ostringstream summary;summary<<"SURFACE QUALITY\r\n"<<g_doc.find(id)->name<<" / "<<at(data,"face_reference").asStr()<<"\r\n\r\nNative regular samples: "<<at(data,"valid_samples").num<<"\r\nOutside trimmed face: "<<at(data,"outside_trim_samples").num<<"\r\nSingular samples: "<<at(data,"singular_samples").num<<"\r\nPrincipal curvature range: "<<drawingNumber(at(data,"min_curvatur