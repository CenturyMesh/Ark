;g_status="Matched exact preview / cyan / Apply surface match or Cancel";}
static void apply(){if(!state.active||state.candidate.empty())throw std::runtime_error("Prepare and review a matched surface first");current(state.revision,state.epoch);if(!currentDisplay()){state.active=false;state.candidate.clear();throw std::runtime_error("Source or target occurrence visibility/frame changed; prepare the match again");}V args=V::makeObj();args.set("expected_revision",V::makeNum((double)state.revision));args.set("candidate_id",V::makeStr(state.candidate));runTool("doc_apply",args);if(!g_error){const auto created=state.resultFeature;int selected=-1;for(size_t i=0;i<g_bodyIds.size();++i)if(g_bodyIds[i]==created&&displayInstance(i)){selected=(int)i;break;}hide();if(selected>=0){selectBody062(selected,false);clearSelectionHover();g_status="Matched surface applied and selected / original dependencies retained";}else g_status="Matched definition saved / no occurrence was requested";}}
