static std::vector<EditorField> pairFields(){if(selBody<0||(size_t)selBody>=g_bodyIds.size()||!displayInstance(selBody)||faceCyclePreview059(selBody))throw std::runtime_error("Select the visible exact source in its authored pose before opening this tool");const auto source=g_bodyIds[selBody];std::set<u64> seen;std::vector<std::string> all,targets;for(size_t i=0;i<g_bodyIds.size();++i)if(displayInstance(i)&&!faceCyclePreview059((int)i)&&seen.insert(g_bodyIds[i]).second){const auto* feature=g_doc.find(g_bodyIds[i]);if(feature&&isNativeFeature(feature->type)&&!isCurveFeature(feature->type)){const auto label=featureLabel(feature->id);all.push_back(label);if(feature->id!=source)targets.push_back(label);}}if(targets.empty())throw std::runtime_error("Show a second exact surface to use as target");const auto sourceLabel=featureLabel(source);std::vector<std::string> sources=g_doc.assembly.empty()?all:std::vector<std::string>{sourceLabel};return {choiceField(g_doc.assembly.empty()?"Source feature":"Source occurrence",sourceLabel,sources),{"Source face (optional)",""},choiceField("Target feature",targets.front(),g_doc.assembly.empty()?all:targets),{"Target face (optional)",""},choiceField("Source natural side","u_min",{"u_min","u_max","v_min","v_max"}),choiceField("Target natural side","u_min",{"u_min","u_max","v_min","v_max"}),{"Reverse target correspondence","0",true}};}
static std::string seamSummary(const V& data){std::ostringstream out;out<<"NATIVE SEAM CHECK\r\nMaximum gap: "<<drawingNumber(at(data,"max_gap_mm").num)<<" mm\r\nMaximum tangent-plane angle: "<<drawingNumber(at(data,"max_tangent_angle_deg").num)<<" deg\r\nMaximum curvature tensor difference: "<<drawingNumber(at(data,"max_curvature_tensor_error_per_mm").num)<<" / mm\r\n\r\nSampled G0: "<<(at(data,"sampled_g0").b?"pass":"fail")<<"\r\nSampled G1: "<<(at(data,"sampled_g1").b?"pass":"fail")<<"\r\nSampled G2: "<<(at(data,"sampled_g2").b?"pass":"fail")<<"\r\n\r\nPosition limit 0.000001 mm; angle 0.001 deg; tensor 0.0001/mm.\r\nChecks are at explicit native checkpoints, not a global continuity certificate.";return out.str();}
static void seam(){const auto revision=g_session.revision,epoch=g_documentEpoch;auto fields=pairFields();if(!editFields("Check surface seam","Choose explicit natural sides of two faces in the same frame. Orange connectors show positional gaps.",fields,false,"Inspect"))return;current(revision,epoch);const auto request=pairRequest("seam",fields,revision),data=invoke(request);current(revision,epoch);start(revision,epoch,frame((u64)at(request,"id").num),(u64)at(request,"id").num,(u64)at(request,"target_id").num);state.mode=2;const auto& samples=at(data,"samples").arr;for(size_t i=0;i<samples.size();++i){const auto a=state.world.transformPoint(surfacePoint059(at(samples[i],"source_point_mm"))),b=state.world.transformPoint(surfacePoint059(at(samples[i],"target_point_mm")));line(state.lines,a,b);if(i){line(state.lines,a,state.world.transformPoint(surfacePoint059(at(samples[i-1],"source_point_mm"))));line(state.lines,b,state.world.transformPoint(surfacePoint059(at(samples[i-1],"target_point_mm"))));}}report(seamSummary(data));g_status="Native seam inspected / see measured gap, tangent angle and curvature tensor";}
static V placedResult(u64 feature,const Mat4& world,const std::string& name){V command=V::makeObj(),p=V::makeObj();command.set("op",V::makeStr("assembly.add"));command.set("feature",V::makeNum((double)feature));command.set("name",V::makeStr(name+" / matched occurrence"));double ry=std::asin(std::clamp(-world.m[2],-1.,1.)),rx=0,rz=0;if(std::abs(std::cos(ry))>1e-9){rx=std::atan2(world.m[6],world.m[10]);rz=std::atan2(world.m[1],world.m[0]);}else rz=std::atan2(-world.m[4],world.m[5]);for(const auto& kv:std::array<std::pair<const char*,double>,6>{{{"tx",world.m[12]},{"ty",world.m[13]},{"tz",world.m[14]},{"rx",rad2deg(rx)},{"ry",rad2deg(ry)},{"rz",rad2deg(rz)}}})p.set(kv.first,V::makeNum(kv.second));command.set("p",p);return command;}
static void previewBoundary(std::vector<float>& lines,const Mesh& mesh,const Mat4& world){std::map<std::pair<u32,u32>,unsigned> counts;for(size_t t=0;t<mesh.triCount();++t)for(int k=0;k<3;++k){auto a=mesh.idx[t*3+k],b=mesh.idx[t*3+(k+1)%3];if(a>b)std::swap(a,b);++counts[{a,b}];}for(const auto& edge:counts)if(edge.second==1){auto p=[&](u32 i){return world.transformPoint({mesh.pos[i*3],mesh.pos[i*3+1],mesh.pos[i*3+2]});};line(lines,p(edge.first.first),p(edge.first.second));}}
static void match(){const auto revision=g_session.revision,epoch=g_documentEpoch;auto fields=pairFields();fields.push_back(choiceField("Requested continuity","G1",{"G0","G1","G2"}));fields.push_back({"Max pole move (mm)","20"});fields.push_back({"Cross-edge scale","1"});fields.push_back({"Result name","Matched surface"});const bool assemblyContext=!g_doc.assembly.empty();if(assemblyContext)fields.push_back(choiceField("Result placement","New occurrence in source frame",{"New occurrence in source frame","Definition only"}));if(!editFields("Match surface boundary","Untrimmed non-rational BSplines with compatible edges. Preview first; opposite edge and target stay fixed.",fields,false,"Preview"))return;current(revision,epoch);V request=pairRequest("match_plan",fields,revision);const u64 source=(u64)at(request,"id").num,target=(u64)at(request,"target_id").num;V sourceInfo=args("inspect",source,revision),targetInfo=args("inspect",target,revision);if(request.find("reference"))sourceInfo.set("reference",at(request,"reference"));if(request.find("target_reference"))targetInfo.set("reference",at(request,"target_reference"));const auto a=invoke(sourceInfo),b=invoke(targetInfo);request.set("source_brep_sha256",at(a,"source_brep_sha256"));request.set("target_brep_sha256",at(b,"source_brep_sha256"));request.set("continuity",V::makeNum(fields[7].value=="G0"?0:fields[7].value=="G1"?1:2));request.set("max_displacement_mm",V::makeNum(formNumber(fields[8].value)));request.set("cross_scale",V::makeNum(formNumber(fields[9].value)));request.set("name",V::makeStr(trimField(fields[10].value)));auto result=invoke(request);current(revision,epoch);const auto evidence=at(result,"evidence");const auto world=frame(source);std::string candidate=at(result,"candidate_id").asStr();auto retained=g_session.takePreparedCandidate(candidate);if(!retained)throw std::runtime_error("Matched preview is no longer retained");const bool place=assemblyContext&&fields[11].value=="New occurrence in source frame";i