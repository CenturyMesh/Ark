static bool surfaceOffsetAction068B(int id){using namespace surface_offset_view068;if(id<50040||id>50043)return false;if(id==50040)inspect();else if(id==50041)review();else if(id==50042){current();std::vector<EditorField> fields{{"Native inspection",summary()}};editFields("Offset diagnostics","Measured native samples and actual candidate construction. Curvature hotspots alone are not a failure proof.",fields,true,"Close",nullptr,true);}else{state.visible=false;g_status="Offset diagnostic markers hidden";}return true;}
