        g_dialogShot=shotPath+".typed-explore-dialog.png";explore("finish",{});g_dialogShot.clear();check(!g_error&&field(state.report,"attempted").num==6&&field(state.report,"failed").num==0&&tried(3,"finish").str=="oak, oiled"&&tried(4,"finish").str==steel&&tried(5,"finish").str==omega,"The offered text trial values were not explored as the declared texts: "+g_status);
        explore("pegs",{});check(!g_error&&field(state.report,"attempted").num==3&&tried(0,"pegs").num==2&&tried(2,"pegs").num==6,"The dialog did not offer the declared numeric choices of the selected row: "+g_status);
        explore("finish",{"rail"});check(!g_error&&field(state.report,"attempted").num==2&&tried(0,"rail").num==0&&tried(1,"rail").num==1&&listText(state.results,1).find(L"Trial 2 (rail = On) | ")==0,"Choosing another parameter did not offer its own trial values: "+g_status);
        explore("rail",{"rail","on, FALSE"});check(!g_error&&field(state.report,"attempted").num==2&&tried(0,"rail").num==1&&tried(1,"rail").num==0,"Boolean trial words were not read: "+g_status);
        explore("pegs",{"pegs","2, 5"});check(!g_error&&field(state.report,"attempted").num==2&&field(state.report,"failed").num==1,"An unlisted numeric choice was not kept as a failed trial: "+g_status);
        if(accents){explore("finish",{"finish",toDialog(steel+", matte")});check(!g_error&&field(state.report,"failed").num==0&&tried(0,"finish").str==steel,"An accented trial text was not read as its listed text: "+g_status);}
        explore("rail",{"rail","maybe"});check(g_error&&g_status.find("Trial values of rail are On or Off")!=std::string::npos,"A word that is not On or Off was accepted as a boolean trial: "+g_status);g_error=false;
