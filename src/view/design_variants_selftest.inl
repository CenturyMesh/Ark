        check(row("width")==L"width = 80 mm   [40 .. 200]"&&row("pegs")==L"pegs = 4   [2, 4, 6]"&&row("rail")==L"rail = Off   [Off, On]"&&row("finish")==L"finish = satin"+finishList,"Typed parameter rows do not show their values and declared lists: "+shownRows());
        {RECT client{};GetClientRect(state.parameters,&client);check(SendMessageW(state.parameters,LB_GETHORIZONTALEXTENT,0,0)>client.right,"A row wider than the parameter list cannot be scrolled into view");}
        stage("typed-edit");select("finish");g_dialogSmoke=3;g_dialogShot=shotPath+".typed-choice-dialog.png";g_dialogOverrideQueue={{"gloss"}};press(3);g_dialogSmoke=0;g_dialogShot.clear();check(!g_error&&staged("finish").t==V::Str&&staged("finish").str=="gloss"&&g_status.find("finish = gloss staged")!=std::string::npos,"The choice list did not stage the picked text: "+g_status);
        const bool accents=fromDialog(toDialog(steel))==steel;if(accents){choose("finish",toDialog(steel));check(staged("finish").str==steel&&row("finish")==widen("finish = "+steel)+finishList,"An accented choice was not staged as its listed text");}
        choose("finish","oak, oiled");check(staged("finish").str=="oak, oiled","A listed text holding a comma was not staged");
        choose("finish",toDialog(omega));check(staged("finish").str==omega,"A choice was not staged by its position in the declared list");choose("finish","gloss");
        select("rail");press(3);check(!g_error&&staged("rail").t==V::Num&&staged("rail").num==1&&g_status.find("rail = On staged")!=std::string::npos,"Edit value did not switch the boolean on: "+g_status);
        choose("pegs","6");check(staged("pegs").t==V::Num&&staged("pegs").num==6,"The choice list did not stage the picked number");
        check(row("finish")==L"finish = gloss"+finishList&&row("rail")==L"rail = On   [Off, On]"&&row("pegs")==L"pegs = 6   [2, 4, 6]","Staged typed values are not shown in the parameter rows: "+shownRows());
        const double glossVolume=80.*30*5+80.*4*12+6*160.,matteVolume=80.*30*3+80.*4*6+2*160.;
        auto about=[](double value,double expected){return std::fabs(value-expected)<=std::fabs(expected)*1e-9;};
        stage("typed-preview");const auto typedRevision=g_session.revision;press(4);check(!g_error,g_status);{const auto& rows=field(state.report,"results").arr;check(rows.size()==1,"Typed preview did not produce one row");check(field(rows[0],"valid").b,"Typed preview failed: "+field(rows[0],"error").asStr());const auto& m=field(rows[0],"metrics");check(about(field(m,"volume_mm3").num,glossVolume)&&about(field(m,"height_mm").num,12)&&about(field(m,"width_mm").num,80),"Preview metrics do not follow the staged choices: "+m.dump());}
        check(g_session.revision==typedRevision,"Preview published the typed configuration");capture(".typed.png");
        stage("typed-apply");press(5);check(!g_error&&g_session.revision==typedRevision+1,"Apply did not publish the typed configuration as one revision: "+g_status);
        auto binding=[&]()->const V&{for(const auto& p:g_doc.parametricPrograms.arr)if(field(p,"namespace").str=="tray")return field(p,"values");throw std::runtime_error("Tray binding missing");};
        auto named=[&](const std::string& prefix){int n=0;for(const auto& f:g_doc.features)if(f.name.rfind(prefix,0)==0)++n;return n;};
        check(field(binding(),"finish").t==V::Str&&field(binding(),"finish").str=="gloss"&&field(binding(),"rail").num==1&&field(binding(),"pegs").num==6&&named("tray / Peg ")==6&&named("tray / Plate gloss")==1&&named("tray / Plate satin")==0,"Applied values or generated objects differ from the staged choices: "+binding().dump());
        stage("typed-save");SetWindowTextW(state.name,L"Gloss railed");press(6);check(!g_error,g_status);
        choose("finish","matte");select("rail");press(3);check(staged("rail").num==0&&g_status.find("rail = Off staged")!=std::string::npos,"Edit value did not switch the boolean off: "+g_status);choose("pegs","2");SetWindowTextW(state.name,L"Matte plain");press(6);check(!g_error,g_status);
        {int typed=0;for(const auto& v:g_doc.designVariants.arr)if(field(v,"namespace").str=="tray"){++typed;const auto& values=field(v,"values");const bool gloss=field(v,"name").str=="Gloss railed";check(field(values,"finish").t==V::Str&&field(values,"finish").str==(gloss?"gloss":"matte")&&field(values,"rail").num==(gloss?1:0)&&field(values,"pegs").num==(gloss?6:2),"A saved typed configuration differs from its staged values: "+values.dump());}check(typed==2,"Two typed configurations were not saved");}
        stage("typed-compare");const auto comparedRevision=g_session.revision;press(9);check(!g_error,g_status);{const auto& rows=field(state.report,"results").arr;check(rows.size()==2,"Compare did not evaluate both typed configurations");for(const auto& r:rows){check(field(r,"valid").b,"A typed configuration failed: "+field(r,"error").asStr());check(about(field(field(r,"metrics"),"volume_mm3").num,field(r,"name").str=="Gloss railed"?glossVolume:matteVolume),"A compared volume does not follow its saved choices: "+field(r,"metrics").dump());}}
        {int index=-1;for(size_t i=0;i<state.savedNames.size();++i)if(state.savedNames[i]=="Gloss railed")index=(int)i;check(index>=0,"Saved typed configuration is not listed");SendMessageW(state.variants,LB_SETCURSEL,index,0);press(7);check(!g_error&&staged("finish").str=="gloss"&&staged("rail").num==1&&staged("pegs").num==6,"Load values did not stage the saved typed configuration: "+g_status);}
        // Explore: a listed text with a comma is one trial, an unlisted text stays a failed trial, and
