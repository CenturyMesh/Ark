        stage("typed-explore");auto explore=[&](const char* selected,std::vector<std::string> overrides){select(selected);g_dialogSmoke=3;g_dialogOverrideQueue.clear();if(!overrides.empty())g_dialogOverrideQueue.push_back(std::move(overrides));press(10);g_dialogSmoke=0;};
        auto tried=[&](size_t i,const char* name)->const V&{return field(field(field(state.report,"results").arr.at(i),"values"),name);};
        explore("finish",{"finish","gloss, oak, oiled, walnut"});check(!g_error,g_status);check(field(state.report,"attempted").num==3&&field(state.report,"failed").num==1,"Text exploration did not keep three trials with one failure");
        check(tried(0,"finish").str=="gloss"&&tried(1,"finish").str=="oak, oiled"&&field(field(state.report,"results").arr[1],"valid").b&&tried(2,"finish").str=="walnut"&&!field(field(state.report,"results").arr[2],"valid").b,"Text trial values were not read as listed texts");
        check(listText(state.results,1).find(L"Trial 2 (finish = oak, oiled) | ")==0&&listText(state.results,2).find(L"Trial 3 (finish = walnut) | FAILED")==0,"Exploration rows do not name the value they tried");capture(".typed-explore.png");
        SendMessageW(state.results,LB_SETCURSEL,1,0);press(11);check(!g_error&&staged("finish").str=="oak, oiled","Use selected result did not stage the explored text");
        explore("finish",{"finish",""});check(!g_error&&field(state.report,"attempted").num==6&&field(state.report,"failed").num==0&&tried(4,"finish").str==steel&&tried(5,"finish").str==omega&&field(state.report,"ranked_indices").arr.at(0).num==0,"No trial values did not try every declared text: "+g_status);
        // The dialog opens on the selected row with that row's own trial values, which read back as
