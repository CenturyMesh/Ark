static int testDesignVariantsUi(const std::string& shotPath){
    using namespace design_variants_view_067g;using V=arkjson::Value;
    auto check=[](bool ok,const std::string& why){if(!ok)throw std::runtime_error(why);};
    auto json=[&](const char* s){V v;check(arkjson::parse(s,v),"Bad variants fixture");return v;};
    const bool oldBusyTest=g_busyTestMode;g_busyTestMode=true;
    auto stage=[&](const char* step){std::ofstream(shotPath+".variants-progress.log",std::ios::app)<<step<<'\n';std::fprintf(stderr,"Variants UI: %s\n",step);std::fflush(stderr);};
    try{
        stage("begin/new-document");
        V fresh=V::makeObj();fresh.set("expected_revision",V::makeNum(double(g_session.revision)));runTool("doc_new",fresh);check(!g_error,g_status);
        V install=json(R"({"action":"prepare","mode":"install","namespace":"family","program":{"format":"ark.parametric-program.v1","name":"Bracket family","parameters":{"width":{"default":40,"min":20,"max":80,"unit":"mm"},"height":{"default":30,"min":10,"max":60,"unit":"mm"}},"body":[{"assert":"width>=25","message":"Width needs 25 mm for the interface"},{"emit":{"op":"feature.add","type":"native_solid","name":"Base","native":{"op":"box"},"p":{"width":"{width}","depth":24,"height":"{height}"}}}]}})");
        stage("install-program");install.set("expected_revision",V::makeNum(double(g_session.revision)));const auto prepared=runTool("parametric_program",install);check(!field(prepared,"isError").b,prepared.dump());V apply=V::makeObj();apply.set("candidate_id",field(field(prepared,"structuredContent"),"candidate_id"));apply.set("expected_revision",V::makeNum(double(g_session.revision)));runTool("doc_apply",apply);check(!g_error,g_status);
        stage("open-window");
        openDesignVariantsWindow();check(state.window&&state.parameterNames.size()==2,"Configurator controls and parameters missing");
        auto press=[&](int id){SendMessageW(state.window,WM_COMMAND,MAKEWPARAM(id,BN_CLICKED),(LPARAM)GetDlgItem(state.window,id));};
        auto save=[&](const wchar_t* name,double width){state.values.set("width",V::makeNum(width));fillParameters();SetWindowTextW(state.name,name);press(6);check(!g_error,g_status);check(field(state.values,"width").num==width,"Saving metadata must preserve staged configuration values");};
        stage("save-compact");save(L"Compact",25);stage("save-standard");save(L"Standard",40);stage("save-reinforced");save(L"Reinforced",70);check(g_doc.designVariants.arr.size()==3,"Three configurations did not persist");
        stage("compare");
        const auto revision=g_session.revision;press(9);check(field(state.report,"results").arr.size()==3,"Compare did not produce three rows");check(g_session.revision==revision,"Comparison published geometry");for(const auto& row:field(state.report,"results").arr)check(field(row,"valid").b&&!field(row,"display_triangles").arr.empty(),"Missing exact alternative or thumbnail");
        auto capture=[&](const char* suffix){InvalidateRect(state.window,nullptr,TRUE);UpdateWindow(state.window);bomCapture(state.window,shotPath+suffix);check(std::filesystem::is_regular_file(shotPath+suffix),"Variants capture missing");};capture(".compare.png");
        stage("apply-undo");SendMessageW(state.results,LB_SETCURSEL,0,0);press(11);check(field(state.values,"width").num==25,"Result values not loaded");press(5);check(field(field(g_doc.parametricPrograms.arr[0],"values"),"width").num==25,"Apply did not configure exact program");
        runTool("doc_undo",V::makeObj());check(field(field(g_doc.parametricPrograms.arr[0],"values"),"width").num==40,"Undo did not restore model");const auto afterUndo=g_session.revision;press(5);check(g_session.revision==afterUndo,"Stale configurator state published");press(1);
        // Exercise the real numeric dialog and staged preview button.
        stage("numeric-dialog");int widthIndex=0;for(size_t i=0;i<state.parameterNames.size();++i)if(state.parameterNames[i]=="width")widthIndex=(int)i;SendMessageW(state.parameters,LB_SETCURSEL,widthIndex,0);g_dialogSmoke=3;g_dialogOverrideQueue={{"52"}};press(3);g_dialogSmoke=0;check(field(state.values,"width").num==52,"Numeric editor did not stage input");press(4);check(field(state.report,"results").arr.size()==1&&field(field(field(state.report,"results").arr[0],"metrics"),"width_mm").num==52,"Preview failed to measure edited width");
        stage("exploration-dialog");g_dialogSmoke=3;g_dialogOverrideQueue={{"width","20, 25, 40, 70","volume_mm3","60","","","","","",""}};press(10);g_dialogSmoke=0;check(field(state.report,"attempted").num==4&&field(state.report,"failed").num==1,"Exploration lost rejected trial");check(field(state.report,"ranked_indices").arr.size()==2,"Feasibility filter not applied");capture(".explore.png");
        SetWindowPos(state.window,nullptr,0,0,980,700,SWP_NOMOVE|SWP_NOZORDER);capture(".compact.png");RECT client{};GetClientRect(state.window,&client);for(int id=1;id<=25;++id)if(auto control=GetDlgItem(state.window,id)){RECT r{};GetWindowRect(control,&r);MapWindowPoints(nullptr,state.window,(POINT*)&r,2);if(id!=20)check(r.left>=0&&r.right<=client.right&&r.top>=0&&r.bottom<=client.bottom,"Configurator control outside window: "+std::to_string(id));}
        const auto persisted=shotPath+".variants.ark";check(saveDocument(g_doc,persisted.c_str()),"Save variants document failed");Document loaded;std::string error;check(loadDocument(persisted.c_str(),loaded,&error),error);check(loaded.designVariants.arr.size()==3,"Saved variant configurations lost on reopen");
        DestroyWindow(state.window);g_busyTestMode=oldBusyTest;std::ofstream(shotPath+".variants-test.log")<<"PASS three named variants, exact preview, comparison thumbnails, apply/undo, stale rejection, numeric edit, exploration failures, compact controls, persistence\n";return 0;
    }catch(const std::exception& e){g_dialogSmoke=0;g_dialogOverrideQueue.clear();if(state.window)DestroyWindow(state.window);g_busyTestMode=oldBusyTest;std::ofstream(shotPath+".variants-test.log")<<"FAIL "<<e.what()<<'\n';return 1967;}
}
