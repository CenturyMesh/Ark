        {const auto typedFile=shotPath+".typed.ark";check(saveDocument(g_doc,typedFile.c_str()),"Save typed variants document failed");Document reopened;std::string why;check(loadDocument(typedFile.c_str(),reopened,&why),why);int typed=0;for(const auto& v:reopened.designVariants.arr)if(field(v,"namespace").str=="tray"&&field(field(v,"values"),"finish").t==V::Str)++typed;check(reopened.designVariants.arr.size()==5&&typed==2,"Saved text values were lost on reopen");}
        DestroyWindow(state.window);g_busyTestMode=oldBusyTest;std::ofstream(shotPath+".variants-test.log")<<"PASS three named variants, exact preview, comparison thumbnails, apply/undo, stale rejection, numeric edit, exploration failures, compact controls, persistence; typed parameters: boolean switch, numeric and text choice lists, comma and accented texts, preview/apply/save/compare, typed exploration with named trials"<<(accents?"":" (accented text not exercised: the system code page cannot carry it)")<<"\n";return 0;
    }catch(const std::exception& e){g_dialogSmoke=0;g_dialogOverrideQueue.clear();if(state.window)DestroyWindow(state.window);g_busyTestMode=oldBusyTest;std::ofstream(shotPath+".variants-test.log")<<"FAIL "<<e.what()<<'\n';return 1967;}
