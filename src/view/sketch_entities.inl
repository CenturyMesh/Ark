// Typed source recipes: generic fields share the same schema as the agent DTO.
static std::string recipeFieldText(const arkjson::Value& value){
    using V=arkjson::Value;if(value.t==V::Str)return value.str;if(value.t==V::Bool)return value.b?"1":"0";if(value.t==V::Arr){std::string text;for(const auto& item:value.arr){if(!text.empty())text+=item.t==V::Arr?"; ":", ";text+=recipeFieldText(item);}return text;}return value.dump();
}
static std::vector<std::string> recipeSplitCoordinates(const std::string& text,char separator){
    std::vector<std::string> parts;size_t start=0;int depth=0;for(size_t i=0;i<text.size();++i){if(text[i]=='(')++depth;else if(text[i]==')')--depth;else if(text[i]==separator&&depth==0){parts.push_back(trimField(text.substr(start,i-start)));start=i+1;}if(depth<0)throw std::runtime_error("Unbalanced coordinate expression");}if(depth)throw std::runtime_error("Unbalanced coordinate expression");parts.push_back(trimField(text.substr(start)));for(auto& p:parts)if(p.empty())throw std::runtime_error("Coordinate expression is empty");return parts;
}
static arkjson::Value recipeCoordinates(const std::string& text,unsigned dimensions,bool list=false){
    using V=arkjson::Value;V values=V::makeArr();auto pair=[&](const std::string& coordinates){V result=V::makeArr();auto parts=recipeSplitCoordinates(coordinates,',');if(parts.size()!=dimensions)throw std::runtime_error("Each point must have "+std::to_string(dimensions)+" comma-separated coordinates");for(auto& part:parts){V coordinate;if(!arkjson::parse(part,coordinate)||coordinate.t!=V::Num)coordinate=V::makeStr(part);result.arr.push_back(coordinate);}return result;};if(list){for(auto& row:recipeSplitCoordinates(text,';'))values.arr.push_back(pair(row));return values;}return pair(text);
}
