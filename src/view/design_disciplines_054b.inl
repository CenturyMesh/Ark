static State state;
static std::string bomUtf8(const wchar_t* value){const auto s=std::filesystem::path(value).u8string();return std::string(reinterpret_cast<const char*>(s.data()),s.size());}
static const V& get(const V& v,const char* key){static V empty;auto p=v.find(key);return p?*p:empty;}
static double num(const V& v,const char* key,double fallback=0){const auto& p=get(v,key);return p.t==V::Num?p.num:fallback;}
static std::string str(const V& v,const char* key){return get(v,key).asStr();}
static void fill(HDC dc,RECT r,COLORREF c){parametric_view_053b::fill(dc,r,c);}
static void text(HDC dc,const std::string& s,RECT r,COLORREF c,HFONT font,UINT flags=DT_LEFT|DT_VCENTER|DT_SINGLELINE|DT_END_ELLIPSIS){parametric_view_053b::text(dc,s,r,c,font,flags);}
static int right(){RECT r{};GetClientRect(state.window,&r);return std::max(500L,r.right-280);}
static POINT screen(Vec2 p){return {(LONG)std::lround(state.panX+p.x*state.zoom),(LONG)std::lround(state.panY+p.y*state.zoom)};}
static Vec2 world(int x,int y){return {(x-state.panX)/state.zoom,(y-state.panY)/state.zoom};}
static V* symbol(const std::string& id){for(auto& pair:state.sheet.obj)if(pair.first=="symbols")for(auto& s:pair.second.arr)if(str(s,"id")==id)return &s;return nullptr;}
static void fit(){RECT r{};GetClientRect(state.window,&r);state.zoom=std::max(.3,std::min((right()-60)/num(state.sheet,"width",297),(r.bottom-170)/num(state.sheet,"height",210)));state.panX=30;state.panY=130;}
static void refresh(bool force=false){
    if(!force&&state.revision==g_session.revision&&state.epoch==g_objectDocumentEpoch)return;
    state.dragging=state.panning=false;state.dragSymbol.clear();state.wireSymbol.clear();state.wirePin.clear();
    state.revision=g_session.revision;state.epoch=g_objectDocumentEpoch;
    if(!findSchematic(g_doc,state.name))state.name=g_doc.schematics.arr.empty()?"":str(g_doc.schematics.arr.front(),"name");
    const auto* current=findSchematic(g_doc,state.name);state.sheet=current?*current:V{};
    if(state.sheets){SendMessageW(state.sheets,CB_RESETCONTENT,0,0);int selected=0;for(size_t i=0;i<g_doc.schematics.arr.size();++i){auto name=str(g_doc.schematics.arr[i],"name");auto w=bomWide(name);SendMessageW(state.sheets,CB_ADDSTRING,0,(LPARAM)w.c_str());if(name==state.name)selected=(int)i;}SendMessageW(state.sheets,CB_SETCURSEL,selected,0);}
    if(!symbol(state.selected))state.selected.clear();if(state.window)InvalidateRect(state.window,nullptr,FALSE);
}
static void commit(const V& sheet){
    if(state.revision!=g_session.revision||state.epoch!=g_objectDocumentEpoch)throw std::runtime_error("The document changed. Inspect the current sheet and try again.");
    V c=V::makeObj(),a=V::makeObj(),commands=V::makeArr();c.set("op",V::makeStr("schematic.set"));c.set("sheet",sheet);commands.arr.push_back(c);a.set("commands",commands);a.set("expected_revision",V::makeNum((double)state.revision));auto result=runTool("doc_apply",a);if(get(result,"isError").b)throw std::runtime_error(get(result,"structuredContent").dump());state.name=str(sheet,"name");refresh(true);
}
static void selectSource(const V& s){const auto feature=(u64)num(s,"feature"),node=(u64)num(s,"node");for(size_t i=0;i<g_bodyIds.size();++i)if((node&&g_instanceIds[i]==node&&g_instanceCopies[i]==(int)num(s,"copy"))||(!node&&feature&&g_bodyIds[i]==feature)){selBody=(int)i;g_explorerFeature=feature;g_viewportContainer=0;g_picked.clear();refreshSelectionLines();InvalidateRect(g_window,nullptr,FALSE);break;}}
static std::string hitSymbol(int x,int y){if(x>=right()||y<110)return {};auto p=world(x,y);for(const auto& s:get(state.sheet,"symbols").arr){const auto rotation=(int)num(s,"rotation");const double w=num(s,"width",20)/2+2,h=num(s,"height",12)/2+2;const bool vertical=rotation==90||rotation==270;if(std::abs(p.x-num(s,"x"))<=(vertical?h:w)&&std::abs(p.y-num(s,"y"))<=(vertical?w:h))return str(s,"id");}return {};}
static std::optional<SchematicPin> hitPin(int x,int y){if(state.sheet.isNull()||x>=right()||y<110)return {};for(const auto& p:schematicDrawing(g_doc,state.sheet).pins){auto at=screen(p.point);if(std::hypot((double)x-at.x,(double)y-at.y)<=9)return p;}return {};}
static std::string hitWire(int x,int y){if(state.sheet.isNull()||x>=right()||y<110)return {};const auto art=schematicDrawing(g_doc,state.sheet);std::map<std::string,Vec2> pins;for(const auto& p:art.pins)pins[p.symbol+"/"+p.pin]=p.point;for(const auto& wire:get(state.sheet,"wires").arr){auto key=[](const V& p){return str(p,"symbol")+"/"+str(p,"pin");};std::vector<Vec2> points{pins.at(key(get(wire,"from")))};for(const auto& p:get(wire,"points").arr)points.push_back({p.arr[0].num,p.arr[1].num});points.push_back(pins.at(key(get(wire,"to"))));for(size_t i=1;i<points.size();++i){auto a=screen(points[i-1]),b=screen(points[i]);double dx=b.x-a.x,dy=b.y-a.y,t=std::clamp(((x-a.x)*dx+(y-a.y)*dy)/std::max(1.,dx*dx+dy*dy),0.,1.);if(std::hypot(x-a.x-t*dx,y-a.y-t*dy)<6)return str(wire,"id");}}return {};}
static std::string unique(const char* prefix,const char* collection,const char* key){for(int n=1;n<10000;++n){const auto id=std::string(prefix)+std::to_string(n);if(std::none_of(get(state.sheet,collection).arr.begin(),get(state.sheet,collection).arr.end(),[&](const V& item){return str(item,key)==id;}))return id;}throw std::runtime_error("Identity capacity");}
static V endpoint(const std::string& s,const std::string& p){V out=V::makeObj();out.set("symbol",V::makeStr(s));out.set("pin",V::makeStr(p));return out;}
static void connect(const SchematicPin& a,const SchematicPin& b){
    if(a.symbol==b.symbol&&a.pin==b.pin)return;
    std::string net="N"+std::to_string(get(state.sheet,"wires").arr.size()+1);for(const auto& wire:get(state.sheet,"wires").arr)for(const char* k:{"from","to"})if(str(get(wire,k),"symbol")==a.symbol&&str(get(wire,k),"pin")==a.pin)net=str(wire,"net");
    std::vector<EditorField> fields{{"Net name",net}};if(!editFields("Connect pins","Explicit pin connection. Crossing another wire does not connect it.",fields))return;
    V wire=V::makeObj(),points=V::makeArr();wire.set("id",V::makeStr(unique("wire","wires","id")));wire.set("net",V::makeStr(fields[0].value));wire.set("from",endpoint(a.symbol,a.pin));wire.set("to",endpoint(b.symbol,b.pin));
    if(std::abs(a.point.x-b.point.x)>.01&&std::abs(a.point.y-b.point.y)>.01)for(double y:{a.point.y,b.point.y}){V p=V::makeArr();p.arr={V::makeNum((a.point.x+b.point.x)/2),V::makeNum(y)};points.arr.push_back(p);}wire.set("points",points);V sheet=state.sheet,wires=get(sheet,"wires");wires.arr.push_back(wire);sheet.set("wires",wires);commit(sheet);
}
static void properties(bool adding){
    if(state.sheet.isNull())throw std::runtime_error("Create a schematic sheet first.");
    if(!adding&&!state.selectedWire.empty()){
        V sheet=state.sheet,wires=get(sheet,"wires");for(auto& wire:wires.arr)if(str(wire,"id")==state.selectedWire){std::vector<EditorField> f{{"Net",str(wire,"net")},{"Bend points / [[x,y],...]",get(wire,"points").isNull()?"[]":get(wire,"points").dump()}};if(!editFields("Wire properties","Endpoints remain linked to their pins. Bend coordinates are sheet millimetres.",f))return;V points;if(!arkjson::parse(f[1].value,points))throw std::runtime_error("Invalid bend point array");wire.set("net",V::makeStr(f[0].value));wire.set("points",points);}sheet.set("wires",wires);commit(sheet);return;
    }
    V s=adding?V::makeObj():symbol(state.selected)?*symbol(state.selected):V{};if(!adding&&s.isNull())throw std::runtime_error("Select a symbol or wire.");
    const auto id=adding?unique("symbol","symbols","id"):str(s,"id");
    std::vector<EditorField> f{{"Reference",adding?unique("X","symbols","ref"):str(s,"ref")},{"Label",str(s,"label")},{"Symbol",adding?"block":str(s,"kind"),false,{"block","connector","resistor","switch","ground","power"}},{"X / mm",std::to_string(num(s,"x",50))},{"Y / mm",std::to_string(num(s,"y",50))},{"Rotation",std::to_string((int)num(s,"rotation")),false,{"0","90","180","270"}},{"Part number",str(s,"part_number")},{"Manufacturer",str(s,"manufacturer")},{"CAD source / blank, feature:ID or node:ID",s.find("node")?"node:"+std::to_string((u64)num(s,"node")):s.find("feature")?"feature:"+std::to_string((u64)num(s,"feature")):""},{"CAD occurrence copy",std::to_string((int)num(s,"copy"))},{"Include in BOM",!s.find("bom")||get(s,"bom").b?"Yes":"No",false,{"Yes","No"}}};
    if(!editFields(adding?"Add schematic symbol":"Symbol properties","One reference is one BOM component. CAD binding is optional and explicit. Edit pin names and positions with Pins.",f))return;
    s.set("id",V::makeStr(id));s.set("ref",V::makeStr(f[0].value));s.set("label",V::makeStr(f[1].value));s.set("kind",V::makeStr(f[2].value));s.set("x",V::makeNum(formNumber(f[3].value)));s.set("y",V::makeNum(formNumber(f[4].value)));s.set("rotation",V::makeNum(formNumber(f[5].value)));s.set("part_number",V::makeStr(f[6].value));s.set("manufacturer",V::makeStr(f[7].value));s.set("bom",V::makeBool(f[10].value=="Yes"));
    s.obj.erase(std::remove_if(s.obj.begin(),s.obj.end(),[](const auto& kv){return kv.first=="feature"||kv.first=="node"||kv.first=="copy";}),s.obj.end());
    if(!f[8].value.empty()){const auto colon=f[8].value.find(':');if(colon==std::string::npos||(f[8].value.substr(0,colon)!="feature"&&f[8].value.substr(0,colon)!="node"))throw std::runtime_error("Source must be feature:ID or node:ID");s.set(f[8].value.substr(0,colon),V::makeNum(formNumber(f[8].value.substr(colon+1))));if(s.find("node"))s.set("copy",V::makeNum(formNumber(f[9].value)));}
    if(adding){V pins=V::makeArr();const bool terminal=f[2].value=="ground"||f[2].value=="power";for(int i=0;i<(terminal?1:2);++i){V pin=V::makeObj();pin.set("id",V::makeStr(std::to_string(i+1)));pin.set("x",V::makeNum(terminal?0:i?10:-10));pin.set("y",V::makeNum(terminal?(f[2].value=="ground"?-6:6):0));pins.arr.push_back(pin);}s.set("pins",pins);}
    V sheet=state.sheet,symbols=get(sheet,"symbols");if(adding)symbols.arr.push_back(s);else for(auto& row:symbols.arr)if(str(row,"id")==id)row=s;sheet.set("symbols",symbols);commit(sheet);state.selected=id;state.selectedWire.clear();
}
static void pins(){auto* current=symbol(state.selected);if(!current)throw std::runtime_error("Select a symbol first.");V selected=*current;const auto& existing=get(selected,"pins");const auto& first=existing.arr.front();std::vector<std::string> ids;for(const auto& p:existing.arr)ids.push_back(str(p,"id"));std::vector<EditorField> f{{"Pin ID / existing or new",str(first,"id"),false,ids,true},{"Label",str(first,"label")},{"Local X / mm",std::to_string(num(first,"x"))},{"Local Y / mm",std::to_string(num(first,"y"))},{"Action","Set",false,{"Set","Remove"}}};if(!editFields("Edit symbol pins","Coordinates are local to the symbol and rotate with it. Connected pins cannot be removed until their wires are removed.",f))return;V list=existing;auto found=std::find_if(list.arr.begin(),list.arr.end(),[&](const V& p){return str(p,"id")==f[0].value;});if(f[4].value=="Remove"){if(found==list.arr.end())throw std::runtime_error("Pin not found");list.arr.erase(found);}else{V p=V::makeObj();p.set("id",V::makeStr(f[0].value));p.set("label",V::makeStr(f[1].value));p.set("x",V::makeNum(formNumber(f[2].value)));p.set("y",V::makeNum(formNumber(f[3].value)));if(found==list.arr.end())list.arr.push_back(p);else *found=p;}selected.set("pins",list);V sheet=state.sheet,symbols=get(sheet,"symbols");for(auto& s:symbols.arr)if(str(s,"id")==state.selected)s=selected;sheet.set("symbols",symbols);commit(sheet);}
static void eraseSelection(){V sheet=state.sheet,wires=get(sheet,"wires"),symbols=get(sheet,"symbols");if(!state.selectedWire.empty())wires.arr.erase(std::remove_if(wires.arr.begin(),wires.arr.end(),[&](const V& w){return str(w,"id")==state.selectedWire;}),wires.arr.end());else if(!state.selected.empty()){symbols.arr.erase(std::remove_if(symbols.arr.begin(),symbols.arr.end(),[&](const V& s){return str(s,"id")==state.selected;}),symbols.arr.end());wires.arr.erase(std::remove_if(wires.arr.begin(),wires.arr.end(),[&](const V& w){return str(get(w,"from"),"symbol")==state.selected||str(get(w,"to"),"symbol")==state.selected;}),wires.arr.end());}else return;sheet.set("symbols",symbols);sheet.set("wires",wires);commit(sheet);state.selected.clear();state.selectedWire.clear();}
static void exportSheet(const char* kind){if(state.name.empty())throw std::runtime_error("Select a sheet first.");wchar_t path[2048]=L"schematic";OPENFILENAMEW dialog{};dialog.lStructSize=sizeof dialog;dialog.hwndOwner=state.window;dialog.lpstrFile=path;dialog.nMaxFile=2048;dialog.lpstrFilter=std::string(kind)=="dxf"?L"DXF schematic\0*.dxf\0\0":L"Schematic BOM CSV\0*.csv\0\0";dialog.lpstrDefExt=std::string(kind)=="dxf"?L"dxf":L"csv";dialog.Flags=OFN_PATHMUSTEXIST|OFN_NOCHANGEDIR;if(!GetSaveFileNameW(&dialog))return;V args=V::makeObj();args.set("name",V::makeStr(state.name));args.set("format",V::makeStr(kind));args.set("path",V::makeStr(bomUtf8(path)));args.set("expected_revision",V::makeNum((double)state.revision));auto result=runTool("schematic_export",args);if(get(result,"isError").b)throw std::runtime_error(get(result,"structuredContent").dump());g_status="Schematic exported / "+bomUtf8(path);}
static void action(int id){if(state.busy)return;state.busy=true;struct Done{~Done(){state.busy=false;if(state.window)InvalidateRect(state.window,nullptr,FALSE);}} done;try{state.error.clear();refresh();
    if(id==1){std::vector<EditorField> f{{"Sheet name","Circuit "+std::to_string(g_doc.schematics.arr.size()+1)},{"Title","Electrical schematic"},{"Width / mm","297"},{"Height / mm","210"}};if(!editFields("New electrical schematic","Editable symbols and explicit pin connections; independent of technical drawings.",f))return;if(findSchematic(g_doc,f[0].value))throw std::runtime_error("Sheet name already exists");V sheet=V::makeObj();sheet.set("name",V::makeStr(f[0].value));sheet.set("title",V::makeStr(f[1].value));sheet.set("width",V::makeNum(formNumber(f[2].value)));sheet.set("height",V::makeNum(formNumber(f[3].value)));sheet.set("symbols",V::makeArr());sheet.set("wires",V::makeArr());commit(sheet);fit();}
    else if(id==2)properties(true);else if(id==3){state.wireMode=!state.wireMode;state.wireSymbol.clear();state.wirePin.clear();}else if(id==4)properties(false);else if(id==5)pins();else if(id==6)eraseSelection();else if(id==7)exportSheet("dxf");else if(id==8)exportSheet("bom_csv");else if(id==9)fit();else if(id==10){runTool("doc_undo",V::makeObj());refresh(true);}else if(id==11){runTool("doc_redo",V::makeObj());refresh(true);}
}catch(const std::exception& e){state.error=e.what();refresh(true);}}
static void paint(HDC dc){
    RECT r{};GetClientRect(state.window,&r);fill(dc,r,RGB(19,27,35));text(dc,"SCHEMATIC / DESIGNER",{22,10,right()-10,40},RGB(125,220,217),state.title);text(dc,state.name.empty()?"Create a sheet to begin":state.name,{22,40,right()-10,65},RGB(180,195,208),state.font);
    const int canvasRight=right();RECT canvas{0,110,canvasRight,r.bottom-32};SaveDC(dc);IntersectClipRect(dc,canvas.left,canvas.top,canvas.right,canvas.bottom);fill(dc,canvas,RGB(34,45,56));
    if(!state.sheet.isNull())try{
        auto a=screen({0,0}),b=screen({num(state.sheet,"width",297),num(state.sheet,"height",210)});RECT paper{a.x,a.y,b.x,b.y};fill(dc,paper,RGB(246,248,247));
        if(state.zoom>1.4)for(double x=0;x<=num(state.sheet,"width",297);x+=5)for(double y=0;y<=num(state.sheet,"height",210);y+=5){auto p=screen({x,y});SetPixelV(dc,p.x,p.y,RGB(212,222,222));}
        auto art=schematicDrawing(g_doc,state.sheet);for(const auto& segment:art.lines){auto p=screen(segment.a),q=screen(segment.b);const auto c=segment.layer=="WIRES"?RGB(22,130,126):segment.layer=="PINS"?RGB(218,125,53):RGB(40,61,80);auto pen=CreatePen(PS_SOLID,segment.layer=="WIRES"?2:1,c);auto old=SelectObject(dc,pen);MoveToEx(dc,p.x,p.y,nullptr);LineTo(dc,q.x,q.y);SelectObject(dc,old);DeleteObject(pen);}
        for(const auto& item:art.labels){auto p=screen(item.point);text(dc,item.text,{p.x,p.y-14,p.x+250,p.y+3},RGB(31,50,69),state.smallFont);}
        for(const auto& p:art.pins){auto at=screen(p.point);auto brush=CreateSolidBrush(state.wireSymbol==p.symbol&&state.wirePin==p.pin?RGB(240,145,50):RGB(23,123,119));auto old=SelectObject(dc,brush);Ellipse(dc,at.x-3,at.y-3,at.x+4,at.y+4);SelectObject(dc,old);DeleteObject(brush);}
        if(auto* selected=symbol(state.selected)){auto p=screen({num(*selected,"x")-num(*selected,"width",20)/2-3,num(*selected,"y")-num(*selected,"height",12)/2-3});auto q=screen({num(*selected,"x")+num(*selected,"width",20)/2+3,num(*selected,"y")+num(*selected,"height",12)/2+3});RECT rect{p.x,p.y,q.x,q.y};auto brush=CreateSolidBrush(RGB(224,147,60));FrameRect(dc,&rect,brush);DeleteObject(brush);}
    }catch(const std::exception& e){state.error=e.what();}RestoreDC(dc,-1);
    fill(dc,{canvasRight,0,r.right,r.bottom},RGB(23,33,43));text(dc,"SHEET BOM",{canvasRight+18,18,r.right-12,46},RGB(125,220,217),state.title);
    int y=60;if(!state.name.empty())try{const auto info=inspectSchematic(g_doc,g_session.revision,state.name);text(dc,std::to_string(get(info,"bom").arr.size())+" components / "+std::to_string(get(info,"unconnected_pins").arr.size())+" unconnected pins",{canvasRight+18,y,r.right-12,y+28},RGB(171,190,204),state.smallFont);y+=40;for(const auto& row:get(info,"bom").arr){if(y>r.bottom-140){text(dc,"Export BOM for the complete list",{canvasRight+18,y,r.right-12,y+25},RGB(171,190,204),state.smallFont);break;}text(dc,str(row,"ref")+"  "+(str(row,"label").empty()?str(row,"part_number"):str(row,"label")),{canvasRight+18,y,r.right-12,y+24},RGB(230,235,239),state.font);text(dc,str(row,"part_number").empty()?"Part number undeclared":str(row,"part_number"),{canvasRight+18,y+24,r.right-12,y+44},RGB(153,174,189),state.smallFont);y+=54;}}catch(const std::exception& e){state.error=e.what();}
    text(dc,"Drag symbols / middle drag to pan\nWheel to zoom / F to fit\nWire: click the two pins\nCrossings do not connect nets\nElectrical qualification not performed",{canvasRight+18,r.bottom-130,r.right-12,r.bottom-30},RGB(153,174,189),state.smallFont,DT_LEFT|DT_WORDBREAK);
    fill(dc,{0,r.bottom-32,r.right,r.bottom},RGB(16,23,30));const auto status=!state.error.empty()?state.error:state.wireMode?(state.wireSymbol.empty()?"WIRE / choose the first pin":"WIRE / choose the destination pin"):"SELECT / drag a symbol or double-click for properties / revision "+std::to_string(g_session.revision);text(dc,status,{16,r.bottom-31,r.right-10,r.bottom-2},state.error.empty()?RGB(171,200,211):RGB(255,155,135),state.smallFont);
}
static LRESULT CALLBACK procedure(HWND w,UINT m,WPARAM wp,LPARAM lp){try{
    if(m==WM_CREATE){state.window=w;state.font=CreateFontW(-16,0,0,0,FW_NORMAL,FALSE,FALSE,FALSE,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");state.smallFont=CreateFontW(-13,0,0,0,FW_NORMAL,FALSE,FALSE,FALSE,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");state.title=CreateFontW(-19,0,0,0,FW_SEMIBOLD,FALSE,FALSE,FALSE,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");const wchar_t* labels[]={L"New",L"Symbol",L"Wire",L"Properties",L"Pins",L"Delete",L"DXF",L"BOM CSV",L"Fit",L"Undo",L"Redo"};for(int i=0;i<11;++i){HWND b=CreateWindowW(L"BUTTON",labels[i],WS_CHILD|WS_VISIBLE|BS_PUSHBUTTON,12+i*73,76,70,28,w,(HMENU)(INT_PTR)(i+1),GetModuleHandle(nullptr),nullptr);SendMessageW(b,WM_SETFONT,(WPARAM)state.smallFont,TRUE);}state.sheets=CreateWindowW(L"COMBOBOX",L"",WS_CHILD|WS_VISIBLE|CBS_DROPDOWNLIST|WS_VSCROLL,400,18,290,240,w,(HMENU)20,GetModuleHandle(nullptr),nullptr);SendMessageW(state.sheets,WM_SETFONT,(WPARAM)state.font,TRUE);SetTimer(w,1,250,nullptr);return 0;}
    if(m==WM_GETMINMAXINFO){auto* info=(MINMAXINFO*)lp;info->ptMinTrackSize={1150,640};return 0;}
    if(m==WM_TIMER){if(!state.busy)refresh();return 0;}if(m==WM_ERASEBKGND)return 1;
