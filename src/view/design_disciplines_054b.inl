    V sheet;std::string name,selected,selectedWire,error,wireSymbol,wirePin;u64 revision=~u64{},epoch=~u64{};
    double zoom=3,panX=28,panY=130;bool wireMode=false,dragging=false,panning=false,busy=false,moved=false;
