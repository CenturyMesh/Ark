static std::string componentPatternJoin(const arkjson::Value* values){std::string out;if(values&&values->t==arkjson::Value::Arr)for(const auto& item:values->arr){if(!out.empty())out+="; ";out+=item.t==arkjson::Value::Str?item.str:item.dump();}return out;}
