// Human radius-law authoring; the native contour producer remains authoritative.
static void variableFilletWorkflow074(const Feature* editing,u64 revision,u64 epoch,u64 base,const std::string& listed,int count,bool contour){
    using namespace extrusion_view_073b;using V=arkjson::Value;Context context(editing);context.revision=revision;context.epoch=epoch;context.current();
    if(count<2||count>16)throw std::runtime_error("A variable fillet needs 2 to 16 radius stations");if(!editing&&!g_doc.assembly.empty())throw std::runtime_error("Create the fillet in a part definition before assembly, or edit an existing fillet definition");
    const Body* source=nullptr;for(const auto& body:g_doc.evalBodies)if(body.id==base){source=&body;break;}if(!source||get(get(source->nativeData.metadata(),"report"),"solids").num!=1)throw std::runtime_error("Choose one current exact solid for the fillet");
