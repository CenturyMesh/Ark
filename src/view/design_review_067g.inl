// 067G revision comparison and explicitly reviewed feature correction.
namespace design_review_067 {
using V=arkjson::Value;
struct State {std::vector<float> before,after;u64 revision=~u64{},epoch=~u64{};bool active=false,dirty=false;HWND report=nullptr,edit=nullptr;std::string description;};
static State state;
static const V& field(const V& v,const char* key){static V nil;const auto* p=v.find(key);return p?*p:nil;}
static void appendMesh(std::vector<float>& out,const Mesh& mesh,const Mat4& world){
    if(out.size()+mesh.idx.size()*6>12000000)throw std::runtime_error("Revision overlay exceeds display capacity; narrow the review before displaying it");
    // Drop coplanar triangle diagonals in the display only. The exact producer
    // data and the revision comparison remain unchanged.
    struct Edge {u32 a=0,b=0;Vec3 normal;unsigned count=0;bool crease=false;};
    std::unordered_map<u64,Edge> edges;edges.reserve(mesh.idx.size());
    auto point=[&](u32 i){if((size_t)i*3+2>=mesh.pos.size())throw std::runtime_error("Invalid derived display mesh");return Vec3{mesh.pos[i*3],mesh.pos[i*3+1],mesh.pos[i*3+2]};};
    for(size_t t=0;t+2<mesh.idx.size();t+=3){const auto a=point(mesh.idx[t]),b=point(mesh.idx[t+1]),c=point(mesh.idx[t+2]);auto normal=(b-a).cross(c-a);const auto length=normal.len();if(length==0)continue;normal=normal*(1./length);for(int side=0;side<3;++side){const auto lo=std::min(mesh.idx[t+side],mesh.idx[t+(side+1)%3]),hi=std::max(mesh.idx[t+side],mesh.idx[t+(side+1)%3]);auto& edge=edges[((u64)lo<<32)|hi];if(!edge.count){edge.a=lo;edge.b=hi;edge.normal=normal;}else edge.crease|=edge.normal.dot(normal)<.999999;++edge.count;}}
    for(const auto& item:edges){const auto& edge=item.second;if(edge.count==2&&!edge.crease)continue;for(auto i:{edge.a,edge.b}){const auto p=world.transformPoint(point(i));out.insert(out.end(),{(float)p.x,(float)p.y,(float)p.z});}}
}
static std::vector<float> lines(const Document& doc,const std::set<u64>& ids){std::vector<float> out;std::vector<AssemblyPlacement> placements;std::string error;if(doc.assembly.empty()){const auto consumed=consumedFeatureInputs(doc);for(const auto& b:doc.evalBodies)if(ids.count(b.id)&&!consumed.count(b.id))placements.push_back({0,b.id,"",Mat4::identity(),true});}else if(!resolveAssembly(doc,placements,error))throw std::runtime_error(error);for(const auto& p:placements)if(p.visible&&ids.count(p.feature))for(const auto& b:doc.evalBodies)if(b.id==p.feature)appendMesh(out,b.tessellate(doc.tessOpt),p.world);return out;}
static void overlay(const Document& before,const Document& after,const std::set<u64>& ids){auto a=lines(before,ids),b=lines(after,ids);state.before=std::move(a);state.after=std::move(b);state.revision=g_session.revision;state.epoch=g_documentEpoch;state.active=state.dirty=true;}
static LRESULT CALLBACK procedure(HWND w,UINT msg,WPARAM wp,LPARAM lp){
    if(msg==WM_CREATE){state.edit=CreateWindowExW(WS_EX_CLIENTEDGE,L"EDIT",L"",WS_CHILD|WS_VISIBLE|WS_VSCROLL|WS_HSCROLL|ES_MULTILINE|ES_READONLY|ES_AUTOVSCROLL|ES_AUTOHSCROLL,12,12,750,480,w,(HMENU)1,GetModuleHandle(nullptr),nullptr);SendMessage(state.edit,WM_SETFONT,(WPARAM)GetStockObject(DEFAULT_GUI_FONT),TRUE);return 0;}
    if(msg==WM_SIZE){RECT r{};GetClientRect(w,&r);MoveWindow(state.edit,12,12,std::max(50L,r.right-24),std::max(40L,r.bottom-24),TRUE);return 0;}
    if(msg==WM_CLOSE){DestroyWindow(w);return 0;}if(msg==WM_DESTROY){state.report=state.edit=nullptr;return 0;}return DefWindowProcW(w,msg,wp,lp);
}
static void report(const std::string& text){state.description=text;if(!state.report){WNDCLASSW wc{};wc.lpfnWndProc=procedure;wc.hInstance=GetModuleHandle(nullptr);wc.hCursor=LoadCursor(nullptr,IDC_ARROW);wc.hbrBackground=(HBRUSH)(COLOR_WINDOW+1);wc.lpszClassName=L"ARKDesignReview067G";RegisterClassW(&wc);state.report=CreateWindowExW(WS_EX_APPWINDOW,wc.lpszClassName,L"ARK / Revision review",WS_OVERLAPPEDWINDOW,100,100,850,580,g_window,nullptr,wc.hInstance,nullptr);}SetWindowTextW(state.edit,bomWide(text).c_str());ShowWindow(state.report,SW_SHOW);UpdateWindow(state.report);}
static std::string summary(const V& diff){
    std::ostringstream out;
    out<<"REVISION COMPARISON\r\nBefore: "<<field(diff,"before_id").asStr()<<"\r\nAfter: "<<field(diff,"after_id").asStr()<<"\r\n\r\nOrange = before / cyan = after. Overlay is display only.\r\n"<<field(diff,"added").num<<" added, "<<field(diff,"removed").num<<" removed, "<<field(diff,"changed").num<<" changed.\r\n\r\n";
    for(const auto& row:field(diff,"features").arr)if(field(row,"status").asStr()!="unchanged"){
        out<<field(row,"status").asStr()<<"  #"<<field(row,"id").num<<"  "<<field(row,"name").asStr()<<"\r\n";
        for(const auto& change:field(row,"parameter_changes").arr)out<<"    "<<field(change,"field").asStr()<<": "<<field(change,"before").dump()<<" -> "<<field(change,"after").dump()<<"\r\n";
        for(const auto& change:field(row,"geometry_metrics_changes").arr){const auto key=field(change,"field").asStr();if(key=="volume_mm3"||key=="bounds_mm")out<<"    "<<(key=="volume_mm3"?"Native volume (mm3)":"Native bounds (mm)")<<": "<<field(change,"before").dump()<<" -> "<<field(change,"after").dump()<<"\r\n";}
        for(const auto& change:field(row,"changes").arr)if(field(change,"field").asStr()!="parameters")out<<"    "<<field(change,"field").asStr()<<": "<<field(change,"before").dump()<<" -> "<<field(change,"after").dump()<<"\r\n";
        if(!field(row,"occurrence_changes").arr.empty())out<<"    Occurrence placement or visibility changed.\r\n";
    }
    out<<"\r\nNAMED DIMENSIONS\r\n";
    for(const auto& row:field(diff,"parameter_changes").arr)out<<field(row,"field").asStr()<<": "<<field(row,"before").dump()<<" -> "<<field(row,"after").dump()<<"\r\n";
    out<<"\r\nBOM CHANGES\r\n";
    for(const auto& change:field(diff,"bom_changes").arr){const auto& a=field(change,"before");const auto& b=field(change,"after");const auto name=b.find("name")?field(b,"name").asStr():field(a,"name").asStr();out<<"#"<<field(change,"field").asStr()<<"  "<<name;if(field(a,"quantity").num!=field(b,"quantity").num)out<<"  quantity "<<field(a,"quantity").num<<" -> "<<field(b,"quantity").num;else out<<"  quantity "<<field(b,"quantity").num<<" unchanged; source or part data changed";out<<"\r\n";if(field(a,"metadata").dump()!=field(b,"metadata").dump())out<<"    metadata: "<<field(a,"metadata").dump()<<" -> "<<field(b,"metadata").dump()<<"\r\n";}
    return out.str();
}
static void compare(const std::string& id){const auto revision=g_session.revision,epoch=g_documentEpoch;V args=V::makeObj();args.set("action",V::makeStr("compare"));args.set("before_id",V::makeStr(id));args.set("expected_revision",V::makeNum((double)revision));auto response=runTool("design_review",args);if(g_error)return;const auto diff=field(response,"structuredContent");if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Document changed during revision comparison");std::set<u64> ids;for(const auto& row:field(diff,"features").arr)if(field(row,"status").asStr()!="unchanged")ids.insert((u64)field(row,"id").num);auto source=std::make_shared<Document>(g_doc);auto work=std::async(std::launch::async,[source,id]{auto before=std::make_unique<Document>();iterationRestore(*source,id,*before);before->recompute();return before;});while(work.wait_for(std::chrono::milliseconds(10))!=std::future_status::ready){MSG message{};for(int drained=0;drained<32&&PeekMessage(&message,nullptr,0,0,PM_REMOVE);++drained){if(message.message==WM_QUIT){PostQuitMessage((int)message.wParam);break;}TranslateMessage(&message);DispatchMessage(&message);}}auto before=work.get();if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Document changed while preparing overlay; compare again");overlay(*before,g_doc,ids);report(summary(diff));g_status="Revision overlay / orange before / cyan after / Hide review overlay closes it";}
static void compareDialog(){const auto history=iterationInfo(g_doc);const auto baseline=field(history,"baseline_id").asStr();if(baseline.empty())throw std::runtime_error("Make a saved authoring edit first; this document has no retained revisions");std::vector<std::string> choices;std::vector<std::string> ids;for(const auto& n:field(history,"nodes").arr){ids.push_back(field(n,"id").asStr());choices.push_back(field(n,"id").asStr().substr(0,12)+" / "+field(n,"tool").asStr());}ids.push_back(baseline);choices.push_back(baseline.substr(0,12)+" / initial state");std::vector<EditorField> fields{{"Before revision",choices.size()>1?choices[1]:choices[0],false,choices}};if(!editFields("Compare retained revision","Compare to the current design. No restore or document edit is performed.",fields))return;auto found=std::find(choices.begin(),choices.end(),fields[0].value);if(found==choices.end())throw std::runtime_error("Choose a retained revision");compare(ids[(size_t)(found-choices.begin())]);}
static void repairDialog(){const auto revision=g_session.revision,epoch=g_documentEpoch;V request=V::makeObj();request.set("action",V::makeStr("diagnose"));request.set("expected_revision",V::makeNum((double)revision));auto response=runTool("design_review",request);if(g_error)return;V diagnostics=field(response,"structuredContent");const auto failures=field(diagnostics,"failures");if(failures.arr.empty()){g_status="No failed feature or retained single-feature edit at this revision / use Failure report for other rejected operations";return;}std::vector<std::string> choices;for(const auto& row:failures.arr)choices.push_back("#"+std::to_string((u64)field(row,"id").num)+" / "+field(row,"name").asStr()+(row.find("failure_id")?" / rejected "+field(row,"failure_id").asStr().substr(0,8):""));std::vector<EditorField> choose{{"Failed feature",choices.front(),false,choices}};if(!editFields("Repair failed feature","Choose the failed operation to inspect its error, dimensions and dependencies.",choose))return;auto it=std::find(choices.begin(),choices.end(),choose[0].value);if(it==choices.end())throw std::runtime_error("Choose a failed feature");const auto row=failures.arr[(size_t)(it-choices.begin())];std::vector<EditorField> fields;fields.push_back({"Error",field(row,"error").asStr()});std::vector<std::string> names;for(const auto& kv:field(row,"parameters").obj){names.push_back(kv.first);fields.push_back({"Dimension / "+kv.first,kv.second.asStr()});}const auto inputIndex=fields.size();fields.push_back({"Earlier dependency IDs (JSON)",field(row,"inputs").dump()});const auto nativeIndex=fields.size();fields.push_back({"Native reference recipe (JSON)",field(row,"native").dump()});fields.push_back({"Available earlier dependencies",field(row,"earlier_dependencies").dump()});if(!editFields("Repair / explicit correction","Correct only the intended expressions or references. Preview validates the full design; Apply follows a separate review.",fields))return;if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Document changed; inspect the failure again");V command=row.find("attempted_command")?field(row,"attempted_command"):V::makeObj(),p=field(command,"p");if(p.t!=V::Obj)p=V::makeObj();command.set("op",V::makeStr("feature.edit"));command.set("id",field(row,"id"));for(size_t i=0;i<names.size();++i)if(fields[i+1].value!=field(field(row,"parameters"),names[i].c_str()).asStr())p.set(names[i],V::makeStr(fields[i+1].value));if(!p.obj.empty())command.set("p",p);for(const auto& spec:std::vector<std::pair<size_t,const char*>>{{inputIndex,"inputs"},{nativeIndex,"native"}})if(fields[spec.first].value!=field(row,spec.second).dump()){V value;if(!arkjson::parse(fields[spec.first].value,value))throw std::runtime_error("Correction JSON is invalid");command.set(spec.second,value);}V args=V::makeObj();args.set("action",V::makeStr("prepare_repair"));args.set("expected_revision",V::makeNum((double)revision));args.set("source_sha256",field(diagnostics,"source_sha256"));args.set("id",field(row,"id"));args.set("command",command);if(row.find("failure_id"))args.set("failure_id",field(row,"failure_id"));auto prepared=runTool("design_review",args);if(g_error)return;const auto candidate=field(prepared,"structuredContent");const auto candidateId=field(candidate,"candidate_id").asStr();if(candidateId.empty())throw std::runtime_error("Repair preview returned no reviewed candidate");auto transfer=g_session.takePreparedCandidate(candidateId);if(!transfer)throw std::runtime_error("Repair preview expired");std::set<u64> ids{(u64)field(row,"id").num};for(const auto& id:field(row,"dependents").arr)ids.insert((u64)id.num);overlay(g_doc,transfer->document(),ids);g_session.adoptPreparedCandidate(std::move(*transfer),revision);std::vector<EditorField> review{{"Checked correction",containerReviewText(candidate)}};if(!editFields("Review feature repair","The exact candidate has been checked. Orange is the old display, cyan is the corrected candidate.",review,true,"Apply",nullptr,true))return;if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Repair preview became stale; inspect again");V apply=V::makeObj();apply.set("candidate_id",V::makeStr(candidateId));apply.set("expected_revision",V::makeNum((double)revision));runTool("doc_apply",apply);state.active=false;if(!g_error)g_status="Reviewed repair applied / editable sources and dependents retained";}
}
static bool designReviewAction067(int id){if(id<49940||id>49942)return false;if(id==49940)design_review_067::compareDialog();else if(id==49941)design_review_067::repairDialog();else{design_review_067::state.active=false;g_status="Revision overlay hidden";}return true;}
static void drawDesignReview067(){using namespace design_review_067;if(!state.active)return;if(state.revision!=g_session.revision||state.epoch!=g_documentEpoch){state.active=false;return;}static GLuint vao[2]{},vbo[2]{};static GLsizei count[2]{};if(!vao[0]){glGenVertexArrays(2,vao);glGenBuffers(2,vbo);for(int i=0;i<2;++i){glBindVertexArray(vao[i]);glBindBuffer(GL_ARRAY_BUFFER,vbo[i]);glEnableVertexAttribArray(0);glVertexAttribPointer(0,3,GL_FLOAT,GL_FALSE,12,nullptr);}}if(state.dirty){const std::vector<float>* lines[]{&state.before,&state.after};for(int i=0;i<2;++i){glBindBuffer(GL_ARRAY_BUFFER,vbo[i]);glBufferData(GL_ARRAY_BUFFER,(GLsizeiptr)(lines[i]->size()*sizeof(float)),lines[i]->data(),GL_STATIC_DRAW);count[i]=(GLsizei)lines[i]->size()/3;}state.dirty=false;}glViewport(viewX,winH-viewY-viewH,viewW,viewH);glDisable(GL_DEPTH_TEST);glEnable(GL_BLEND);glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);glUseProgram(pSketch);const auto m=cameraProjection()*cameraView();float vp[16];for(int i=0;i<16;++i)vp[i]=(float)m.m[i];glUniformMatrix4fv(glGetUniformLocation(pSketch,"vp"),1,GL_FALSE,vp);for(int i=0;i<2;++i){glBindVertexArray(vao[i]);if(i==0)glUniform4f(glGetUniformLocation(pSketch,"tint"),1,.47f,.13f,.5f);else glUniform4f(glGetUniformLocation(pSketch,"tint"),.1f,.85f,.92f,.65f);glDrawArrays(GL_LINES,0,count[i]);}glViewport(0,0,winW,winH);}
