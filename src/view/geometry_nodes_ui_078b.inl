static bool geometrySetMode078(bool enabled){
 if(state.geometry==enabled)return false;
 // SetWindowText/ShowWindow and capture release may synchronously paint. Clear
 // the previous view's schema before exposing the new paint/message handlers.
 // A blocked refresh remains an explicitly empty pending view, never old Map
