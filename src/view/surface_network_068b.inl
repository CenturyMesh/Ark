using V=arkjson::Value;
static const V& field(const V& v,const char* key){static const V nil;const auto* p=v.find(key);return p?*p:nil;}
static u64 curveId(const std::string& supplied){
    const auto text=trimField(supplied);const Feature* match=nullptr;unsigned count=0;for(const auto& feature:g_doc.features)if(feature.name==text){match=&feature;++count;}
    if(count>1)throw std::runtime_error("Curve name is ambiguous: "+text);
    if(match){if(!isCurveFeature(match->type))throw std::runtime_error("Choose an exact curve feature: "+text);if(!text.empty()&&std::all_of(text.begin(),text.end(),[](unsigned char c){return c>='0'&&c<='9';})){bool ok=false;const double numeric=evalExpr(text,g_doc.buildEnv(),&ok);if(ok&&std::isfinite(numeric)&&numeric>=1&&numeric<=9007199254740990.&&numeric==std::floor(numeric)&&g_doc.find((u64)numeric)&&(u64)numeric!=match->id)throw std::runtime_error("Numeric curve name conflicts with another feature ID");}return match->id;}
    const auto id=featureIdField(text);const auto* feature=g_doc.find(id);if(!feature||!isCurveFeature(feature->type))throw std::runtime_error("Choose an existing exact curve ID");return id;
}
static std::vector<std::string> names(const std::string& text){std::vector<std::string> result;std::istringstream in(text);std::string word;while(std::getline(in,word,';'))if(!(word=trimField(word)).empty())result.push_back(word);return result;}
static V list(const std::vector<std::string>& values){V a=V::makeArr();for(const auto& value:values)a.arr.push_back(V::makeStr(value));return a;}
static V stationList(const std::string& text){V a=V::makeArr();std::istringstream in(text);std::string word;while(std::getline(in,word,','))a.arr.push_back(V::makeNum(formNumber(trimField(word))));return a;}
static std::string diagnosticsText(const V& data){std::ostringstream text;text<<"Section correspondence (native arc-length samples)\r\n";for(const auto& row:field(data,"sections").arr){text<<"Section "<<field(row,"index").num+1<<": ";if(field(row,"point_tip").b)text<<"point tip";else text<<field(row,"edge_count").num<<" edges, "<<(field(row,"closed").b?"closed":"open");text<<"\r\n";}for(const auto& pair:field(data,"pairs").arr){text<<"\r\n"<<field(pair,"from").num+1<<" -> "<<field(pair,"to").num+1<<": ";if(!field(pair,"same_topology").b)text<<"topology differs; compatible remapping needs review. ";if(pair.find("correspondence_rms_mm"))text<<"Corresponding distance "<<field(pair,"correspondence_rms_mm").num<<" mm RMS; reversed "<<field(pair,"reversed_rms_mm").num<<" mm RMS.";if(field(pair,"review_reversal").b)text<<" Review the direction of the next section.";}text<<"\r\n\r\nNo direction or seam was changed automatically. These are diagnostics, not proof of a twist-free result; the final loft and guides still undergo native validation.";return text.str();}
static V diagnose(V args){args.set("action",V::makeStr("loft_diagnose"));args.set("expected_revision",V::makeNum((double)g_session.revision));const auto response=runTool("surface_control",args);if(g_error)throw std::runtime_error(g_status);return field(response,"structuredContent");}
static void diagnostics(){const auto* selected=selectedPartFeature();if(!selected||selected->type!=FeatureType::Loft)throw std::runtime_error("Select a loft to inspect its section correspondence");V args=V::makeObj();args.set("id",V::makeNum((double)selected->id));const auto data=diagnose(args);std::vector<EditorField> report{{"Measured correspondence",diagnosticsText(data)}};editFields("Loft correspondence","Native section diagnostics; inspect direction, seam and topology before editing.",report,true,"Close",nullptr,true);}
static bool reviewCandidate(const V& preview,const char* title,u64 revision,u64 epoch){
    if(!field(preview,"valid").b||!field(preview,"candidate_cached").b)throw std::runtime_error("Exact candidate did not validate");
    auto folder=std::filesystem::temp_directory_path()/"ARK"/"previews";std::filesystem::create_directories(folder);const auto file=folder/(field(preview,"candidate_id").str+"-surface.png");V capture=V::makeObj();capture.set("candidate_id",field(preview,"candidate_id"));capture.set("expected_revision",V::makeNum((double)revision));const auto& created=field(field(preview,"candidate_result"),"created_ids");V target;if(created.t==V::Arr&&created.arr.size()==1)target=created.arr.front();else for(const auto& command:field(field(preview,"recipe"),"commands").arr)if(field(command,"op").asStr()=="feature.edit"){if(!target.isNull())throw std::runtime_error("Preview needs one explicit surface target");target=field(command,"id");}if(target.isNull())throw std::runtime_error("Checked candidate has no explicit surface target");capture.set("id",target);capture.set("view",V::makeStr("iso"));capture.set("path",V::makeStr(file.string()));runTool("snapshot",capture);if(g_error)throw std::runtime_error(g_status);HBITMAP bitmap=candidateReviewBitmap(file.string());std::error_code ignored;std::filesystem::remove(file,ignored);if(!bitmap)throw std::runtime_error("Could not display the exact candidate");
    const auto& evidence=field(preview,"network_evidence");std::ostringstream summary;summary<<"Input frame: shared definition coordinates.\r\n";if(evidence.t==V::Obj)summary<<"Curves: "<<field(evidence,"u_curves").num<<" x "<<field(evidence,"v_curves").num<<"\r\nDegree: "<<field(evidence,"u_degree").num<<" x "<<field(evidence,"v_degree").num<<"\r\nMaximum checked curve error: "<<field(evidence,"curve_observed_max_error_mm").num<<" mm\r\nCrossing gap: "<<field(evidence,"crossing_max_gap_mm").num<<" mm";else summary<<"Native geometry validated. Source features remain editable.";
    const std::string previousShot=g_dialogShot;if(!previousShot.empty())g_dialogShot=previousShot+".candidate.png";std::vector<EditorField> fields{{"Checked candidate",summary.str()}};const bool accepted=editFields(title,"Preview only. Apply saves this exact checked candidate; Cancel preserves the current design.",fields,true,"Apply",bitmap,true);DeleteObject(bitmap);g_dialogShot=previousShot;if(!accepted)return false;if(g_session.revision!=revision||g_documentEpoch!=epoch)throw std::runtime_error("Document changed during preview; prepare again");V apply=V::makeObj();apply.set("expected_revision",V::makeNum((double)revision));apply.set("candidate_id",field(preview,"candidate_id"));runTool("doc_apply",apply);if(g_error)throw std::runtime_error(g_status);if(target.t==V::Num){const auto resultId=(u64)target.num;if(selBody<0||(size_t)selBody>=g_bodyIds.size()||g_bodyIds[(size_t)selBody]!=resultId){const auto found=std::find(g_bodyIds.begin(),g_bodyIds.end(),resultId);selBody=found==g_bodyIds.end()?-1:(int)(found-g_bodyIds.begin());}}g_picked.clear();refreshSelectionLines();frameScene();return true;
}
static void network(){
    const auto revision=g_session.revision,epoch=g_documentEpoch;const auto requestedShot=g_dialogShot;std::vector<EditorField> fields{{"Result name","Curve network"},pickField("U curves / ordered ; list","",7),pickField("V curves / ordered ; list","",7),{"U stations (optional)",""},{"V stations (optional)",""},{"Reverse U names",""},{"Reverse V names",""}};
    if(!editFields("Surface from curve network","Use 2..9 open polynomial curves per family. Lists follow crossing order; blank stations mean evenly spaced 0..1. No curve is fitted or discarded.",fields,false,"Preview"))return;
    if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Document changed while selecting curves");const auto u=names(fields[1].value),v=names(fields[2].value);V args=V::makeObj();args.set("action",V::makeStr("network_plan"));args.set("expected_revision",V::makeNum((double)revision));args.set("name",V::makeStr(trimField(fields[0].value)));auto ids=[&](const std::vector<std::string>& selected){V result=V::makeArr();for(const auto& name:selected)result.arr.push_back(V::makeNum((double)curveId(name)));return result;};args.set("u_curves",ids(u));args.set("v_curves",ids(v));if(!trimField(fields[3].value).empty())args.set("u_stations",stationList(fields[3].value));if(!trimField(fields[4].value).empty())args.set("v_stations",stationList(fields[4].value));
    for(int family=0;family<2;++family){const auto& selected=family?v:u;const auto reversals=names(fields[5+family].value);std::set<u64> reversed;for(const auto& name:reversals)reversed.insert(curveId(name));V flags=V::makeArr();for(const auto& name:selected)flags.arr.push_back(V::makeBool(reversed.erase(curveId(name))!=0));if(!reversed.empty())throw std::runtime_error("Reversed curves must belong to the selected family");args.set(family?"v_reverse":"u_reverse",flags);}
    const auto response=runTool("surface_control",args);if(g_error)return;if(!requestedShot.empty())g_dialogShot=requestedShot;if(reviewCandidate(field(response,"structuredContent"),"Curve network / exact preview",revision,epoch))g_status="Exact curve network saved / original curves remain editable";
}
