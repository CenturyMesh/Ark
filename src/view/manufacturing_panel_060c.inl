static void advanceManufacturing060(double dt){using namespace manufacturing_view060;auto& s=g_manufacturing060;bool refreshNeeded=false;if(s.worker.valid()&&s.worker.wait_for(std::chrono::milliseconds(0))==std::future_status::ready){try{auto result=s.worker.get();if(s.revision!=g_session.revision||s.epoch!=g_objectDocumentEpoch)throw std::runtime_error("Drawing changed during simulation; run again.");s.study=std::move(result);s.active=true;s.frame=0;s.elapsed=0;s.message=get(s.study.receipt,"blocked").b?"Simulation contains blockers; inspect Evidence.":"Derived simulation ready. Play shows toolpath and voxel stock samples.";}catch(const std::exception& e){s.message=e.what();}refreshNeeded=true;}
