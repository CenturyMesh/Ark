// 067G native configurator. Preview triangles are display-only; comparisons use
// exact B-rep metrics returned by the same tool used by agents.
namespace design_variants_view_067g {
using V=arkjson::Value;
struct State {HWND window=nullptr,program=nullptr,parameters=nullptr,variants=nullptr,name=nullptr,results=nullptr,status=nullptr;HFONT font=nullptr;std::string ns;V values,report;u64 revision=0,epoch=0;bool busy=false;std::vector<std::string> parameterNames,savedNames,programNames;int selectedResult=0;};
static State state;
static const V& field(const V& v,const char* key){static V none;const auto* p=v.find(key);return p?*p:none;}
static std::wstring wide(const std::string& s){return bomWide(s);}
static std::string windowText(HWND w){int n=GetWindowTextLengthW(w);std::wstring value(n+1,L'\0');GetWindowTextW(w,value.data(),n+1);value.resize(n);if(value.empty())return {};int bytes=WideCharToMultiByte(CP_UTF8,0,value.data(),n,nullptr,0,nullptr,nullptr);std::string out(bytes,'\0');WideCharToMultiByte(CP_UTF8,0,value.data(),n,out.data(),bytes,nullptr,nullptr);return out;}
static void message(const std::string& s){SetWindowTextW(state.status,wide(s).c_str());g_status=s;}
static void add(HWND list,const std::string& s,bool combo=false){SendMessageW(list,combo?CB_ADDSTRING:LB_ADDSTRING,0,(LPARAM)wide(s).c_str());}
static const V* program(){for(const auto& p:g_doc.parametricPrograms.arr)if(field(p,"namespace").str==state.ns)return &p;return nullptr;}
static void fillParameters(){SendMessageW(state.parameters,LB_RESETCONTENT,0,0);state.parameterNames.clear();const auto* p=program();if(!p)return;for(const auto& parameter:field(field(*p,"program"),"parameters").obj){state.parameterNames.push_back(parameter.first);const auto& spec=parameter.second;std::string label=parameter.first+" = "+field(state.values,parameter.first.c_str()).dump()+" "+field(spec,"unit").asStr();if(spec.find("min")||spec.find("max"))label+="   ["+(spec.find("min")?field(spec,"min").dump():"-")+" .. "+(spec.find("max")?field(spec,"max").dump():"-")+"]";add(state.parameters,label);}if(!state.parameterNames.empty())SendMessageW(state.parameters,LB_SETCURSEL,0,0);}
static void fillSaved(){SendMessageW(state.variants,LB_RESETCONTENT,0,0);state.savedNames.clear();for(const auto& v:g_doc.designVariants.arr)if(field(v,"namespace").str==state.ns){state.savedNames.push_back(field(v,"name").str);const auto* p=program();add(state.variants,field(v,"name").str+(p&&field(v,"program_sha256").str==field(*p,"program_sha256").str?"":" [source changed]"));}}
static void refresh(){state.revision=g_session.revision;state.epoch=g_documentEpoch;state.report={};state.selectedResult=0;SendMessageW(state.results,LB_RESETCONTENT,0,0);SendMessageW(state.program,CB_RESETCONTENT,0,0);state.programNames.clear();int selected=0;for(const auto& p:g_doc.parametricPrograms.arr){if(field(p,"namespace").str==state.ns)selected=(int)state.programNames.size();state.programNames.push_back(field(p,"namespace").str);add(state.program,field(p,"namespace").str+" / "+field(p,"name").str,true);}for(const auto& v:g_doc.designVariants.arr){const auto ns=field(v,"namespace").str;if(std::find(state.programNames.begin(),state.programNames.end(),ns)==state.programNames.end()){if(ns==state.ns)selected=(int)state.programNames.size();state.programNames.push_back(ns);add(state.program,ns+" / program removed",true);}}if(!state.programNames.empty()){SendMessageW(state.program,CB_SETCURSEL,selected,0);state.ns=state.programNames[selected];state.values=program()?field(*program(),"values"):V::makeObj();}else{state.ns.clear();state.values=V::makeObj();}fillParameters();fillSaved();message(state.ns.empty()?"Install a starter program to create an editable family.":"Edit parameters, preview, save named configurations, then compare or explore.");InvalidateRect(state.window,nullptr,TRUE);}
static V tool(V a){a.set("namespace",V::makeStr(state.ns));a.set("expected_revision",V::makeNum(double(state.revision)));auto r=runTool("design_variants",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());return field(r,"structuredContent");}
static V args(const char* action){V a=V::makeObj();a.set("action",V::makeStr(action));return a;}
static void commit(const V& preview){V a=V::makeObj();a.set("expected_revision",V::makeNum(double(state.revision)));a.set("candidate_id",field(preview,"candidate_id"));const auto r=runTool("doc_apply",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());refresh();}
static void showReport(V report){state.report=std::move(report);state.selectedResult=0;SendMessageW(state.results,LB_RESETCONTENT,0,0);for(const auto& row:field(state.report,"results").arr){const auto& m=field(row,"metrics");std::string label=field(row,"name").str+" | ";if(!field(row,"valid").b)label+="FAILED: "+field(row,"error").str;else{label+=field(m,"width_mm").dump()+" x "+field(m,"depth_mm").dump()+" x "+field(m,"height_mm").dump()+" mm | "+field(m,"volume_mm3").dump()+" mm3 | ";label+=field(m,"mass_available").b?field(m,"mass_kg").dump()+" kg":"mass: assign density";if(!field(row,"feasible").b)label+=" | outside constraints";}add(state.results,label);}if(!field(state.report,"ranked_indices").arr.empty())state.selectedResult=(int)field(state.report,"ranked_indices").arr[0].num;SendMessageW(state.results,LB_SETCURSEL,state.selectedResult,0);message(std::to_string((int)field(state.report,"attempted").num)+" evaluated / "+std::to_string((int)field(state.report,"failed").num)+" failed. Exact metrics; sampled thumbnails are display only.");InvalidateRect(state.window,nullptr,TRUE);}
static void editParameter(){int i=(int)SendMessageW(state.parameters,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.parameterNames.size())return;const auto name=state.parameterNames[i];std::string value=field(state.values,name.c_str()).dump();if(!editText(("Parameter: "+name).c_str(),value))return;bool ok=false;double parsed=evalExpr(trimField(value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(parsed))throw std::runtime_error("Enter a finite numeric value");state.values.set(name,V::makeNum(parsed));fillParameters();SendMessageW(state.parameters,LB_SETCURSEL,i,0);message("Value staged; Preview validates the program and exact geometry before Apply.");}
static void loadSaved(){if(!program())throw std::runtime_error("The program was removed. This saved configuration can be inspected or deleted, but cannot be applied.");int i=(int)SendMessageW(state.variants,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.savedNames.size())return;for(const auto& v:g_doc.designVariants.arr)if(field(v,"namespace").str==state.ns&&field(v,"name").str==state.savedNames[i]){if(field(v,"program_sha256").str!=field(*program(),"program_sha256").str)throw std::runtime_error("Program source changed. Review each parameter before creating a new configuration.");state.values=field(v,"values");SetWindowTextW(state.name,wide(state.savedNames[i]).c_str());fillParameters();message("Saved values staged. Preview checks geometry; Apply publishes the selected configuration.");break;}}
static void starter(){const V examples=parametricProgramExamples();std::vector<EditorField> fields{{"Example",field(examples.arr.front(),"id").str},{"Namespace","family"}};for(const auto& example:examples.arr)fields[0].choices.push_back(field(example,"id").str);if(!editFields("New parametric family","Installs an editable example with exact native features. Existing designs are preserved.",fields))return;const auto ns=trimField(fields[1].value);V a=V::makeObj();a.set("action",V::makeStr("prepare"));a.set("mode",V::makeStr("install"));a.set("namespace",V::makeStr(ns));a.set("expected_revision",V::makeNum(double(state.revision)));for(const auto& example:examples.arr)if(field(example,"id").str==fields[0].value)a.set("program",field(example,"program"));const auto r=runTool("parametric_program",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());commit(field(r,"structuredContent"));state.ns=ns;refresh();}
static void explore(){const auto* p=program();if(!p)throw std::runtime_error("Install a program first");std::vector<EditorField> fields{{"Parameter",state.parameterNames.empty()?"":state.parameterNames.front()},{"Trial values (comma separated)",""},{"Minimize","volume_mm3"},{"Maximum width mm (optional)",""},{"Maximum depth mm (optional)",""},{"Maximum height mm (optional)",""},{"Maximum mass kg (optional)",""},{"Clearance feature A (optional)",""},{"Clearance feature B (optional)",""},{"Minimum pair gap mm (optional)",""}};fields[0].choices=state.parameterNames;fields[2].choices={"volume_mm3","mass_kg","width_mm","depth_mm","height_mm"};if(!state.parameterNames.empty()){const auto& spec=field(field(*p,"program"),"parameters").obj.front().second;const auto& value=field(state.values,state.parameterNames.front().c_str());fields[1].value=(spec.find("min")?field(spec,"min").dump():value.dump())+", "+value.dump()+", "+(spec.find("max")?field(spec,"max").dump():value.dump());}if(!editFields("Explore parameter alternatives","Every explicit value is evaluated with the exact kernel. Program assertions and entered limits govern feasibility. Failed trials remain visible. No structural or manufacturing claim.",fields))return;V a=args("explore"),axes=V::makeObj(),values=V::makeArr(),constraints=V::makeObj();std::istringstream in(fields[1].value);std::string word;while(std::getline(in,word,',')){bool ok=false;const double number=evalExpr(trimField(word),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(number))throw std::runtime_error("Trial values must be finite numbers");values.arr.push_back(V::makeNum(number));}axes.set(fields[0].value,values);const char* keys[]={"width_mm","depth_mm","height_mm","mass_kg"};for(int i=0;i<4;++i)if(!trimField(fields[i+3].value).empty()){bool ok=false;const auto value=evalExpr(trimField(fields[i+3].value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(value))throw std::runtime_error("Limits must be finite numbers");V range=V::makeObj();range.set("max",V::makeNum(value));constraints.set(keys[i],range);}if(!trimField(fields[7].value).empty()||!trimField(fields[8].value).empty()||!trimField(fields[9].value).empty()){bool ok=false;const double gap=evalExpr(trimField(fields[9].value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(gap)||gap<0||trimField(fields[7].value).empty()||trimField(fields[8].value).empty())throw std::runtime_error("Enter both program feature names and a nonnegative minimum gap");V pairs=V::makeArr(),pair=V::makeObj();pair.set("a",V::makeStr(trimField(fields[7].value)));pair.set("b",V::makeStr(trimField(fields[8].value)));pair.set("min_mm",V::makeNum(gap));pairs.arr.push_back(pair);a.set("clearance_pairs",pairs);}a.set("values",state.values);a.set("axes",axes);a.set("constraints",constraints);a.set("objective",V::makeStr(fields[2].value));a.set("thumbnails",V::makeBool(true));showReport(tool(a));}
static void action(int id){if(state.busy)return;state.busy=true;g_error=false;try{if(id!=1&&state.epoch!=g_documentEpoch)throw std::runtime_error("Document changed. Refresh before editing.");if(id!=1&&state.revision!=g_session.revision)throw std::runtime_error("Model revision changed. Refresh and review values before continuing.");if(id==1)refresh();else if(id==2)starter();else if(id==3)editParameter();else if(id==4){V a=args("evaluate");a.set("name",V::makeStr("Staged"));a.set("values",state.values);a.set("thumbnails",V::makeBool(true));showReport(tool(a));}else if(id==5){V a=args("prepare");a.set("values",state.values);commit(tool(a));message("Configuration applied. Undo restores the previous editable source.");}else if(id==6){V a=args("save");a.set("name",V::makeStr(trimField(windowText(state.name))));a.set("values",state.values);const V staged=state.values;commit(tool(a));state.values=staged;fillParameters();message("Named configuration saved in the document; Save the .ark to retain it on disk.");}else if(id==7)loadSaved();else if(id==8){int i=(int)SendMessageW(state.variants,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.savedNames.size())throw std::runtime_error("Select a saved variant");V a=args("remove");a.set("name",V::makeStr(state.savedNames[i]));const V staged=state.values;commit(tool(a));state.values=staged;fillParameters();}else if(id==9){V a=args("evaluate");a.set("thumbnails",V::makeBool(true));showReport(tool(a));}else if(id==10)explore();else if(id==11){int i=(int)SendMessageW(state.results,LB_GETCURSEL,0,0);const auto& rows=field(state.report,"results").arr;if(i<0||i>=(int)rows.size()||!field(rows[i],"valid").b)throw std::runtime_error("Select a valid evaluated result");state.values=field(rows[i],"values");SetWindowTextW(state.name,wide(field(rows[i],"name").str).c_str());fillParameters();message("Result values staged. Save a named variant or Apply to the model.");}}catch(const std::exception& e){g_error=true;message(e.what());}state.busy=false;InvalidateRect(state.window,nullptr,TRUE);}
static void text(HDC dc,RECT r,const std::string& s,COLORREF color=RGB(225,228,232)){SetTextColor(dc,color);SetBkMode(dc,TRANSPARENT);DrawTextW(dc,wide(s).c_str(),-1,&r,DT_LEFT|DT_WORDBREAK|DT_END_ELLIPSIS);}
static void thumbnail(HDC dc,RECT r,const V& row){auto brush=CreateSolidBrush(RGB(39,43,49));FillRect(dc,&r,brush);DeleteObject(brush);RECT label{r.left+10,r.top+8,r.right-8,r.top+44};text(dc,label,field(row,"name").asStr(),RGB(255,174,94));const auto& triangles=field(row,"display_triangles").arr;if(triangles.empty()){RECT empty{r.left+10,r.top+50,r.right-10,r.bottom-10};text(dc,empty,field(row,"valid").b?"No display mesh available":field(row,"error").asStr());return;}double loX=1e300,loY=1e300,hiX=-1e300,hiY=-1e300;auto point=[](const V& t,int i){return std::pair<double,double>{.866*(t.arr[i].num-t.arr[i+1].num),.5*(t.arr[i].num+t.arr[i+1].num)-t.arr[i+2].num};};for(const auto& tri:triangles)if(tri.arr.size()==9)for(int j=0;j<9;j+=3){auto p=point(tri,j);loX=std::min(loX,p.first);hiX=std::max(hiX,p.first);loY=std::min(loY,p.second);hiY=std::max(hiY,p.second);}double scale=std::min((r.right-r.left-28.)/std::max(1.,hiX-loX),(r.bottom-r.top-66.)/std::max(1.,hiY-loY));const double x=r.left+(r.right-r.left-(hiX-loX)*scale)*.5-loX*scale,y=r.top+45+(r.bottom-r.top-55-(hiY-loY)*scale)*.5-loY*scale;auto pen=CreatePen(PS_SOLID,1,RGB(140,154,170));auto fill=CreateSolidBrush(RGB(80,91,107));auto oldP=SelectObject(dc,pen),oldB=SelectObject(dc,fill);std::vector<const V*> ordered;for(const auto& tri:triangles)if(tri.arr.size()==9)ordered.push_back(&tri);auto depth=[](const V* tri){double z=0;for(const auto& coordinate:tri->arr)z+=coordinate.num;return z;};std::stable_sort(ordered.begin(),ordered.end(),[&](const V* a,const V* b){return depth(a)<depth(b);});for(const auto* triangle:ordered){const auto& tri=*triangle;POINT pts[3];for(int j=0;j<3;++j){auto p=point(tri,j*3);pts[j]={(LONG)std::lround(x+p.first*scale),(LONG)std::lround(y+p.second*scale)};}const double ax=tri.arr[3].num-tri.arr[0].num,ay=tri.arr[4].num-tri.arr[1].num,az=tri.arr[5].num-tri.arr[2].num,bx=tri.arr[6].num-tri.arr[0].num,by=tri.arr[7].num-tri.arr[1].num,bz=tri.arr[8].num-tri.arr[2].num;const double nx=ay*bz-az*by,ny=az*bx-ax*bz,nz=ax*by-ay*bx,length=std::sqrt(nx*nx+ny*ny+nz*nz);const double light=length>1e-12?std::clamp((.3*nx+.5*ny+.8*nz)/length,0.,1.):0.;const int shade=(int)(65+65*light);auto faceBrush=CreateSolidBrush(RGB(shade,shade+11,shade+27));auto priorBrush=SelectObject(dc,faceBrush);Polygon(dc,pts,3);SelectObject(dc,priorBrush);DeleteObject(faceBrush);}SelectObject(dc,oldP);SelectObject(dc,oldB);DeleteObject(pen);DeleteObject(fill);}
static void layout(){RECT r{};GetClientRect(state.window,&r);const int w=r.right,h=r.bottom,left=350;MoveWindow(state.program,18,48,w-262,300,TRUE);MoveWindow(GetDlgItem(state.window,2),w-232,47,105,28,TRUE);MoveWindow(GetDlgItem(state.window,1),w-117,47,98,28,TRUE);MoveWindow(state.parameters,18,112,left-36,180,TRUE);MoveWindow(GetDlgItem(state.window,3),18,300,102,28,TRUE);MoveWindow(GetDlgItem(state.window,4),128,300,92,28,TRUE);MoveWindow(GetDlgItem(state.window,5),228,300,104,28,TRUE);MoveWindow(state.name,18,363,left-36,25,TRUE);MoveWindow(GetDlgItem(state.window,6),18,397,left-36,28,TRUE);MoveWindow(state.variants,18,465,left-36,std::max(80,h-565),TRUE);MoveWindow(GetDlgItem(state.window,7),18,h-92,147,28,TRUE);MoveWindow(GetDlgItem(state.window,8),176,h-92,156,28,TRUE);MoveWindow(state.results,left+10,112,w-left-28,134,TRUE);MoveWindow(GetDlgItem(state.window,9),left+10,256,150,28,TRUE);MoveWindow(GetDlgItem(state.window,10),left+170,256,150,28,TRUE);MoveWindow(GetDlgItem(state.window,11),left+330,256,174,28,TRUE);MoveWindow(state.status,18,h-51,w-36,42,TRUE);}
static LRESULT CALLBACK procedure(HWND w,UINT m,WPARAM wp,LPARAM lp){if(m==WM_CREATE){state.window=w;state.font=CreateFontW(-15,0,0,0,FW_NORMAL,FALSE,FALSE,FALSE,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");auto control=[&](const wchar_t* type,const wchar_t* title,DWORD style,int id){HWND c=CreateWindowExW(type==std::wstring(L"EDIT")||type==std::wstring(L"LISTBOX")?WS_EX_CLIENTEDGE:0,type,title,WS_CHILD|WS_VISIBLE|style,0,0,100,25,w,(HMENU)(INT_PTR)id,GetModuleHandle(nullptr),nullptr);SendMessageW(c,WM_SETFONT,(WPARAM)state.font,TRUE);return c;};state.program=control(L"COMBOBOX",L"",CBS_DROPDOWNLIST|WS_VSCROLL,20);state.parameters=control(L"LISTBOX",L"",LBS_NOTIFY|WS_VSCROLL|WS_HSCROLL,21);state.name=control(L"EDIT",L"Standard",ES_AUTOHSCROLL,22);state.variants=control(L"LISTBOX",L"",LBS_NOTIFY|WS_VSCROLL,23);state.results=control(L"LISTBOX",L"",LBS_NOTIFY|WS_VSCROLL|WS_HSCROLL,24);SendMessageW(state.results,LB_SETHORIZONTALEXTENT,2000,0);state.status=control(L"STATIC",L"",0,25);const wchar_t* labels[]={L"Refresh",L"New family",L"Edit value",L"Preview",L"Apply",L"Save named variant",L"Load values",L"Delete variant",L"Compare saved",L"Explore values",L"Use selected result"};for(int i=0;i<11;++i)control(L"BUTTON",labels[i],BS_PUSHBUTTON|WS_TABSTOP,i+1);SetTimer(w,1,500,nullptr);return 0;}if(m==WM_SIZE){layout();InvalidateRect(w,nullptr,TRUE);return 0;}if(m==WM_GETMINMAXINFO){auto* info=(MINMAXINFO*)lp;info->ptMinTrackSize={960,680};return 0;}if(m==WM_COMMAND){const int id=LOWORD(wp),event=HIWORD(wp);if(id<=11&&event==BN_CLICKED){action(id);return 0;}if(id==20&&event==CBN_SELCHANGE){int i=(int)SendMessageW(state.program,CB_GETCURSEL,0,0);if(i>=0&&i<(int)state.programNames.size()){state.ns=state.programNames[i];refresh();}return 0;}if(id==21&&event==LBN_DBLCLK){action(3);return 0;}if(id==23&&event==LBN_DBLCLK){action(7);return 0;}if(id==24&&event==LBN_SELCHANGE){state.selectedResult=(int)SendMessageW(state.results,LB_GETCURSEL,0,0);InvalidateRect(w,nullptr,TRUE);return 0;}}if(m==WM_TIMER){if(!state.busy&&(state.revision!=g_session.revision||state.epoch!=g_documentEpoch))message("Model changed. Refresh and review the current parameters before applying a configuration.");return 0;}if(m==WM_PAINT){PAINTSTRUCT ps{};HDC dc=BeginPaint(w,&ps);RECT r{};GetClientRect(w,&r);auto brush=CreateSolidBrush(RGB(27,30,35));FillRect(dc,&r,brush);DeleteObject(brush);auto old=SelectObject(dc,state.font);text(dc,{18,14,r.right-18,40},"Design variants / configure, compare and explore",RGB(255,174,94));text(dc,{18,87,330,108},"Program parameters");text(dc,{360,87,r.right-18,108},"Exact comparison results");text(dc,{18,337,330,360},"Variant name");text(dc,{18,439,330,462},"Saved configurations");const auto& rows=field(state.report,"results").arr;const int count=std::min<int>(3,(int)rows.size()),cardWidth=(r.right-378)/3;int start=std::max(0,std::min(state.selectedResult-1,(int)rows.size()-count));for(int i=0;i<count;++i)thumbnail(dc,{360+i*(cardWidth+6),306,360+i*(cardWidth+6)+cardWidth,r.bottom-76},rows[start+i]);SelectObject(dc,old);EndPaint(w,&ps);return 0;}if(m==WM_CLOSE){if(!state.busy)DestroyWindow(w);return 0;}if(m==WM_DESTROY){KillTimer(w,1);DeleteObject(state.font);state.window=nullptr;return 0;}return DefWindowProcW(w,m,wp,lp);}
static void open(){if(state.window){ShowWindow(state.window,SW_RESTORE);SetForegroundWindow(state.window);return;}WNDCLASSW wc{};wc.lpfnWndProc=procedure;wc.hInstance=GetModuleHandle(nullptr);wc.hCursor=LoadCursor(nullptr,IDC_ARROW);wc.lpszClassName=L"ARKDesignVariants067G";RegisterClassW(&wc);HWND w=CreateWindowExW(WS_EX_APPWINDOW,wc.lpszClassName,L"ARK / Design variants",WS_OVERLAPPEDWINDOW,90,70,1160,780,g_window,nullptr,wc.hInstance,nullptr);if(!w)throw std::runtime_error("Cannot open Design variants");refresh();layout();ShowWindow(w,SW_SHOW);UpdateWindow(w);}
