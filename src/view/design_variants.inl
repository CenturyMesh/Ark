// 067G native configurator. Preview triangles are display-only; comparisons use
// exact B-rep metrics returned by the same tool used by agents.
namespace design_variants_view_067g {
using V=arkjson::Value;
struct State {HWND window=nullptr,program=nullptr,parameters=nullptr,variants=nullptr,name=nullptr,results=nullptr,status=nullptr;HFONT font=nullptr;std::string ns;V values,report;u64 revision=0,epoch=0;bool busy=false;std::vector<std::string> parameterNames,savedNames,programNames;int selectedResult=0;std::string axis;};
static State state;
static const V& field(const V& v,const char* key){static V none;const auto* p=v.find(key);return p?*p:none;}
static std::wstring wide(const std::string& s){return bomWide(s);}
static std::string windowText(HWND w){int n=GetWindowTextLengthW(w);std::wstring value(n+1,L'\0');GetWindowTextW(w,value.data(),n+1);value.resize(n);if(value.empty())return {};int bytes=WideCharToMultiByte(CP_UTF8,0,value.data(),n,nullptr,0,nullptr,nullptr);std::string out(bytes,'\0');WideCharToMultiByte(CP_UTF8,0,value.data(),n,out.data(),bytes,nullptr,nullptr);return out;}
static void message(const std::string& s){SetWindowTextW(state.status,wide(s).c_str());g_status=s;}
static void add(HWND list,const std::string& s,bool combo=false){SendMessageW(list,combo?CB_ADDSTRING:LB_ADDSTRING,0,(LPARAM)wide(s).c_str());}
static const V* program(){for(const auto& p:g_doc.parametricPrograms.arr)if(field(p,"namespace").str==state.ns)return &p;return nullptr;}
// Parameter kinds as the program tool reports them. A boolean is staged as 1/0
// and a text choice as its listed text, the forms design_variants stores.
enum class ParameterKind{Number,Boolean,Choice,Text};
static ParameterKind parameterKind(const std::string& name){const auto* p=program();const std::string kind=p?field(parametricProgramParameterKinds(field(*p,"program")),name.c_str()).asStr():std::string();return kind=="boolean"?ParameterKind::Boolean:kind=="choice"?ParameterKind::Choice:kind=="text_choice"?ParameterKind::Text:ParameterKind::Number;}
static std::string shownValue(ParameterKind kind,const V& value){if(value.t==V::Str)return value.str;if(kind==ParameterKind::Boolean)return (value.t==V::Bool?value.b:value.num!=0)?"On":"Off";return value.dump();}
// Declared values of a boolean or choice in declared order; none for a number.
static std::vector<V> declaredValues(ParameterKind kind,const std::string& name){if(kind==ParameterKind::Boolean)return {V::makeNum(0),V::makeNum(1)};const auto* p=program();if(kind==ParameterKind::Number||!p)return {};const auto& choices=field(field(field(field(*p,"program"),"parameters"),name.c_str()),"choices");return choices.t==V::Arr?choices.arr:std::vector<V>{};}
// The declared values for one list row; a long list is cut at a whole value and counted.
static std::string listedValues(ParameterKind kind,const std::vector<V>& values){std::string out;size_t count=0;for(const auto& value:values){const auto item=shownValue(kind,value);if(count&&out.size()+item.size()>70)break;out+=(count?", ":"")+item;++count;}return count<values.size()?out+", ... ("+std::to_string(values.size())+" choices)":out;}
// The shared field dialog exchanges text in the system code page; the document holds UTF-8.
static std::string recode(const std::string& s,UINT from,UINT to){if(s.empty())return {};const int n=MultiByteToWideChar(from,0,s.data(),(int)s.size(),nullptr,0);std::wstring w(n,L' ');MultiByteToWideChar(from,0,s.data(),(int)s.size(),w.data(),n);const int bytes=WideCharToMultiByte(to,0,w.data(),n,nullptr,0,nullptr,nullptr);std::string out(bytes,' ');WideCharToMultiByte(to,0,w.data(),n,out.data(),bytes,nullptr,nullptr);return out;}
static std::string toDialog(const std::string& s){return recode(s,CP_UTF8,CP_ACP);}
static std::string fromDialog(const std::string& s){return recode(s,CP_ACP,CP_UTF8);}
// Trial values offered for a parameter: min, current and max of a number, or
// every declared value of a boolean or choice.
static std::string suggestedTrials(const std::string& name){const auto* p=program();if(!p)return {};const ParameterKind kind=parameterKind(name);if(kind!=ParameterKind::Number){std::string out;for(const auto& value:declaredValues(kind,name))out+=(out.empty()?"":", ")+shownValue(kind,value);return out;}const auto& spec=field(field(field(*p,"program"),"parameters"),name.c_str());const auto& value=field(state.values,name.c_str());return (spec.find("min")?field(spec,"min").dump():value.dump())+", "+value.dump()+", "+(spec.find("max")?field(spec,"max").dump():value.dump());}
// Trial values as the tool takes them: numbers or expressions for a number or
// numeric choice, On/Off for a boolean, listed text for a text choice. A listed
// text may itself contain commas, so the longest listed text starting at each
// position wins. No trial values means every declared value of a boolean or
// choice. An unlisted value is sent as entered and stays a failed trial.
static V trialValues(const std::string& name,const std::string& text){
    const ParameterKind kind=parameterKind(name);const auto declared=declaredValues(kind,name);V out=V::makeArr();const auto input=trimField(text);
    if(input.empty()&&kind!=ParameterKind::Number){out.arr=declared;return out;}
    if(kind==ParameterKind::Text){size_t at=0;while(at<input.size()){while(at<input.size()&&input[at]==' ')++at;const std::string* listed=nullptr;for(const auto& choice:declared){const auto& c=choice.str;if(input.compare(at,c.size(),c)!=0||(listed&&c.size()<=listed->size()))continue;const auto next=input.find_first_not_of(' ',at+c.size());if(next==std::string::npos||input[next]==',')listed=&c;}const auto comma=input.find(',',listed?at+listed->size():at);const auto word=listed?*listed:trimField(input.substr(at,comma==std::string::npos?std::string::npos:comma-at));if(!word.empty())out.arr.push_back(V::makeStr(word));if(comma==std::string::npos)break;at=comma+1;}return out;}
    std::istringstream in(input);std::string word;while(std::getline(in,word,',')){word=trimField(word);if(kind==ParameterKind::Boolean){std::string lower=word;for(auto& ch:lower)ch=(char)std::tolower((unsigned char)ch);const bool on=lower=="on"||lower=="true"||lower=="1";if(!on&&lower!="off"&&lower!="false"&&lower!="0")throw std::runtime_error("Trial values of "+name+" are On or Off");out.arr.push_back(V::makeNum(on?1:0));}else{bool ok=false;const double number=evalExpr(word,g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(number))throw std::runtime_error("Trial values must be finite numbers");out.arr.push_back(V::makeNum(number));}}
    return out;
}
// An exploration row names the value it tried, so "Trial 2" is not its only label.
static std::string resultTitle(const V& row){const auto name=field(row,"name").asStr();const auto* value=state.axis.empty()?nullptr:field(row,"values").find(state.axis.c_str());return value?name+" ("+state.axis+" = "+shownValue(parameterKind(state.axis),*value)+")":name;}
static void fillParameters(){SendMessageW(state.parameters,LB_RESETCONTENT,0,0);SendMessageW(state.parameters,LB_SETHORIZONTALEXTENT,0,0);state.parameterNames.clear();const auto* p=program();if(!p)return;HDC dc=GetDC(state.parameters);const auto listFont=SelectObject(dc,state.font);int extent=0;for(const auto& parameter:field(field(*p,"program"),"parameters").obj){state.parameterNames.push_back(parameter.first);const auto& spec=parameter.second;const ParameterKind kind=parameterKind(parameter.first);const auto unit=field(spec,"unit").asStr();std::string label=parameter.first+" = "+shownValue(kind,field(state.values,parameter.first.c_str()))+(kind==ParameterKind::Number||!unit.empty()?" "+unit:std::string());if(kind!=ParameterKind::Number)label+="   ["+listedValues(kind,declaredValues(kind,parameter.first))+"]";else if(spec.find("min")||spec.find("max"))label+="   ["+(spec.find("min")?field(spec,"min").dump():"-")+" .. "+(spec.find("max")?field(spec,"max").dump():"-")+"]";add(state.parameters,label);const auto shown=wide(label);SIZE size{};GetTextExtentPoint32W(dc,shown.c_str(),(int)wcslen(shown.c_str()),&size);extent=std::max(extent,(int)size.cx);}
    // A row wider than the list, such as a long declared list, scrolls sideways instead of being cut.
    SelectObject(dc,listFont);ReleaseDC(state.parameters,dc);SendMessageW(state.parameters,LB_SETHORIZONTALEXTENT,extent+12,0);if(!state.parameterNames.empty())SendMessageW(state.parameters,LB_SETCURSEL,0,0);}
static void fillSaved(){SendMessageW(state.variants,LB_RESETCONTENT,0,0);state.savedNames.clear();for(const auto& v:g_doc.designVariants.arr)if(field(v,"namespace").str==state.ns){state.savedNames.push_back(field(v,"name").str);const auto* p=program();add(state.variants,field(v,"name").str+(p&&field(v,"program_sha256").str==field(*p,"program_sha256").str?"":" [source changed]"));}}
static void refresh(){state.revision=g_session.revision;state.epoch=g_documentEpoch;state.report={};state.axis.clear();state.selectedResult=0;SendMessageW(state.results,LB_RESETCONTENT,0,0);SendMessageW(state.program,CB_RESETCONTENT,0,0);state.programNames.clear();int selected=0;for(const auto& p:g_doc.parametricPrograms.arr){if(field(p,"namespace").str==state.ns)selected=(int)state.programNames.size();state.programNames.push_back(field(p,"namespace").str);add(state.program,field(p,"namespace").str+" / "+field(p,"name").str,true);}for(const auto& v:g_doc.designVariants.arr){const auto ns=field(v,"namespace").str;if(std::find(state.programNames.begin(),state.programNames.end(),ns)==state.programNames.end()){if(ns==state.ns)selected=(int)state.programNames.size();state.programNames.push_back(ns);add(state.program,ns+" / program removed",true);}}if(!state.programNames.empty()){SendMessageW(state.program,CB_SETCURSEL,selected,0);state.ns=state.programNames[selected];state.values=program()?field(*program(),"values"):V::makeObj();}else{state.ns.clear();state.values=V::makeObj();}fillParameters();fillSaved();message(state.ns.empty()?"Install a starter program to create an editable family.":"Edit parameters, preview, save named configurations, then compare or explore.");InvalidateRect(state.window,nullptr,TRUE);}
static V tool(V a){a.set("namespace",V::makeStr(state.ns));a.set("expected_revision",V::makeNum(double(state.revision)));auto r=runTool("design_variants",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());return field(r,"structuredContent");}
static V args(const char* action){V a=V::makeObj();a.set("action",V::makeStr(action));return a;}
static void commit(const V& preview){V a=V::makeObj();a.set("expected_revision",V::makeNum(double(state.revision)));a.set("candidate_id",field(preview,"candidate_id"));const auto r=runTool("doc_apply",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());refresh();}
static void showReport(V report,std::string axis={}){state.report=std::move(report);state.axis=std::move(axis);state.selectedResult=0;SendMessageW(state.results,LB_RESETCONTENT,0,0);for(const auto& row:field(state.report,"results").arr){const auto& m=field(row,"metrics");std::string label=resultTitle(row)+" | ";if(!field(row,"valid").b)label+="FAILED: "+field(row,"error").str;else{label+=field(m,"width_mm").dump()+" x "+field(m,"depth_mm").dump()+" x "+field(m,"height_mm").dump()+" mm | "+field(m,"volume_mm3").dump()+" mm3 | ";label+=field(m,"mass_available").b?field(m,"mass_kg").dump()+" kg":"mass: assign density";if(!field(row,"feasible").b)label+=" | outside constraints";}add(state.results,label);}if(!field(state.report,"ranked_indices").arr.empty())state.selectedResult=(int)field(state.report,"ranked_indices").arr[0].num;SendMessageW(state.results,LB_SETCURSEL,state.selectedResult,0);message(std::to_string((int)field(state.report,"attempted").num)+" evaluated / "+std::to_string((int)field(state.report,"failed").num)+" failed. Exact metrics; sampled thumbnails are display only.");InvalidateRect(state.window,nullptr,TRUE);}
static void editParameter(){int i=(int)SendMessageW(state.parameters,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.parameterNames.size())return;const auto name=state.parameterNames[i];const ParameterKind kind=parameterKind(name);const V current=field(state.values,name.c_str());V staged;
    if(kind==ParameterKind::Number){std::string value=current.dump();if(!editText(("Parameter: "+name).c_str(),value))return;bool ok=false;double parsed=evalExpr(trimField(value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(parsed))throw std::runtime_error("Enter a finite numeric value");staged=V::makeNum(parsed);}
    else if(kind==ParameterKind::Boolean)staged=V::makeNum(shownValue(kind,current)=="On"?0:1);
    // A choice is taken by its position in the declared list, not by the text the dialog returns.
    else{const auto values=declaredValues(kind,name);std::vector<std::string> labels;for(const auto& value:values)labels.push_back(toDialog(shownValue(kind,value)));int picked=-1;std::vector<EditorField> fields{choiceField(name.c_str(),toDialog(shownValue(kind,current)),labels)};if(!editFields(("Parameter: "+name).c_str(),(std::to_string(values.size())+" declared choices. The value is staged; Preview validates it before Apply.").c_str(),fields,false,"Stage",nullptr,false,[&](const std::vector<HWND>& controls){picked=(int)SendMessage(controls[0],CB_GETCURSEL,0,0);}))return;if(picked<0||picked>=(int)values.size())throw std::runtime_error("Choose one of the declared values of "+name);staged=values[(size_t)picked];}
    state.values.set(name,staged);fillParameters();SendMessageW(state.parameters,LB_SETCURSEL,i,0);message(kind==ParameterKind::Number?std::string("Value staged; Preview validates the program and exact geometry before Apply."):name+" = "+shownValue(kind,staged)+" staged; Preview validates the program and exact geometry before Apply.");}
static void loadSaved(){if(!program())throw std::runtime_error("The program was removed. This saved configuration can be inspected or deleted, but cannot be applied.");int i=(int)SendMessageW(state.variants,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.savedNames.size())return;for(const auto& v:g_doc.designVariants.arr)if(field(v,"namespace").str==state.ns&&field(v,"name").str==state.savedNames[i]){if(field(v,"program_sha256").str!=field(*program(),"program_sha256").str)throw std::runtime_error("Program source changed. Review each parameter before creating a new configuration.");state.values=field(v,"values");SetWindowTextW(state.name,wide(state.savedNames[i]).c_str());fillParameters();message("Saved values staged. Preview checks geometry; Apply publishes the selected configuration.");break;}}
static void starter(){const V examples=parametricProgramExamples();std::vector<EditorField> fields{{"Example",field(examples.arr.front(),"id").str},{"Namespace","family"}};for(const auto& example:examples.arr)fields[0].choices.push_back(field(example,"id").str);if(!editFields("New parametric family","Installs an editable example with exact native features. Existing designs are preserved.",fields))return;const auto ns=trimField(fields[1].value);V a=V::makeObj();a.set("action",V::makeStr("prepare"));a.set("mode",V::makeStr("install"));a.set("namespace",V::makeStr(ns));a.set("expected_revision",V::makeNum(double(state.revision)));for(const auto& example:examples.arr)if(field(example,"id").str==fields[0].value)a.set("program",field(example,"program"));const auto r=runTool("parametric_program",a);if(field(r,"isError").b)throw std::runtime_error(field(r,"structuredContent").dump());commit(field(r,"structuredContent"));state.ns=ns;refresh();}
static void explore(){const auto* p=program();if(!p)throw std::runtime_error("Install a program first");const int listed=(int)SendMessageW(state.parameters,LB_GETCURSEL,0,0);const std::string initial=state.parameterNames.empty()?std::string():state.parameterNames[listed>=0&&listed<(int)state.parameterNames.size()?(size_t)listed:0];std::vector<EditorField> fields{{"Parameter",initial},{"Trial values (comma separated)",""},{"Minimize","volume_mm3"},{"Maximum width mm (optional)",""},{"Maximum depth mm (optional)",""},{"Maximum height mm (optional)",""},{"Maximum mass kg (optional)",""},{"Clearance feature A (optional)",""},{"Clearance feature B (optional)",""},{"Minimum pair gap mm (optional)",""}};fields[0].choices=state.parameterNames;fields[2].choices={"volume_mm3","mass_kg","width_mm","depth_mm","height_mm"};fields[1].value=toDialog(suggestedTrials(initial));
    // Choosing another parameter offers that parameter's own trial values.
    std::string offered=initial;if(!editFields("Explore parameter alternatives","Exact kernel evaluation; failed trials stay listed. No trial values: every declared value is tried. No structural or manufacturing claim.",fields,false,"Apply",nullptr,false,[&](const std::vector<HWND>& controls){char name[160]{};GetWindowTextA(controls[0],name,sizeof name);if(offered==name)return;offered=name;SetWindowTextA(controls[1],toDialog(suggestedTrials(offered)).c_str());}))return;// Offered values of a boolean or choice that were left as offered are the declared values themselves, so text the system code page cannot carry is still explored.
    const bool asOffered=parameterKind(fields[0].value)!=ParameterKind::Number&&fields[1].value==toDialog(suggestedTrials(fields[0].value));V a=args("explore"),axes=V::makeObj(),constraints=V::makeObj();axes.set(fields[0].value,trialValues(fields[0].value,asOffered?std::string():fromDialog(fields[1].value)));const char* keys[]={"width_mm","depth_mm","height_mm","mass_kg"};for(int i=0;i<4;++i)if(!trimField(fields[i+3].value).empty()){bool ok=false;const auto value=evalExpr(trimField(fields[i+3].value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(value))throw std::runtime_error("Limits must be finite numbers");V range=V::makeObj();range.set("max",V::makeNum(value));constraints.set(keys[i],range);}if(!trimField(fields[7].value).empty()||!trimField(fields[8].value).empty()||!trimField(fields[9].value).empty()){bool ok=false;const double gap=evalExpr(trimField(fields[9].value),g_doc.buildEnv(),&ok);if(!ok||!std::isfinite(gap)||gap<0||trimField(fields[7].value).empty()||trimField(fields[8].value).empty())throw std::runtime_error("Enter both program feature names and a nonnegative minimum gap");V pairs=V::makeArr(),pair=V::makeObj();pair.set("a",V::makeStr(trimField(fields[7].value)));pair.set("b",V::makeStr(trimField(fields[8].value)));pair.set("min_mm",V::makeNum(gap));pairs.arr.push_back(pair);a.set("clearance_pairs",pairs);}a.set("values",state.values);a.set("axes",axes);a.set("constraints",constraints);a.set("objective",V::makeStr(fields[2].value));a.set("thumbnails",V::makeBool(true));showReport(tool(a),fields[0].value);}
static void action(int id){if(state.busy)return;state.busy=true;g_error=false;try{if(id!=1&&state.epoch!=g_documentEpoch)throw std::runtime_error("Document changed. Refresh before editing.");if(id!=1&&state.revision!=g_session.revision)throw std::runtime_error("Model revision changed. Refresh and review values before continuing.");if(id==1)refresh();else if(id==2)starter();else if(id==3)editParameter();else if(id==4){V a=args("evaluate");a.set("name",V::makeStr("Staged"));a.set("values",state.values);a.set("thumbnails",V::makeBool(true));showReport(tool(a));}else if(id==5){V a=args("prepare");a.set("values",state.values);commit(tool(a));message("Configuration applied. Undo restores the previous editable source.");}else if(id==6){V a=args("save");a.set("name",V::makeStr(trimField(windowText(state.name))));a.set("values",state.values);const V staged=state.values;commit(tool(a));state.values=staged;fillParameters();message("Named configuration saved in the document; Save the .ark to retain it on disk.");}else if(id==7)loadSaved();else if(id==8){int i=(int)SendMessageW(state.variants,LB_GETCURSEL,0,0);if(i<0||i>=(int)state.savedNames.size())throw std::runtime_error("Select a saved variant");V a=args("remove");a.set("name",V::makeStr(state.savedNames[i]));const V staged=state.values;commit(tool(a));state.values=staged;fillParameters();}else if(id==9){V a=args("evaluate");a.set("thumbnails",V::makeBool(true));showReport(tool(a));}else if(id==10)explore();else if(id==11){int i=(int)SendMessageW(state.results,LB_GETCURSEL,0,0);const auto& rows=field(state.report,"results").arr;if(i<0||i>=(int)rows.size()||!field(rows[i],"valid").b)throw std::runtime_error("Select a valid evaluated result");state.values=field(rows[i],"values");SetWindowTextW(state.name,wide(field(rows[i],"name").str).c_str());fillParameters();message("Result values staged. Save a named variant or Apply to the model.");}}catch(const std::exception& e){g_error=true;message(e.what());}state.busy=false;InvalidateRect(state.window,nullptr,TRUE);}
static void text(HDC dc,RECT r,const std::string& s,COLORREF color=RGB(225,228,232)){SetTextColor(dc,color);SetBkMode(dc,TRANSPARENT);DrawTextW(dc,wide(s).c_str(),-1,&r,DT_LEFT|DT_WORDBREAK|DT_END_ELLIPSIS);}
static void thumbnail(HDC dc,RECT r,const V& row){auto brush=CreateSolidBrush(RGB(39,43,49));FillRect(dc,&r,brush);DeleteObject(brush);RECT label{r.left+10,r.top+8,r.right-8,r.top+44};text(dc,label,resultTitle(row),RGB(255,174,94));const auto& triangles=field(row,"display_triangles").arr;if(triangles.empty()){RECT empty{r.left+10,r.top+50,r.right-10,r.bottom-10};text(dc,empty,field(row,"valid").b?"No display mesh available":field(row,"error").asStr());return;}double loX=1e300,loY=1e300,hiX=-1e300,hiY=-1e300;auto point=[](const V& t,int i){return std::pair<double,double>{.866*(t.arr[i].num-t.arr[i+1].num),.5*(t.arr[i].num+t.arr[i+1].num)-t.arr[i+2].num};};for(const auto& tri:triangles)if(tri.arr.size()==9)for(int j=0;j<9;j+=3){auto p=point(tri,j);loX=std::min(loX,p.first);hiX=std::max(hiX,p.first);loY=std::min(loY,p.second);hiY=std::max(hiY,p.second);}double scale=std::min((r.right-r.left-28.)/std::max(1.,hiX-loX),(r.bottom-r.top-66.)/std::max(1.,hiY-loY));const double x=r.left+(r.right-r.left-(hiX-loX)*scale)*.5-loX*scale,y=r.top+45+(r.bottom-r.top-55-(hiY-loY)*scale)*.5-loY*scale;auto pen=CreatePen(PS_SOLID,1,RGB(140,154,170));auto fill=CreateSolidBrush(RGB(80,91,107));auto oldP=SelectObject(dc,pen),oldB=SelectObject(dc,fill);std::vector<const V*> ordered;for(const auto& tri:triangles)if(tri.arr.size()==9)ordered.push_back(&tri);auto depth=[](const V* tri){double z=0;for(const auto& coordinate:tri->arr)z+=coordinate.num;return z;};std::stable_sort(ordered.begin(),ordered.end(),[&](const V* a,const V* b){return depth(a)<depth(b);});for(const auto* triangle:ordered){const auto& tri=*triangle;POINT pts[3];for(int j=0;j<3;++j){auto p=point(tri,j*3);pts[j]={(LONG)std::lround(x+p.first*scale),(LONG)std::lround(y+p.second*scale)};}const double ax=tri.arr[3].num-tri.arr[0].num,ay=tri.arr[4].num-tri.arr[1].num,az=tri.arr[5].num-tri.arr[2].num,bx=tri.arr[6].num-tri.arr[0].num,by=tri.arr[7].num-tri.arr[1].num,bz=tri.arr[8].num-tri.arr[2].num;const double nx=ay*bz-az*by,ny=az*bx-ax*bz,nz=ax*by-ay*bx,length=std::sqrt(nx*nx+ny*ny+nz*nz);const double light=length>1e-12?std::clamp((.3*nx+.5*ny+.8*nz)/length,0.,1.):0.;const int shade=(int)(65+65*light);auto faceBrush=CreateSolidBrush(RGB(shade,shade+11,shade+27));auto priorBrush=SelectObject(dc,faceBrush);Polygon(dc,pts,3);SelectObject(dc,priorBrush);DeleteObject(faceBrush);}SelectObject(dc,oldP);SelectObject(dc,oldB);DeleteObject(pen);DeleteObject(fill);}
