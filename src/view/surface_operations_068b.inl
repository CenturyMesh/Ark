static std::string numeric(double value){std::ostringstream out;out<<std::setprecision(17)<<value;return out.str();}
static const V& get(const V& v,const char* k){static V nil;auto* p=v.find(k);return p?*p:nil;}
static V call(V args){args.set("expected_revision",V::makeNum(double(g_session.revision)));const auto result=runTool("surface_control",args);if(get(result,"isError").b)throw std::runtime_error(get(get(result,"structuredContent"),"error").asStr());return get(result,"structuredContent");}
static V request(const char* action){V a=V::makeObj();a.set("action",V::makeStr(action));return a;}
static u64 resolveFeature(const std::string& value){const auto name=trimField(value);if(!name.empty()&&name.front()=='#')return featureIdField(name.substr(1));u64 id=0;unsigned matches=0;for(const auto& f:g_doc.features)if(f.name==name){id=f.id;++matches;}if(matches>1)throw std::runtime_error("Feature name is ambiguous; use # followed by its numeric ID");if(matches&&!name.empty()&&name.find_first_not_of("0123456789")==std::string::npos){const double numeric=formNumber(name);for(const auto& f:g_doc.features)if(numeric==double(f.id)&&f.id!=id)throw std::runtime_error("Text matches a feature name and a different ID; use #ID or a unique nonnumeric name");}return matches?id:featureIdField(name);}
static std::vector<u64> sources(const std::string& text){std::vector<u64> result;std::istringstream stream(text);std::string word;while(std::getline(stream,word,';')){auto id=resolveFeature(word);if(std::find(result.begin(),result.end(),id)!=result.end())throw std::runtime_error("Choose each feature once; extract separate faces for multiple regions of one body");result.push_back(id);}if(result.empty()||result.size()>16)throw std::runtime_error("Choose 1..16 source feature names or IDs separated by semicolons");return result;}
static void current(u64 revision,u64 epoch){if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Document changed while preparing surface operation; inspect current sources again");}
static void preview(V args,u64 revision,u64 epoch,const std::string& capturePath={}){current(revision,epoch);const auto candidate=call(args);current(revision,epoch);const auto id=get(candidate,"candidate_id").asStr();if(id.empty()||!get(candidate,"valid").b)throw std::runtime_error("No validated surface candidate was retained");
    const auto imagePath=std::filesystem::temp_directory_path()/"ARK"/"previews"/("surface-"+id+".png");std::filesystem::create_directories(imagePath.parent_path());V shot=V::makeObj();shot.set("candidate_id",V::makeStr(id));shot.set("expected_revision",V::makeNum(double(revision)));const auto& created=get(get(candidate,"candidate_result"),"created_ids");if(created.t!=V::Arr||created.arr.size()!=1)throw std::runtime_error("Surface candidate does not identify its one created result");shot.set("id",created.arr.front());shot.set("view",V::makeStr("iso"));shot.set("path",V::makeStr(imagePath.string()));const auto capture=callSessionWithProgress("snapshot",shot);if(get(capture,"isError").b)throw std::runtime_error(get(get(capture,"structuredContent"),"error").asStr());HBITMAP bitmap=candidateReviewBitmap(imagePath.string());if(!bitmap)throw std::runtime_error("Could not load the exact candidate preview");const auto operation=get(candidate,"operation").asStr();const std::string title=operation=="multi_trim_plan"?"Trim selected faces":operation=="extend_trimmed_plan"?"Extend surface and preserve holes":"Sew selected surfaces";std::vector<EditorField> report{{"Operation",title},{"Sources",std::to_string(get(candidate,"sources").arr.size())+" exact source definitions"}};if(!capturePath.empty())g_dialogShot=capturePath+".candidate.png";const bool accept=editFields("Review surface result","The image is the checked native candidate. Apply publishes it once; Cancel preserves every source and the current design.",report,false,"Apply",bitmap,true);DeleteObject(bitmap);if(!accept){g_status="Surface candidate cancelled / source geometry retained";return;}current(revision,epoch);V apply=V::makeObj();apply.set("candidate_id",V::makeStr(id));apply.set("expected_revision",V::makeNum(double(revision)));runTool("doc_apply",apply);if(!g_error){const u64 resultId=(u64)created.arr.front().num;clearDatumSelection();g_pickKind=0;g_picked.clear();g_explorerFeature=resultId;int selected=-1;for(size_t i=0;i<g_bodyIds.size();++i)if(g_bodyIds[i]==resultId&&displayInstance(i)){selected=(int)i;break;}selectBody062(selected,false);frameScene();g_status="Reviewed surface operation applied / Undo restores the prior design";}
