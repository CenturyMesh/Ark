static void trim(){const auto capturePath=g_dialogShot;const auto revision=g_session.revision,epoch=g_documentEpoch;std::vector<EditorField> f{{"Result name","Trimmed surface set"},{"Source features / ; names",selectedFeatureId()},pickField("Trimming tool","",5)};if(!editFields("Trim a surface set","Pick source faces and a cutter. Next, choose a retained point on each face.",f))return;current(revision,epoch);V args=request("multi_trim_plan"),list=V::makeArr(),points=V::makeArr();args.set("name",V::makeStr(f[0].value));args.set("tool_id",V::makeNum(double(resolveFeature(f[2].value))));for(u64 source:sources(f[1].value)){V inspect=request("operations_inspect");inspect.set("id",V::makeNum(double(source)));const auto info=call(inspect);std::vector<std::string> faces;for(const auto& ref:get(info,"references").arr)if(get(ref,"kind").asStr()=="face"&&(get(ref,"status").asStr()=="bound"||get(ref,"status").asStr()=="merged")&&get(ref,"indices").arr.size()==1)faces.push_back(get(ref,"name").asStr());if(faces.empty())throw std::runtime_error("Source has no unambiguous exact face reference");std::vector<EditorField> row{choiceField("Source face",faces.front(),faces),{"Keep X / local mm","0"},{"Keep Y / local mm","0"},{"Keep Z / local mm","0"}};const auto title="Retain region / "+g_doc.find(source)->name;if(!capturePath.empty())g_dialogShot=capturePath+".region-"+std::to_string(list.arr.size()+1)+".png";if(!editFields(title.c_str(),"Choose an interior point off the cut. Other regions are removed explicitly.",row))return;current(revision,epoch);V entry=V::makeObj(),point=V::makeArr();entry.set("id",V::makeNum(double(source)));entry.set("face",V::makeStr(row[0].value));for(int i=1;i<=3;++i){formNumber(row[i].value);point.arr.push_back(V::makeStr(trimField(row[i].value)));}list.arr.push_back(entry);points.arr.push_back(point);}args.set("sources",list);args.set("keep_points",points);preview(args,revision,epoch,capturePath);}
static void extend(){const auto capturePath=g_dialogShot;const auto revision=g_session.revision,epoch=g_documentEpoch;std::vector<EditorField> choose{pickField("Open face source",selectedFeatureId(),4)};if(!editFields("Choose surface to extend","Select one open face; the next form uses its exact UV domain.",choose))return;current(revision,epoch);V inspect=request("operations_inspect");inspect.set("id",V::makeNum(double(resolveFeature(choose[0].value))));const auto source=call(inspect);const auto& uv=get(get(source,"domain"),"uv_bounds");if(uv.arr.size()!=4)throw std::runtime_error(get(source,"domain_unavailable").asStr());std::vector<EditorField> f{{"Result name","Extended surface with holes"},pickField("Open face source",choose[0].value,4),choiceField("Extension",get(get(source,"domain"),"bounded_support").b?"Length":"UV bounds",{"UV bounds","Length"}),{"U minimum",numeric(uv.arr[0].num)},{"U maximum",numeric(uv.arr[1].num)},{"V minimum",numeric(uv.arr[2].num)},{"V maximum",numeric(uv.arr[3].num)},choiceField("Direction","u_max",{"u_min","u_max","v_min","v_max"}),{"Length / mm","10"},choiceField("Derivative order","2",{"1","2","3"})};if(!capturePath.empty())g_dialogShot=capturePath+".parameters.png";if(!editFields("Extend surface and preserve holes","Keep holes; bounded supports use Length. UV values are native parameters.",f))return;current(revision,epoch);if(resolveFeature(f[1].value)!=resolveFeature(choose[0].value))throw std::runtime_error("Source changed in the extension form; reopen to inspect its current UV bounds");V args=request("extend_trimmed_plan");args.set("name",V::makeStr(f[0].value));args.set("id",V::makeNum(double(resolveFeature(f[1].value))));if(f[2].value=="UV bounds"){V bounds=V::makeArr();for(int i=3;i<=6;++i){formNumber(f[i].value);bounds.arr.push_back(V::makeStr(trimField(f[i].value)));}args.set("bounds",bounds);}else{V extension=V::makeObj();extension.set("direction",V::makeStr(f[7].value));formNumber(f[8].value);extension.set("length_mm",V::makeStr(trimField(f[8].value)));extension.set("continuity",V::makeNum(formNumber(f[9].value)));args.set("extension",extension);}preview(args,revision,epoch,capturePath);}
static void sew(bool inspect){const auto capturePath=g_dialogShot;const auto revision=g_session.revision,epoch=g_documentEpoch;std::vector<EditorField> f{{"Source surfaces / ; names",selectedFeatureId()},{"Result name","Sewn surface set"},{"Create closed solid","0",true},{"Require connected surface","1",true}};if(!editFields(inspect?"Inspect open sewing boundaries":"Sew exact surface set","Choose 2..16 exact face/shell definitions. Fixed native tolerance is preserved; no disconnected region or face is dropped.",f))return;current(revision,epoch);V args=request(inspect?"sew_inspect":"sew_plan"),list=V::makeArr();for(u64 id:sources(f[0].value))list.arr.push_back(V::makeNum(double(id)));args.set("sources",list);if(!inspect){args.set("name",V::makeStr(f[1].value));args.set("solid",V::makeBool(f[2].value=="1"));args.set("require_connected",V::makeBool(f[3].value=="1"));preview(args,revision,epoch,capturePath);return;}
