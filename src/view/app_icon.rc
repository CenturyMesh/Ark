#include <windows.h>
#include "ark/version.hpp"

// First executable icon: Explorer, shortcuts and Task Manager.
101 ICON "ark-app.ico"

// Explorer properties and Task Manager use this name independently of the caption.
1 VERSIONINFO
 FILEVERSION ARK_APP_VERSION_MAJOR,ARK_APP_VERSION_MINOR,ARK_APP_VERSION_PATCH,0
 PRODUCTVERSION ARK_APP_VERSION_MAJOR,ARK_APP_VERSION_MINOR,ARK_APP_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ARK\0"
            VALUE "ProductName", "ARK\0"
            VALUE "FileVersion", ARK_APP_VERSION "\0"
            VALUE "ProductVersion", ARK_APP_VERSION "\0"
            VALUE "OriginalFilename", "ark-studio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
