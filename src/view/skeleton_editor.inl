    if(const auto* authoring=inspection.find("authoring")){if(const auto* overrides=authoring->find("overrides");overrides&&overrides->t==arkjson::Value::Obj&&!overrides->obj.empty()){report<<"CURRENT INPUT OVERRIDES\n";for(const auto& item:overrides->obj)report<<item.first<<" = "<<item.second.asStr()<<"\n";report<<"\n";}if(const auto* manifest=authoring->find("manifest")){if(const auto* parameters=manifest->find("parameters")){report<<"OWNED DECLARATIONS\n";for(const auto& parameter:parameters->arr){const auto* name=parameter.find("name"),*kind=parameter.find("kind");if(name&&kind)report<<kind->asStr()<<" "<<name->asStr()<<"\n";}}if(const auto* features=manifest->find("features"))for(const auto& feature:features->arr)report<<"pattern "<<feature.find("name")->asStr()<<" / #"<<feature.find("id")->num<<"\n";}}
