static LRESULT CALLBACK skeletonEditorProc(HWND window,UINT message,WPARAM wp,LPARAM lp){
    auto* editor=(SkeletonEditorState*)GetWindowLongPtr(window,GWLP_USERDATA);
    if(editor&&message==WM_COMMAND){const auto action=LOWORD(wp);if(action==201&&HIWORD(wp)==EN_CHANGE){editor->candidateId.clear();skeletonEditorDiagnostic(*editor,"Source changed; Validate checks declarations, Preview checks dependent geometry, and Apply publishes atomically.");return 0;}try{if(action==101){skeletonEditorValidate(*editor);return 0;}if(action==102){skeletonEditorPreview(*editor);return 0;}if(action==1){skeletonEditorApply(*editor);return 0;}}catch(const std::exception& error){skeletonEditorDiagnostic(*editor,error.what());g_error=true;g_status=error.what();return 0;}}
