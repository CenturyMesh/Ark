    // ANSI default proc would read only the first character of WM_SETTEXT.
    if(message==WM_CTLCOLORSTATIC||message==WM_CTLCOLOREDIT||message==WM_DRAWITEM||message==WM_CLOSE||(message==WM_COMMAND&&LOWORD(wp)==2))return editorProc(window,message,wp,lp);
    return DefWindowProcW(window,message,wp,lp);
}
