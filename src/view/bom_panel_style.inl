static LRESULT CALLBACK bomHeaderProc(HWND window,UINT message,WPARAM w,LPARAM l,UINT_PTR,DWORD_PTR data){auto& state=*(BomPanel*)data;if(message==WM_ERASEBKGND)return 1;if(message==WM_PAINT||message==WM_PRINTCLIENT){PAINTSTRUCT paint{};HDC dc=message==WM_PAINT?BeginPaint(window,&paint):(HDC)w;RECT client{};GetClientRect(window,&client);bomFill(dc,client,RGB(26,38,49));const wchar_t* labels[]={L"PART / DESCRIPTION",L"QTY",L"MATERIAL",L"MAKE / BUY",L"STATUS"};for(int i=0;i<5;++i){RECT cell{};Header_GetItemRect(window,i,&cell);cell.left+=16;bomLabel(dc,labels[i],cell,state.smallFont,bomMuted);if(state.sort==i){POINT triangle[3];int x=cell.right-12,y=(cell.top+cell.bottom)/2;triangle[0]={x-3,y+(state.descending?-2:2)};triangle[1]={x+3,y+(state.descending?-2:2)};triangle[2]={x,y+(state.descending?2:-2)};auto brush=CreateSolidBrush(bomCyan);auto old=SelectObject(dc,brush),pen=SelectObject(dc,GetStockObject(NULL_PEN));Polygon(dc,triangle,3);SelectObject(dc,old);SelectObject(dc,pen);DeleteObject(brush);}}if(message==WM_PAINT)EndPaint(window,&paint);return 0;}if(message==HDM_LAYOUT){auto result=DefSubclassProc(window,message,w,l);auto* layout=(HDLAYOUT*)l;layout->pwpos->cy=36;layout->prc->top=36;return result;}return DefSubclassProc(window,message,w,l);}
