static void bomPaintButton(BomPanel& state,const DRAWITEMSTRUCT& item){int id=(int)item.CtlID;RECT r=item.rcItem;auto background=CreateSolidBrush(bomBg);FillRect(item.hDC,&r,background);DeleteObject(background);bool pressed=(item.itemState&ODS_SELECTED)!=0,disabled=(item.itemState&ODS_DISABLED)!=0,active=(id>=521&&id<=524&&state.filter==id-521);bool primary=id==504;COLORREF bg=primary?RGB(82,200,225):active?RGB(29,66,79):RGB(26,39,50);if(pressed)bg=RGB(42,92,107);bomFill(item.hDC,r,bg,10,active?bomCyan:bomLine);wchar_t label[100]{};GetWindowTextW(item.hwndItem,label,100);bomLabel(item.hDC,label,r,state.smallFont,disabled?RGB(91,112,127):primary?RGB(12,31,38):active?bomCyan:bomWhite,DT_CENTER|DT_VCENTER|DT_SINGLELINE);if(item.itemState&ODS_FOCUS){InflateRect(&r,-3,-3);DrawFocusRect(item.hDC,&r);}}
