static bool componentLibraryAction067G(int id){if(id!=49960)return false;component_library_067g::open();return true;}
static int testComponentLibrary067G(const std::string& shotPath){
    using namespace component_library_067g;
    auto verify=[](bool ok,const std::string& message){if(!ok)throw std::runtime_error(message);};
    auto json=[&](const char* text){V value;verify(arkjson::parse(text,value),"Library fixture JSON");return value;};
    auto apply=[&](const char* text){V args=json(text);args.set("expected_revision",V::makeNum((double)g_session.revision));runTool("doc_apply",args);verify(!g_error,g_status);};
    const bool previousBusyTest=g_busyTestMode;
    try{
        g_busyTestMode=true;g_session=AgentSession{};++g_documentEpoch;rebuildScene();
        apply(R"({"commands":[{"op":"param.set","name":"width","expr":60},{"op":"feature.add","type":"native_solid","name":"Mounting plate","native":{"op":"box"},"p":{"width":"width","depth":36,"height":6}}]})");
        const auto folder=std::filesystem::absolute(std::filesystem::path(shotPath).parent_path()/("library-fixture-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count())));std::filesystem::create_directories(folder);
        V definition=json(R"({"kind":"part","feature":1,"name":"Adjustable mounting plate","parameters":["width"],"interfaces":[]})");
        const auto first=folder/"mount-r1.arkprt";saveParametricComponent(makeParametricComponent(g_doc,definition),first.string());
        apply(R"({"commands":[{"op":"feature.edit","id":1,"p":{"height":8}}]})");definition.set("previous_path",V::makeStr(first.string()));const auto second=folder/"mount-r2.arkprt";saveParametricComponent(makeParametricComponent(g_doc,definition),second.string());
        g_session=AgentSession{};++g_documentEpoch;rebuildScene();state.directory=folder.string();componentLibraryAction067G(49960);verify(state.window&&get(state.catalog,"components").arr.size()==2,"Library browser catalog missing revisions");verify(!get(state.thumbnail,"lines").arr.empty(),"Selected component thumbnail missing");
        const auto before=g_session.revision;SetWindowTextW(state.search,L"absent");SendMessage(state.window,WM_COMMAND,3,0);verify(get(state.catalog,"components").arr.empty(),"Search failed to filter");SetWindowTextW(state.search,L"width");SendMessage(state.window,WM_COMMAND,3,0);verify(get(state.catalog,"components").arr.size()==2&&g_session.revision==before,"Public-parameter search mutated design");
        UpdateWindow(state.window);bomCapture(state.window,shotPath+".library.png");verify(std::filesystem::is_regular_file(shotPath+".library.png"),"Library capture missing");
        g_dialogSmoke=3;g_dialogOverrideQueue={{"mount","{\"width\":72}"}};SendMessage(state.window,WM_COMMAND,5,0);g_dialogSmoke=0;verify(state.error.empty()&&!g_error&&g_doc.parametricComponents.arr.size()==1,"Library insert: "+state.error+" / "+g_status);verify(g_doc.getParam("mount__width")==72,"Library public parameter override missing");
        SendMessage(state.list,LB_SETCURSEL,1,0);SendMessage(state.window,WM_COMMAND,MAKEWPARAM(7,LBN_SELCHANGE),0);g_dialogSmoke=3;g_dialogOverrideQueue={{"mount","{}"}};SendMessage(state.window,WM_COMMAND,6,0);g_dialogSmoke=0;verify(state.error.empty()&&!g_error&&get(get(g_doc.parametricComponents.arr.front(),"package"),"revision").num==2,"Library explicit update failed: "+state.error+" / "+g_status);
        SetWindowPos(state.window,nullptr,0,0,960,640,SWP_NOMOVE|SWP_NOZORDER);UpdateWindow(state.window);bomCapture(state.window,shotPath+".library-compact.png");DestroyWindow(state.window);g_busyTestMode=previousBusyTest;return 0;
    }catch(const std::exception& e){g_dialogSmoke=0;g_dialogOverrideQueue.clear();g_busyTestMode=previousBusyTest;if(state.window)DestroyWindow(state.window);fprintf(stderr,"Component library 067G: %s\n",e.what());return 1676;}
