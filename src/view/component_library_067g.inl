static std::string input(HWND w){int length=GetWindowTextLengthW(w);std::wstring text((size_t)length+1,0);GetWindowTextW(w,text.data(),length+1);const int size=WideCharToMultiByte(CP_UTF8,0,text.data(),length,nullptr,0,nullptr,nullptr);std::string out((size_t)size,0);if(size)WideCharToMultiByte(CP_UTF8,0,text.data(),length,out.data(),size,nullptr,nullptr);return out;}
static void select(){state.thumbnail={};state.selected=(int)SendMessage(state.list,LB_GETCURSEL,0,0);state.error.clear();if(state.selected>=0&&(size_t)state.selected<get(state.catalog,"components").arr.size())try{const auto& row=get(state.catalog,"components").arr[state.selected];const auto path=get(row,"path").str;state.thumbnail=callSessionWithProgress("component_thumbnail",V::makeObj(),[path]{return parametricComponentThumbnail(path);});}catch(const std::exception& e){state.error=e.what();}InvalidateRect(state.window,nullptr,FALSE);}
static void refresh(){if(g_busy)throw std::runtime_error("Wait for the current model operation before loading library geometry");V args=V::makeObj();args.set("directory",V::makeStr(state.directory));args.set("query",V::makeStr(input(state.search)));const auto kind=(int)SendMessage(state.kind,CB_GETCURSEL,0,0);if(kind>0)args.set("kind",V::makeStr(kind==1?"part":"assembly"));state.catalog=callSessionWithProgress("component_library",args,[args]{return parametricComponentLibrary(args);});state.updating=true;SendMessage(state.list,LB_RESETCONTENT,0,0);for(const auto& row:get(state.catalog,"components").arr){const auto label=get(row,"name").str+"  /  r"+std::to_string((int)get(row,"revision").num)+"  /  "+get(row,"category").str;SendMessageW(state.list,LB_ADDSTRING,0,(LPARAM)bomWide(label).c_str());}state.updating=false;if(!get(state.catalog,"components").arr.empty())SendMessage(state.list,LB_SETCURSEL,0,0);select();}
static void folder(){std::vector<EditorField> fields{{"Component library folder",state.directory}};if(!editFields("Open component library","Choose a local folder of .arkprt and .arktop recipes. Subfolders act as categories; search also matches public parameter names.",fields))return;state.directory=trimField(fields[0].value);refresh();}
static void prepare(bool update){if(g_busy)throw std::runtime_error("Wait for the current model operation");if(state.selected<0||(size_t)state.selected>=get(state.catalog,"components").arr.size())throw std::runtime_error("Select a component first");const V row=get(state.catalog,"components").arr[state.selected];const u64 revision=g_session.revision,epoch=g_documentEpoch;
    std::vector<std::string> installed;for(const auto& entry:g_doc.parametricComponents.arr)if(!update||get(get(entry,"package"),"component_id").str==get(row,"component_id").str)installed.push_back(get(entry,"namespace").str);
    if(update&&installed.empty())throw std::runtime_error("This component identity is not installed in the project");
    std::vector<EditorField> fields{{"Namespace",update?installed.front():"component",false,installed},{"Public parameter overrides (JSON)","{}"}};
    if(!editFields(update?"Review component update":"Insert library component","Only declared public parameters can be overridden. The chosen file is pinned by its reviewed digest.",fields))return;
    if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Project changed; prepare again");V overrides;if(!arkjson::parse(fields[1].value,overrides)||overrides.t!=V::Obj)throw std::runtime_error("Overrides must be a numeric JSON object");
    // Refuse a changed file instead of silently choosing a new catalog revision.
    if(parametricComponentHash(loadParametricComponent(get(row,"path").str))!=get(row,"sha256").str)throw std::runtime_error("Library file changed; refresh the catalog before preparing");
    V args=V::makeObj();args.set("action",V::makeStr("prepare"));args.set("mode",V::makeStr(update?"update":"insert"));args.set("path",get(row,"path"));args.set("expected_source_sha256",get(row,"sha256"));args.set("namespace",V::makeStr(trimField(fields[0].value)));args.set("overrides",overrides);args.set("expected_revision",V::makeNum((double)revision));auto response=runTool("parametric_components",args);if(g_error)return;const auto candidate=get(response,"structuredContent");if(!candidate.find("candidate_id"))throw std::runtime_error("Exact component preview returned no candidate");
    std::vector<EditorField> review{{"Checked candidate",containerReviewText(candidate)}};if(!editFields("Review exact component candidate","Apply this checked revision to the current project. Other installed copies keep their pinned revision.",review,true,"Apply",nullptr,true))return;
    if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Project changed during review; prepare again");V apply=V::makeObj();apply.set("candidate_id",get(candidate,"candidate_id"));apply.set("expected_revision",V::makeNum((double)revision));runTool("doc_apply",apply);if(!g_error){frameScene();g_status="Library component applied / exact reviewed candidate";}
}
static void layout(){RECT r{};GetClientRect(state.window,&r);MoveWindow(state.search,22,76,std::max(200L,r.right-410),29,TRUE);MoveWindow(state.kind,r.right-370,76,140,200,TRUE);MoveWindow(GetDlgItem(state.window,3),r.right-214,76,90,29,TRUE);MoveWindow(GetDlgItem(state.window,4),r.right-116,76,94,29,TRUE);const int left=std::max(300L,r.right*45/100);MoveWindow(state.list,22,122,left-32,r.bottom-196,TRUE);MoveWindow(GetDlgItem(state.window,5),left+20,r.bottom-60,170,34,TRUE);MoveWindow(GetDlgItem(state.window,6),left+204,r.bottom-60,180,34,TRUE);InvalidateRect(state.window,nullptr,FALSE);}
static void paint(HDC dc){RECT r{};GetClientRect(state.window,&r);bomFill(dc,r,bomBg);bomLabel(dc,L"Parametric component library",{22,14,r.right-22,45},state.title,bomWhite);bomLabel(dc,bomWide(state.directory),{22,46,r.right-22,69},state.font,bomMuted);const int left=std::max(300L,r.right*45/100);RECT preview{left+20,122,r.right-22,std::min(r.bottom-175,430L)};bomFill(dc,preview,bomPanelBg,8);
    const auto& lines=get(state.thumbnail,"lines");if(!lines.arr.empty()){auto pen=CreatePen(PS_SOLID,1,RGB(188,197,207));auto old=SelectObject(dc,pen);const double scale=std::min(preview.right-preview.left,preview.bottom-preview.top)/256.;const double x=(preview.left+preview.right)/2.-128*scale,y=(preview.top+preview.bottom)/2.-128*scale;for(const auto& line:lines.arr){MoveToEx(dc,(int)(x+line.arr[0].num*scale),(int)(y+line.arr[1].num*scale),nullptr);LineTo(dc,(int)(x+line.arr[2].num*scale),(int)(y+line.arr[3].num*scale));}SelectObject(dc,old);DeleteObject(pen);}
    if(state.selected>=0&&(size_t)state.selected<get(state.catalog,"components").arr.size()){const auto& row=get(state.catalog,"components").arr[state.selected];std::string description=get(row,"name").str+" / "+get(row,"kind").str+" / revision "+std::to_string((int)get(row,"revision").num)+"\nCategory: "+get(row,"category").str+"\nPublic parameters: ";for(const auto& p:get(row,"parameters").arr)description+=p.str+"  ";description+="\n"+get(row,"parameter_expressions").dump();bomLabel(dc,bomWide(description),{left+20,preview.bottom+10,r.right-22,r.bottom-70},state.font,bomWhite,DT_LEFT|DT_WORDBREAK);}
    const auto count=get(state.catalog,"components").arr.size(),rejected=get(state.catalog,"rejected").arr.size();std::string status=state.error.empty()?std::to_string(count)+" components / "+std::to_string(rejected)+" rejected files"+(get(state.catalog,"truncated").b?" / scan limit reached; narrow the folder":""):state.error;bomLabel(dc,bomWide(status),{22,r.bottom-66,left-12,r.bottom-12},state.font,state.error.empty()?bomMuted:bomAmber,DT_LEFT|DT_WORDBREAK);
}
static LRESULT CALLBACK procedure(HWND w,UINT m,WPARAM wp,LPARAM lp){
    if(m==WM_CREATE){state.window=w;state.font=CreateFontW(-14,0,0,0,FW_NORMAL,0,0,0,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");state.title=CreateFontW(-23,0,0,0,FW_SEMIBOLD,0,0,0,DEFAULT_CHARSET,0,0,CLEARTYPE_QUALITY,0,L"Segoe UI");auto control=[&](const wchar_t* cls,const wchar_t* title,DWORD style,int id){auto child=CreateWindowExW(WS_EX_CLIENTEDGE,cls,title,WS_CHILD|WS_VISIBLE|WS_TABSTOP|style,0,0,100,30,w,(HMENU)(INT_PTR)id,GetModuleHandle(nullptr),nullptr);SendMessage(child,WM_SETFONT,(WPARAM)state.font,TRUE);return child;};state.search=control(L"EDIT",L"",ES_AUTOHSCROLL,1);SendMessageW(state.search,EM_SETCUEBANNER,TRUE,(LPARAM)L"Name, category or public parameter...");state.kind=control(L"COMBOBOX",L"",CBS_DROPDOWNLIST,2);for(const auto* label:{L"All kinds",L"Parts",L"Assemblies"})SendMessageW(state.kind,CB_ADDSTRING,0,(LPARAM)label);SendMessage(state.kind,CB_SETCURSEL,0,0);control(L"BUTTON",L"Search",BS_PUSHBUTTON,3);control(L"BUTTON",L"Folder...",BS_PUSHBUTTON,4);control(L"BUTTON",L"Insert preview...",BS_PUSHBUTTON,5);control(L"BUTTON",L"Update preview...",BS_PUSHBUTTON,6);state.list=control(L"LISTBOX",L"",LBS_NOTIFY|WS_VSCROLL|LBS_NOINTEGRALHEIGHT,7);return 0;}
    if(m==WM_SIZE){layout();return 0;}if(m==WM_GETMINMAXINFO){((MINMAXINFO*)lp)->ptMinTrackSize={960,640};return 0;}
    if(m==WM_PAINT){PAINTSTRUCT p{};auto dc=BeginPaint(w,&p);paint(dc);EndPaint(w,&p);return 0;}if(m==WM_PRINTCLIENT){paint((HDC)wp);return 0;}
    if(m==WM_COMMAND){try{const int id=LOWORD(wp);if(id==3||(id==2&&HIWORD(wp)==CBN_SELCHANGE))refresh();else if(id==4)folder();else if(id==5)prepare(false);else if(id==6)prepare(true);else if(id==7&&HIWORD(wp)==LBN_SELCHANGE&&!state.updating)select();}catch(const std::exception& e){state.error=e.what();InvalidateRect(w,nullptr,FALSE);}return 0;}
    if(m==WM_CLOSE){DestroyWindow(w);return 0;}if(m==WM_DESTROY){DeleteObject(state.font);DeleteObject(state.title);state.window=nullptr;return 0;}return DefWindowProcW(w,m,wp,lp);
}
static void open(){if(state.window){ShowWindow(state.window,SW_RESTORE);SetForegroundWindow(state.window);return;}if(g_busy)throw std::runtime_error("Wait for the current model operation");if(state.directory.empty()){wchar_t documents[MAX_PATH]{};SHGetFolderPathW(nullptr,CSIDL_PERSONAL,nullptr,SHGFP_TYPE_CURRENT,documents);const auto bytes=std::filesystem::path(documents).u8string();state.directory=std::string(bytes.begin(),bytes.end())+"/ARK/Components";}
