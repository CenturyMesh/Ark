static void selectTangentFaces(){
    using V=arkjson::Value;auto selected=std::find_if(g_picked.rbegin(),g_picked.rend(),[](const SelectionItem& item){return item.kind=="face"&&item.feature;});if(selected==g_picked.rend())throw std::runtime_error("Select an exact named face before expanding its tangent patch");const SelectionItem seed=*selected;const u64 revision=g_session.revision,epoch=g_documentEpoch;int body=-1;for(size_t i=0;i<g_bodyIds.size();++i)if(g_bodyIds[i]==seed.feature&&(!seed.instance||(g_instanceIds[i]==seed.instance&&g_instanceCopies[i]==seed.copy))){body=(int)i;break;}if(body<0)throw std::runtime_error("Selected face is hidden or no longer displayed");const auto& pick=g_partPicks[g_instancePart[(size_t)body]];auto sourceFace=pick.faceReferences.find(seed.name);if(sourceFace==pick.faceReferences.end())throw std::runtime_error("Selected face no longer has an exact span");
    V args=V::makeObj();args.set("id",V::makeNum((double)seed.feature));args.set("reference",V::makeStr(seed.name));args.set("kind",V::makeStr("face"));auto result=g_session.call("reference_navigate",args);if(result.find("isError")->b)throw std::runtime_error(result.find("structuredContent")->find("error")->asStr());const auto* neighbors=result.find("structuredContent")->find("neighbors");if(!neighbors||neighbors->t!=V::Arr)throw std::runtime_error("Exact adjacency inspection failed");const auto& mesh=g_cpuMeshes[g_instancePart[(size_t)body]];
    using Point=std::array<long long,3>;using Edge=std::pair<Point,Point>;auto point=[&](u32 index){auto p=directMeshPoint(mesh,index);return Point{std::llround(p.x*1e5),std::llround(p.y*1e5),std::llround(p.z*1e5)};};auto boundaries=[&](int face){std::map<Edge,std::vector<Vec3>> edges;auto span=pick.faces[(size_t)face];for(int t=span.first;t<span.first+span.second;++t)for(int k=0;k<3;++k){auto a=point(mesh.idx[(size_t)t*3+k]),b=point(mesh.idx[(size_t)t*3+(k+1)%3]);if(b<a)std::swap(a,b);edges[{a,b}].push_back(directTriangleNormal(mesh,(u32)t));}for(auto i=edges.begin();i!=edges.end();)if(i->second.size()!=1)i=edges.erase(i);else ++i;return edges;};const auto seedEdges=boundaries(sourceFace->second);unsigned added=0;std::set<int> faces{sourceFace->second};
    for(const auto& row:neighbors->arr){if(added>=12)break;auto* kind=row.find("kind"),*name=row.find("reference");if(!kind||kind->asStr()!="face"||!name)continue;auto found=pick.faceReferences.find(name->asStr());if(found==pick.faceReferences.end()||faces.count(found->second))continue;auto adjacentEdges=boundaries(found->second);size_t contacts=0;bool tangent=true;for(const auto& edge:seedEdges)if(auto other=adjacentEdges.find(edge.first);other!=adjacentEdges.end()){++contacts;if(edge.second.front().dot(other->second.front())<std::cos(deg2rad(8.)))tangent=false;}if(!contacts||!tangent)continue;SelectionItem item=seed;item.name=name->asStr();g_picked.push_back(item);faces.insert(found->second);++added;}
    if(revision!=g_session.revision||epoch!=g_documentEpoch)throw std::runtime_error("Drawing changed during adjacency inspection");refreshSelectionLines();g_status="Tangent patch: "+std::to_string(added)+" adjacent exact faces added / one ring, maximum 12 / sampled boundary normals within 8 degrees";
}
