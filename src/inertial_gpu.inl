    out.diagnostics=V::makeObj();out.diagnostics.set("backend",V::makeStr("D3D11 hardware compute / float32"));out.diagnostics.set("adapter",V::makeStr(g.adapter));out.diagnostics.set("gpu_mesh_cache_hit",V::makeBool(hit));out.diagnostics.set("gpu_mesh_uploaded_bytes",V::makeNum((double)uploaded));out.diagnostics.set("gpu_mesh_resident_bytes",V::makeNum((double)g.meshBytes));out.diagnostics.set("dispatches",V::makeNum(dispatches));out.diagnostics.set("steps",V::makeNum(steps));out.diagnostics.set("transfer_inclusive_ms",V::makeNum(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-started).count()));return out;
}
