};
Gpu& gpu(){static Gpu instance;return instance;}
InertialResult runGpu(const std::vector<InertialShape>& shapes,const std::vector<InertialBody>& initial,const std::vector<InertialJoint>& joints,const InertialOptions& options){
    auto started=std::chrono::steady_clock::now();auto control=captureNativeRequestControl();auto& g=gpu();std::unique_lock lock(g.mutex,std::defer_lock);while(!lock.try_lock()){if(control.cancelled&&control.cancelled())throw std::runtime_error("NATIVE_CANCELLED: GPU simulation cancelled while queued");std::this_thread::sleep_for(std::chrono::milliseconds(5));}g.init();
    std::vector<F4> mesh;std::vector<U4> ranges,edges;for(auto& shape:shapes){U4 r;r.x=(unsigned)mesh.size();r.y=(unsigned)shape.vertices.size();for(auto v:shape.vertices)mesh.push_back(f4(v));r.z=(unsigned)mesh.size();r.w=(unsigned)shape.normals.size();for(auto n:shape.normals)mesh.push_back(f4(n));ranges.push_back(r);U4 edgeRange{(unsigned)mesh.size(),(unsigned)shape.edges.size(),0,0};for(auto e:shape.edges)mesh.push_back(f4(e));edgeRange.z=(unsigned)mesh.size();edgeRange.w=(unsigned)shape.segments.size();for(auto e:shape.segments)mesh.push_back({(float)e[0],(float)e[1],0,0});edges.push_back(edgeRange);}
    std::string bytes((char*)mesh.data(),mesh.size()*sizeof(F4));std::string key=iterationSha256(bytes);bool hit=g.meshKey==key;size_t uploaded=hit?0:bytes.size();if(!hit){g.mesh=g.buffer(bytes.size(),sizeof(F4),bytes.data(),false);g.meshKey=key;g.meshBytes=bytes.size();}
    std::vector<GBody> packed;for(auto& b:initial){GBody p;p.p=f4(b.position,invMass(b));p.q={(float)b.orientation[0],(float)b.orientation[1],(float)b.orientation[2],(float)b.orientation[3]};p.v=f4(b.velocity,b.mass);p.w=f4(b.omega);auto inv=inverse(b.inertia);p.i0=f4({b.inertia[0],b.inertia[1],b.inertia[2]});p.i1=f4({b.inertia[3],b.inertia[4],b.inertia[5]});p.i2=f4({b.inertia[6],b.inertia[7],b.inertia[8]});p.inv0=f4({inv[0],inv[1],inv[2]});p.inv1=f4({inv[3],inv[4],inv[5]});p.inv2=f4({inv[6],inv[7],inv[8]});p.force=f4(b.force);p.torque=f4(b.torque);p.shape=ranges[b.shape];p.edges=edges[b.shape];packed.push_back(p);}
    std::vector<GJoint> links;for(auto& j:joints)links.push_back({{(unsigned)j.a,(unsigned)j.b,j.hinge?1u:0u,0},f4(j.anchorA),f4(j.anchorB),f4(j.axisA),f4(j.axisB)});if(links.empty())links.emplace_back();
    GBuffer states[]{g.buffer(packed.size()*sizeof(GBody),sizeof(GBody),packed.data(),true),g.buffer(packed.size()*sizeof(GBody),sizeof(GBody),nullptr,true)};
    auto contacts=g.buffer(initial.size()*(initial.size()+1)*sizeof(GContact),sizeof(GContact),nullptr,true),jointBuffer=g.buffer(links.size()*sizeof(GJoint),sizeof(GJoint),links.data(),false);
    unsigned zero=0;g.failure=g.buffer(sizeof zero,sizeof zero,&zero,true);D3D11_BUFFER_DESC sd{};sd.ByteWidth=(UINT)(packed.size()*sizeof(GBody));sd.Usage=D3D11_USAGE_STAGING;sd.CPUAccessFlags=D3D11_CPU_ACCESS_READ;Com<ID3D11Buffer> readback;checked(g.device->CreateBuffer(&sd,nullptr,readback.put()),"readback");D3D11_BUFFER_DESC fd=sd;fd.ByteWidth=sizeof zero;Com<ID3D11Buffer> failureReadback;checked(g.device->CreateBuffer(&fd,nullptr,failureReadback.put()),"failure readback");
    InertialResult out;out.frames.push_back(initial);out.times.push_back(0);unsigned current=0,steps=0,dispatches=0;double time=0;size_t frames=(size_t)std::ceil(options.duration*options.outputFps);
    GConfig config;config.count=(unsigned)initial.size();config.jointCount=(unsigned)joints.size();config.contacts=options.contacts;config.ground=options.ground;config.restitution=(float)options.restitution;config.friction=(float)options.friction;config.groundZ=(float)options.groundZ;config.gravity=f4(options.gravity);
    for(size_t sample=1;sample<=frames;++sample){double target=std::min(options.duration,(double)sample/options.outputFps);while(time<target-1e-12){if(control.cancelled&&control.cancelled())throw std::runtime_error("NATIVE_CANCELLED: GPU simulation cancelled");double dt=std::min(options.step,target-time);config.dt=(float)dt;g.context->UpdateSubresource(g.constants.p,0,nullptr,&config,0,0);g.dispatch(g.integrateShader.p,states[current],&states[1-current],contacts,jointBuffer,config.count,64,false);current=1-current;++dispatches;
            if(options.ground||options.contacts||!joints.empty()){g.dispatch(g.collideShader.p,states[current],nullptr,contacts,jointBuffer,config.count*(config.count+1),32,true);++dispatches;for(unsigned it=0;it<options.iterations;++it){g.dispatch(g.solveShader.p,states[current],&states[1-current],contacts,jointBuffer,config.count,64,false);current=1-current;++dispatches;}}
            time+=dt;++steps;}
        g.context->CopyResource(readback.p,states[current].buffer.p);D3D11_MAPPED_SUBRESOURCE mapped{};checked(g.context->Map(readback.p,0,D3D11_MAP_READ,0,&mapped),"synchronized readback");std::memcpy(packed.data(),mapped.pData,sd.ByteWidth);g.context->Unmap(readback.p,0);auto frame=initial;for(size_t i=0;i<frame.size();++i){auto& b=frame[i];auto& p=packed[i];b.position=v3(p.p);b.velocity=v3(p.v);b.omega=v3(p.w);b.orientation=normalized({p.q.x,p.q.y,p.q.z,p.q.w});require(finite(b.position)&&finite(b.velocity)&&finite(b.omega),"GPU solver became nonfinite; reduce time step/check inputs");}out.frames.push_back(std::move(frame));out.times.push_back(time);
    }
