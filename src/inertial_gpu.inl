namespace inertial {
template<class T> struct Com {T* p=nullptr;~Com(){if(p)p->Release();}Com()=default;Com(const Com&)=delete;Com& operator=(const Com&)=delete;Com(Com&& o)noexcept:p(o.p){o.p=nullptr;}Com& operator=(Com&& o)noexcept{if(this!=&o){if(p)p->Release();p=o.p;o.p=nullptr;}return *this;}T** put(){if(p){p->Release();p=nullptr;}return &p;}T* operator->()const{return p;}};
void checked(HRESULT hr,const char* what){require(SUCCEEDED(hr),std::string("GPU ")+what+" failed ("+std::to_string((unsigned long)hr)+")");}
struct F4 {float x=0,y=0,z=0,w=0;};struct U4{unsigned x=0,y=0,z=0,w=0;};
F4 f4(Vec3 p,double w=0){return {(float)p.x,(float)p.y,(float)p.z,(float)w};}Vec3 v3(F4 p){return {p.x,p.y,p.z};}
struct GBody {F4 p,q,v,w,i0,i1,i2,inv0,inv1,inv2,force,torque;U4 shape,edges;};
struct GContact{F4 normalDepth,pointTarget;};struct GJoint{U4 ids;F4 anchorA,anchorB,axisA,axisB;};
struct GConfig{unsigned count=0,jointCount=0,contacts=0,ground=0;float dt=0,restitution=0,friction=0,groundZ=0;F4 gravity;};
static_assert(sizeof(GBody)==224&&sizeof(GJoint)==80&&sizeof(GConfig)==48);
struct GBuffer {Com<ID3D11Buffer> buffer;Com<ID3D11ShaderResourceView> srv;Com<ID3D11UnorderedAccessView> uav;};
#include "inertial_gpu_shader.inl"
struct Gpu {
    std::mutex mutex;Com<ID3D11Device> device;Com<ID3D11DeviceContext> context;Com<ID3D11ComputeShader> integrateShader,collideShader,solveShader;Com<ID3D11Buffer> constants;
    GBuffer mesh,failure;std::string meshKey,adapter,reason;size_t meshBytes=0;bool tried=false;
    void init(){if(device.p&&context.p&&integrateShader.p&&collideShader.p&&solveShader.p&&constants.p)return;if(tried)throw std::runtime_error(reason);tried=true;try{
        D3D_FEATURE_LEVEL required=D3D_FEATURE_LEVEL_11_0,actual;checked(D3D11CreateDevice(nullptr,D3D_DRIVER_TYPE_HARDWARE,nullptr,0,&required,1,D3D11_SDK_VERSION,device.put(),&actual,context.put()),"hardware device creation");
        Com<IDXGIDevice> dxgi;checked(device->QueryInterface(__uuidof(IDXGIDevice),reinterpret_cast<void**>(dxgi.put())),"adapter query");Com<IDXGIAdapter> a;checked(dxgi->GetAdapter(a.put()),"adapter");DXGI_ADAPTER_DESC desc{};checked(a->GetDesc(&desc),"adapter description");for(auto ch:desc.Description){if(!ch)break;adapter.push_back(ch<128?(char)ch:'?');}
        auto shader=[&](const char* entry,Com<ID3D11ComputeShader>& output){Com<ID3DBlob> code,errors;HRESULT hr=D3DCompile(inertialShader,std::strlen(inertialShader),"ARK inertial 056C",nullptr,nullptr,entry,"cs_5_0",D3DCOMPILE_ENABLE_STRICTNESS|D3DCOMPILE_OPTIMIZATION_LEVEL3,0,code.put(),errors.put());if(FAILED(hr))throw std::runtime_error("GPU shader "+std::string(entry)+": "+(errors.p?std::string((char*)errors->GetBufferPointer(),errors->GetBufferSize()):"compile failed"));checked(device->CreateComputeShader(code->GetBufferPointer(),code->GetBufferSize(),nullptr,output.put()),"shader creation");};shader("integrate",integrateShader);shader("collide",collideShader);shader("solve",solveShader);
        D3D11_BUFFER_DESC cb{};cb.ByteWidth=sizeof(GConfig);cb.Usage=D3D11_USAGE_DEFAULT;cb.BindFlags=D3D11_BIND_CONSTANT_BUFFER;checked(device->CreateBuffer(&cb,nullptr,constants.put()),"constant buffer");reason.clear();
