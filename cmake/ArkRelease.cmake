# One source of truth for the human iteration and numeric runtime version.
function(ark_read_release_metadata release_file)
  if(NOT EXISTS "${release_file}")
    message(FATAL_ERROR "ARK release metadata is missing: ${release_file}")
  endif()
  file(READ "${release_file}" metadata)
  foreach(field sequence phase code version)
    string(JSON value_type ERROR_VARIABLE type_error TYPE "${metadata}" "${field}")
    if(NOT type_error STREQUAL "NOTFOUND")
      message(FATAL_ERROR "ARK release metadata: invalid or missing ${field}: ${type_error}")
    endif()
    if(field STREQUAL "sequence")
      if(NOT value_type STREQUAL "NUMBER")
        message(FATAL_ERROR "ARK release sequence must be an integer from 1 to 999")
      endif()
    elseif(NOT value_type STREQUAL "STRING")
      message(FATAL_ERROR "ARK release ${field} must be a string")
    endif()
    string(JSON release_${field} GET "${metadata}" "${field}")
  endforeach()
  if(NOT release_sequence MATCHES "^[1-9][0-9]?[0-9]?$")
    message(FATAL_ERROR "ARK release sequence must be an integer from 1 to 999")
  endif()
  if(NOT release_phase MATCHES "^[A-G]$")
    message(FATAL_ERROR "ARK release phase must be one letter A through G")
  endif()
  set(padded_sequence "00${release_sequence}")
  string(LENGTH "${padded_sequence}" padded_length)
  math(EXPR padded_start "${padded_length} - 3")
  string(SUBSTRING "${padded_sequence}" ${padded_start} 3 padded_sequence)
  if(NOT release_code STREQUAL "${padded_sequence}${release_phase}")
    message(FATAL_ERROR "ARK release code must equal the global three-digit sequence plus phase: ${padded_sequence}${release_phase}")
  endif()
  if(NOT release_version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "ARK runtime version must be numeric major.minor.patch without leading zeroes")
  endif()
  string(REPLACE "." ";" components "${release_version}")
  foreach(component IN LISTS components)
    string(LENGTH "${component}" component_length)
    if(component_length GREATER 5 OR component GREATER 65535)
      message(FATAL_ERROR "ARK runtime version components must fit Windows FILEVERSION (0..65535)")
    endif()
  endforeach()
  set(milestones "[]")
  string(JSON milestone_type ERROR_VARIABLE milestone_error TYPE "${metadata}" milestones)
  if(milestone_error STREQUAL "NOTFOUND")
    if(NOT milestone_type STREQUAL "ARRAY")
      message(FATAL_ERROR "ARK release milestones must be an array of roadmap IDs")
    endif()
    string(JSON milestones GET "${metadata}" milestones)
    string(JSON milestone_count LENGTH "${milestones}")
    if(milestone_count GREATER 0)
      math(EXPR milestone_last "${milestone_count}-1")
      foreach(index RANGE ${milestone_last})
        string(JSON milestone TYPE "${milestones}" ${index})
        string(JSON milestone_value GET "${milestones}" ${index})
        if(NOT milestone STREQUAL "STRING" OR NOT milestone_value MATCHES "^[A-G]\\.[0-9][0-9]$")
          message(FATAL_ERROR "ARK release milestone IDs must use roadmap notation such as A.01")
        endif()
      endforeach()
    endif()
  endif()
  set(ARK_RELEASE_MILESTONES "${milestones}" PARENT_SCOPE)
  set(ARK_RELEASE_SEQUENCE "${release_sequence}" PARENT_SCOPE)
  set(ARK_RELEASE_PHASE "${release_phase}" PARENT_SCOPE)
  set(ARK_ITERATION_CODE "${release_code}" PARENT_SCOPE)
  set(ARK_RELEASE_VERSION "${release_version}" PARENT_SCOPE)
endfunction()
