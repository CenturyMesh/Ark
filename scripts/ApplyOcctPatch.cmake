cmake_minimum_required(VERSION 3.21)
# Source-byte verification only. This does not qualify geometry or attest DLLs.
if(NOT DEFINED ARK_OCCT_PATCHSET)
  set(ARK_OCCT_PATCHSET "${CMAKE_CURRENT_LIST_DIR}/../third_party/occt/patches/8.0.1/patchset.json")
endif()
if(NOT DEFINED ARK_OCCT_MODE)
  set(ARK_OCCT_MODE APPLY)
endif()
if(NOT EXISTS "${ARK_OCCT_PATCHSET}")
  message(FATAL_ERROR "Required OCCT patchset manifest is missing")
endif()
file(REAL_PATH "${ARK_OCCT_PATCHSET}" ARK_OCCT_PATCHSET)
file(READ "${ARK_OCCT_PATCHSET}" definition)
file(SHA256 "${ARK_OCCT_PATCHSET}" definition_hash)
get_filename_component(patch_directory "${ARK_OCCT_PATCHSET}" DIRECTORY)
get_filename_component(patch_parent "${patch_directory}" DIRECTORY)
string(JSON schema GET "${definition}" schema)
string(JSON patchset GET "${definition}" id)
string(JSON status GET "${definition}" status)
string(JSON archive_hash GET "${definition}" archive_sha256)
string(JSON patch_count LENGTH "${definition}" patches)
if(NOT schema STREQUAL "ark.occt-patchset.v1" OR NOT patchset MATCHES "^ark-[a-z0-9-]+$")
  message(FATAL_ERROR "Invalid OCCT patchset definition")
endif()
if(DEFINED ARK_OCCT_EXPECTED_PATCHSET AND NOT patchset STREQUAL ARK_OCCT_EXPECTED_PATCHSET)
  message(FATAL_ERROR "Patchset ID differs from the selected source/build/install suffix")
endif()
if(DEFINED ARK_OCCT_EXPECTED_ARCHIVE_SHA256 AND NOT archive_hash STREQUAL ARK_OCCT_EXPECTED_ARCHIVE_SHA256)
  message(FATAL_ERROR "Patchset archive digest differs from the pinned SDK archive")
endif()
if(patch_count LESS 1)
  message(FATAL_ERROR "OCCT ${patchset} is ${status}: no frozen native patches; SDK build/package use is blocked")
endif()
math(EXPR last_patch "${patch_count}-1")
find_program(git_program git REQUIRED)
set(all_declared_targets)
foreach(index RANGE 0 ${last_patch})
  foreach(field file sha256)
    string(JSON patch_${index}_${field} GET "${definition}" patches ${index} ${field})
  endforeach()
  if(NOT patch_${index}_file MATCHES "^[A-Za-z0-9_.-]+[.]patch$")
    message(FATAL_ERROR "Invalid OCCT patch path")
  endif()
  file(SHA256 "${patch_directory}/${patch_${index}_file}" observed_patch)
  if(NOT observed_patch STREQUAL patch_${index}_sha256)
    message(FATAL_ERROR "OCCT patch SHA-256 mismatch: ${patch_${index}_file}")
  endif()
  string(JSON target_count LENGTH "${definition}" patches ${index} targets)
  if(target_count LESS 1)
    message(FATAL_ERROR "Every OCCT patch needs exact target-file hashes")
  endif()
  math(EXPR patch_${index}_last_target "${target_count}-1")
  set(declared_targets)
  foreach(target RANGE 0 ${patch_${index}_last_target})
    foreach(field path source_sha256 patched_sha256)
      string(JSON patch_${index}_${target}_${field} GET "${definition}" patches ${index} targets ${target} ${field})
    endforeach()
    if(patch_${index}_${target}_path MATCHES "(^|/)\.\.(/|$)" OR IS_ABSOLUTE "${patch_${index}_${target}_path}")
      message(FATAL_ERROR "Invalid OCCT patch target path")
    endif()
    if(NOT patch_${index}_${target}_path MATCHES "^[A-Za-z0-9_./-]+$")
      message(FATAL_ERROR "Unsupported OCCT target path characters")
    endif()
    if(patch_${index}_${target}_path IN_LIST all_declared_targets)
      message(FATAL_ERROR "OCCT target occurs more than once; combine its edits into one frozen patch")
    endif()
    list(APPEND all_declared_targets "${patch_${index}_${target}_path}")
    list(APPEND declared_targets "${patch_${index}_${target}_path}")
  endforeach()
  # git apply otherwise filters paths relative to an enclosing repository's
  # current subdirectory (e.g. CTest's out/core working directory).
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE "GIT_CEILING_DIRECTORIES=${patch_parent}" "${git_program}" apply --numstat "${patch_directory}/${patch_${index}_file}" WORKING_DIRECTORY "${patch_directory}" OUTPUT_VARIABLE patch_stat ERROR_VARIABLE patch_stat_error RESULT_VARIABLE patch_stat_code)
  if(NOT patch_stat_code EQUAL 0)
    message(FATAL_ERROR "Cannot inspect OCCT patch paths: ${patch_stat_error}")
  endif()
  string(REPLACE "\n" ";" patch_stat "${patch_stat}")
  set(observed_targets)
  foreach(stat_line IN LISTS patch_stat)
    if(stat_line STREQUAL "")
      continue()
    endif()
    if(NOT stat_line MATCHES "^[0-9-]+\t[0-9-]+\t([A-Za-z0-9_./-]+)$")
      message(FATAL_ERROR "Unsupported OCCT patch path or format")
    endif()
    list(APPEND observed_targets "${CMAKE_MATCH_1}")
  endforeach()
  list(SORT declared_targets)
  list(SORT observed_targets)
  if(NOT observed_targets STREQUAL declared_targets)
    message(FATAL_ERROR "OCCT patch paths differ from the complete declared target list")
  endif()
endforeach()
if((ARK_OCCT_MODE STREQUAL "BUILD_POLICY" OR ARK_OCCT_MODE STREQUAL "RECORD_BUILD" OR ARK_OCCT_MODE STREQUAL "VERIFY_INSTALLED" OR ARK_OCCT_MODE STREQUAL "VERIFY_RUNTIME" OR ARK_OCCT_MODE STREQUAL "NOTICE") AND NOT status STREQUAL "verified-in-scope" AND NOT ARK_OCCT_ALLOW_CANDIDATE)
  message(FATAL_ERROR "OCCT patchset is ${status}; public build/package use is blocked. Candidate SDK preparation requires an explicit local-test opt-in.")
endif()

# Bind every installed shared library, including TKGeomBase and dependency
# toolkits. This is an executed-build declaration, not independent attestation.
function(ark_occt_libraries root output)
  file(GLOB_RECURSE candidates LIST_DIRECTORIES FALSE "${root}/*.dll" "${root}/lib/*.so*")
  set(libraries)
  foreach(candidate IN LISTS candidates)
    get_filename_component(name "${candidate}" NAME)
    if(name MATCHES "^((lib)?TK[A-Za-z0-9_]+[.]dll|libTK[A-Za-z0-9_]+[.]so([.][0-9]+)*)$" AND NOT IS_SYMLINK "${candidate}")
      list(APPEND libraries "${candidate}")
    endif()
  endforeach()
  list(SORT libraries)
  if(NOT libraries)
    message(FATAL_ERROR "No OCCT shared libraries found in the selected SDK/runtime")
  endif()
  set(${output} "${libraries}" PARENT_SCOPE)
endfunction()

if(ARK_OCCT_MODE STREQUAL "RECORD_BUILD" OR ARK_OCCT_MODE STREQUAL "VERIFY_INSTALLED" OR ARK_OCCT_MODE STREQUAL "VERIFY_RUNTIME" OR (ARK_OCCT_MODE STREQUAL "NOTICE" AND ARK_OCCT_INSTALL))
  file(SHA256 "${ARK_OCCT_INSTALL}/.ark-occt-patchset.json" installed_hash)
  if(NOT installed_hash STREQUAL definition_hash)
    message(FATAL_ERROR "SDK patchset stamp differs; do not substitute the original or another SDK")
  endif()
  ark_occt_libraries("${ARK_OCCT_INSTALL}" sdk_libraries)
  set(observed_library_json "[")
  set(separator "")
  set(sdk_names)
  foreach(library IN LISTS sdk_libraries)
    file(RELATIVE_PATH relative "${ARK_OCCT_INSTALL}" "${library}")
    get_filename_component(name "${library}" NAME)
    if(NOT relative MATCHES "^[A-Za-z0-9_./-]+$" OR name IN_LIST sdk_names)
      message(FATAL_ERROR "Ambiguous or unsupported SDK library path")
    endif()
    list(APPEND sdk_names "${name}")
    file(SHA256 "${library}" library_hash)
    string(APPEND observed_library_json "${separator}{\"path\":\"${relative}\",\"sha256\":\"${library_hash}\"}")
    set(separator ",")
  endforeach()
  string(APPEND observed_library_json "]")
  set(build_record "${ARK_OCCT_INSTALL}/.ark-occt-build.json")
  if(ARK_OCCT_MODE STREQUAL "RECORD_BUILD")
    if(NOT ARK_OCCT_BUILD_KIND STREQUAL "clean-source-rebuild" AND NOT ARK_OCCT_BUILD_KIND STREQUAL "local-sdk-overlay")
      message(FATAL_ERROR "RECORD_BUILD requires an explicit clean-source-rebuild or local-sdk-overlay build kind")
    endif()
    file(WRITE "${build_record}.tmp" "{\"schema\":\"ark.occt-sdk-build.v2\",\"kind\":\"${ARK_OCCT_BUILD_KIND}\",\"patchset\":\"${patchset}\",\"patchset_manifest_sha256\":\"${definition_hash}\",\"runtime_libraries\":${observed_library_json},\"scope\":\"Observed SDK shared-library bytes and declared build route; not independent compiler-input attestation or geometric qualification.\"}\n")
    file(RENAME "${build_record}.tmp" "${build_record}")
  else()
    file(READ "${build_record}" recorded_build)
    string(JSON recorded_schema GET "${recorded_build}" schema)
    string(JSON recorded_kind_type ERROR_VARIABLE kind_error TYPE "${recorded_build}" kind)
    if(kind_error OR NOT recorded_kind_type STREQUAL "STRING")
      message(FATAL_ERROR "SDK build declaration requires an explicit string kind")
    endif()
    string(JSON recorded_kind GET "${recorded_build}" kind)
    if(NOT recorded_kind STREQUAL "clean-source-rebuild" AND NOT recorded_kind STREQUAL "local-sdk-overlay")
      message(FATAL_ERROR "SDK build declaration kind must be clean-source-rebuild or local-sdk-overlay; no build route is inferred")
    endif()
    string(JSON recorded_manifest GET "${recorded_build}" patchset_manifest_sha256)
    string(JSON recorded_libraries GET "${recorded_build}" runtime_libraries)
    string(JSON observed_libraries GET "{\"libraries\":${observed_library_json}}" libraries)
    if(NOT recorded_schema STREQUAL "ark.occt-sdk-build.v2" OR NOT recorded_manifest STREQUAL definition_hash OR NOT recorded_libraries STREQUAL observed_libraries)
      message(FATAL_ERROR "SDK build inventory differs from its patchset or installed shared-library bytes")
    endif()
  endif()
  if(ARK_OCCT_MODE STREQUAL "VERIFY_RUNTIME")
    ark_occt_libraries("${ARK_OCCT_RUNTIME}" runtime_libraries)
    foreach(runtime_library IN LISTS runtime_libraries)
      get_filename_component(runtime_name "${runtime_library}" NAME)
      set(found FALSE)
      foreach(sdk_library IN LISTS sdk_libraries)
        get_filename_component(sdk_name "${sdk_library}" NAME)
        if(runtime_name STREQUAL sdk_name)
          file(SHA256 "${runtime_library}" runtime_hash)
          file(SHA256 "${sdk_library}" sdk_hash)
          if(NOT runtime_hash STREQUAL sdk_hash)
            message(FATAL_ERROR "Packaged/runtime OCCT library differs from the selected SDK: ${runtime_name}")
          endif()
          set(found TRUE)
        endif()
      endforeach()
      if(NOT found)
        message(FATAL_ERROR "Packaged/runtime OCCT library is absent from the selected SDK: ${runtime_name}")
      endif()
    endforeach()
  endif()
endif()
if(ARK_OCCT_MODE STREQUAL "BUILD_POLICY")
  # No extraction, source edits or SDK compilation in this policy check.
elseif(ARK_OCCT_MODE STREQUAL "RECORD_BUILD" OR ARK_OCCT_MODE STREQUAL "VERIFY_INSTALLED" OR ARK_OCCT_MODE STREQUAL "VERIFY_RUNTIME")
  # The shared-library inventory checks above are the complete mode operation.
elseif(ARK_OCCT_MODE STREQUAL "NOTICE")
  if(NOT ARK_OCCT_NOTICE)
    message(FATAL_ERROR "ARK_OCCT_NOTICE is required")
  endif()
  if(ARK_OCCT_INSTALL)
    file(SHA256 "${ARK_OCCT_INSTALL}/.ark-occt-patchset.json" installed_hash)
    if(NOT installed_hash STREQUAL definition_hash)
      message(FATAL_ERROR "Cannot package a different or unstamped OCCT patchset")
    endif()
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef notice_id)
  set(header "${ARK_OCCT_NOTICE}.${notice_id}.header")
  file(WRITE "${header}" "ARK modifications to Open CASCADE Technology 8.0.1\nPatchset: ${patchset}\n\nOCCT and these changes retain upstream LGPL 2.1 with OCCT exception terms.\nThe original LICENSE_LGPL_21.txt and OCCT_LGPL_EXCEPTION.txt accompany the libraries.\nCorresponding source: the pinned V8_0_1 archive plus the exact patches below.\nhttps://github.com/Open-Cascade-SAS/OCCT/archive/refs/tags/V8_0_1.zip\n\nThis source declaration does not attest a compiled binary or geometric qualification.\n\n${definition}\n")
  set(notice_parts "${header}")
  set(notice_temporaries "${header}")
  if(ARK_OCCT_INSTALL AND EXISTS "${ARK_OCCT_INSTALL}/.ark-occt-build.json")
    file(READ "${ARK_OCCT_INSTALL}/.ark-occt-build.json" build_provenance)
    file(APPEND "${header}" "\nSDK build declaration (not independent attestation):\n${build_provenance}\n")
  endif()
  foreach(index RANGE 0 ${last_patch})
    set(separator "${ARK_OCCT_NOTICE}.${notice_id}.${index}")
    file(WRITE "${separator}" "\n--- ${patch_${index}_file} / SHA-256 ${patch_${index}_sha256} ---\n")
    list(APPEND notice_parts "${separator}" "${patch_directory}/${patch_${index}_file}")
    list(APPEND notice_temporaries "${separator}")
  endforeach()
  # Preserve patch bytes, including LF on Windows; text-mode file(APPEND)
  # would otherwise change the digest of the distributed diff.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${notice_parts} OUTPUT_FILE "${ARK_OCCT_NOTICE}" RESULT_VARIABLE notice_result)
  file(REMOVE ${notice_temporaries})
  if(NOT notice_result EQUAL 0)
    message(FATAL_ERROR "Cannot write exact OCCT patch notice")
  endif()
elseif(ARK_OCCT_MODE STREQUAL "APPLY" OR ARK_OCCT_MODE STREQUAL "VERIFY")
  if(NOT IS_DIRECTORY "${ARK_OCCT_SOURCE}")
    message(FATAL_ERROR "ARK_OCCT_SOURCE must be a separate extracted source directory")
  endif()
  file(REAL_PATH "${ARK_OCCT_SOURCE}" source_root)
  get_filename_component(source_parent "${source_root}" DIRECTORY)
  set(stamp "${source_root}/.ark-occt-patchset.json")
  if(EXISTS "${stamp}")
    file(SHA256 "${stamp}" source_stamp_hash)
    if(NOT source_stamp_hash STREQUAL definition_hash)
      message(FATAL_ERROR "Existing source stamp differs; use a new patchset/source directory")
    endif()
  endif()
  # Validate every input before mutating any target. There is no fuzzy patch,
  # three-way merge, fallback SDK or overwrite of an unexpected source state.
  foreach(index RANGE 0 ${last_patch})
    set(original_${index} TRUE)
    set(patched_${index} TRUE)
    foreach(target RANGE 0 ${patch_${index}_last_target})
      file(REAL_PATH "${source_root}/${patch_${index}_${target}_path}" target_${index}_${target})
      cmake_path(IS_PREFIX source_root "${target_${index}_${target}}" NORMALIZE inside)
      if(NOT inside)
        message(FATAL_ERROR "OCCT patch target escapes the selected source")
      endif()
      file(SHA256 "${target_${index}_${target}}" target_hash)
      if(NOT target_hash STREQUAL patch_${index}_${target}_source_sha256)
        set(original_${index} FALSE)
      endif()
      if(NOT target_hash STREQUAL patch_${index}_${target}_patched_sha256)
        set(patched_${index} FALSE)
      endif()
    endforeach()
    if(NOT original_${index} AND NOT patched_${index})
      message(FATAL_ERROR "OCCT source target SHA-256 mismatch or mixed patch state: ${patch_${index}_file}")
    endif()
    if(ARK_OCCT_MODE STREQUAL "VERIFY" AND NOT patched_${index})
      message(FATAL_ERROR "OCCT source patch has not been applied")
    endif()
  endforeach()
  if(ARK_OCCT_MODE STREQUAL "APPLY")
    find_program(git_program git REQUIRED)
    foreach(index RANGE 0 ${last_patch})
      if(NOT patched_${index})
        foreach(check IN ITEMS TRUE FALSE)
          set(check_arg)
          if(check)
            set(check_arg --check)
          endif()
          execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE "GIT_CEILING_DIRECTORIES=${source_parent}" "${git_program}" -c core.autocrlf=false -c core.eol=lf -C "${source_root}" apply ${check_arg} --whitespace=error-all "${patch_directory}/${patch_${index}_file}" RESULT_VARIABLE code ERROR_VARIABLE error)
          if(NOT code EQUAL 0)
            message(FATAL_ERROR "Exact OCCT patch application failed: ${error}")
          endif()
        endforeach()
      endif()
      foreach(target RANGE 0 ${patch_${index}_last_target})
        file(SHA256 "${target_${index}_${target}}" actual)
        if(NOT actual STREQUAL patch_${index}_${target}_patched_sha256)
          message(FATAL_ERROR "Patched OCCT target SHA-256 mismatch")
        endif()
      endforeach()
    endforeach()
    if(NOT EXISTS "${stamp}")
      configure_file("${ARK_OCCT_PATCHSET}" "${stamp}" COPYONLY)
    endif()
  endif()
else()
  message(FATAL_ERROR "Unknown ARK_OCCT_MODE")
endif()
message(STATUS "OCCT ${patchset}: ${ARK_OCCT_MODE}; manifest ${definition_hash}; source-byte scope only")
