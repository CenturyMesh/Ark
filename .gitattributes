* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.ark text eol=lf
*.arkjson text eol=lf
*.png binary
*.bat text eol=crlf
*.h text eol=lf
*.S text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.arkops text eol=lf
*.step -text -diff
*.arkcut text eol=lf
tests/corpus/*.json text eol=lf
# Preserve the verified upstream amalgamation, including its comment spacing.
third_party/sqlite/sqlite3* -text whitespace=-blank-at-eol
# Preserve the pinned upstream decoder and license byte for byte.
third_party/stb/stb_image.h -text whitespace=-blank-at-eol
third_party/stb/LICENSE -text whitespace=-blank-at-eol
# Preserve the verified zstd 1.5.7 sources and licenses byte for byte.
third_party/zstd/lib/** -text whitespace=-blank-at-eol
third_party/zstd/LICENSE -text whitespace=-blank-at-eol
third_party/zstd/COPYING -text whitespace=-blank-at-eol
# Preserve the official ONNX Runtime headers and notices byte for byte.
third_party/onnxruntime/*.h -text whitespace=cr-at-eol,-blank-at-eol
third_party/onnxruntime/LICENSE -text whitespace=cr-at-eol,-blank-at-eol
third_party/onnxruntime/ThirdPartyNotices.txt -text whitespace=cr-at-eol,-blank-at-eol
# Preserve manifest stamps and patch digests byte for byte on every platform.
# Blank context lines in unified diffs require their leading space.
third_party/occt/patches/**/*.patch -text whitespace=-blank-at-eol
third_party/occt/patches/**/patchset.json -text whitespace=cr-at-eol
