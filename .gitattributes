* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.ark text eol=lf
*.arkjson text eol=lf
*.png binary
*.bat text eol=crlf
*.h text eol=lf
*.S text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.arkops text eol=lf
*.step -text -diff
*.arkcut text eol=lf
tests/corpus/*.json text eol=lf
# Preserve the verified upstream amalgamation, including its comment spacing.
third_party/sqlite/sqlite3* -text whitespace=-blank-at-eol
# Preserve the pinned upstream decoder and license byte for byte.
third_party/stb/stb_image.h -text whitespace=-blank-at-eol
third_party/stb/LICENSE -text whitespace=-blank-at-eol
