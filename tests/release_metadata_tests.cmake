cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ARK_SOURCE_DIR)
  message(FATAL_ERROR "ARK_SOURCE_DIR is required")
endif()
include("${ARK_SOURCE_DIR}/cmake/ArkRelease.cmake")
ark_read_release_metadata("${ARK_SOURCE_DIR}/release.json")
set(source_code "${ARK_ITERATION_CODE}")
set(source_version "${ARK_RELEASE_VERSION}")
if(DEFINED ARK_BINARY_DIR)
  file(READ "${ARK_BINARY_DIR}/app-version.json" runtime_json)
  string(JSON runtime_code GET "${runtime_json}" iteration_code)
  string(JSON runtime_version GET "${runtime_json}" version)
  if(NOT runtime_code STREQUAL source_code OR NOT runtime_version STREQUAL source_version)
    message(FATAL_ERROR "Generated runtime metadata diverges from release.json")
  endif()
  string(JSON runtime_platform GET "${runtime_json}" platform)
  string(JSON runtime_entrypoint GET "${runtime_json}" entrypoint)
  if(DEFINED ARK_EXPECTED_PLATFORM AND NOT runtime_platform STREQUAL ARK_EXPECTED_PLATFORM)
    message(FATAL_ERROR "Generated runtime platform is incorrect: ${runtime_platform}")
  endif()
  if(DEFINED ARK_EXPECTED_ENTRYPOINT AND NOT runtime_entrypoint STREQUAL ARK_EXPECTED_ENTRYPOINT)
    message(FATAL_ERROR "Generated runtime entrypoint is incorrect: ${runtime_entrypoint}")
  endif()
  file(READ "${ARK_BINARY_DIR}/generated/ark/version.hpp" version_header)
  string(FIND "${version_header}" "#define ARK_ITERATION_CODE \"${source_code}\"" code_position)
  string(FIND "${version_header}" "#define ARK_APP_VERSION \"${source_version}\"" version_position)
  if(code_position LESS 0 OR version_position LESS 0)
    message(FATAL_ERROR "Generated C++ identity diverges from release.json")
  endif()
  set(test_directory "${ARK_BINARY_DIR}/release-metadata-tests")
else()
  set(test_directory "${ARK_SOURCE_DIR}/out/release-metadata-tests")
endif()
file(MAKE_DIRECTORY "${test_directory}")
set(passed 0)
function(check_metadata name metadata expected_code)
  file(WRITE "${test_directory}/${name}.json" "${metadata}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DARK_RELEASE_FILE=${test_directory}/${name}.json" -P "${ARK_SOURCE_DIR}/cmake/ValidateRelease.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected_code STREQUAL "REJECT")
    if(result EQUAL 0)
      message(FATAL_ERROR "Invalid release metadata was accepted: ${name}")
    endif()
  else()
    string(FIND "${output}" "ARK ${expected_code} / runtime" code_position)
    if(NOT result EQUAL 0 OR code_position LESS 0)
      message(FATAL_ERROR "Valid release metadata failed: ${name}: ${output}${error}")
    endif()
  endif()
  math(EXPR next_passed "${passed}+1")
  set(passed "${next_passed}" PARENT_SCOPE)
endfunction()
check_metadata(first [=[{"sequence":1,"phase":"A","code":"001A","version":"0.9.2"}]=] "001A")
check_metadata(same-phase [=[{"sequence":2,"phase":"A","code":"002A","version":"0.9.3"}]=] "002A")
check_metadata(agent-focus [=[{"sequence":3,"phase":"D","code":"003D","version":"0.9.4"}]=] "003D")
check_metadata(cad-focus [=[{"sequence":4,"phase":"B","code":"004B","version":"0.9.5"}]=] "004B")
check_metadata(two-digits [=[{"sequence":10,"phase":"C","code":"010C","version":"1.0.0"}]=] "010C")
check_metadata(mixed-milestones [=[{"sequence":4,"phase":"B","code":"004B","version":"0.9.5","milestones":["A.01","B.01"]}]=] "004B")
check_metadata(last [=[{"sequence":999,"phase":"G","code":"999G","version":"3.0.0"}]=] "999G")
check_metadata(zero [=[{"sequence":0,"phase":"A","code":"000A","version":"0.9.2"}]=] "REJECT")
check_metadata(overflow [=[{"sequence":1000,"phase":"A","code":"1000A","version":"0.9.2"}]=] "REJECT")
check_metadata(negative [=[{"sequence":-1,"phase":"A","code":"001A","version":"0.9.2"}]=] "REJECT")
check_metadata(fraction [=[{"sequence":1.5,"phase":"A","code":"001A","version":"0.9.2"}]=] "REJECT")
check_metadata(string-sequence [=[{"sequence":"1","phase":"A","code":"001A","version":"0.9.2"}]=] "REJECT")
check_metadata(unknown-phase [=[{"sequence":1,"phase":"H","code":"001H","version":"0.9.2"}]=] "REJECT")
check_metadata(lowercase-phase [=[{"sequence":1,"phase":"a","code":"001a","version":"0.9.2"}]=] "REJECT")
check_metadata(multiple-phase [=[{"sequence":1,"phase":"AB","code":"001AB","version":"0.9.2"}]=] "REJECT")
check_metadata(mismatched-phase [=[{"sequence":1,"phase":"A","code":"001B","version":"0.9.2"}]=] "REJECT")
check_metadata(mismatched-sequence [=[{"sequence":2,"phase":"A","code":"001A","version":"0.9.2"}]=] "REJECT")
check_metadata(short-code [=[{"sequence":1,"phase":"A","code":"01A","version":"0.9.2"}]=] "REJECT")
check_metadata(version-leading-zero [=[{"sequence":1,"phase":"A","code":"001A","version":"0.09.2"}]=] "REJECT")
check_metadata(version-prefix [=[{"sequence":1,"phase":"A","code":"001A","version":"v0.9.2"}]=] "REJECT")
check_metadata(version-four-fields [=[{"sequence":1,"phase":"A","code":"001A","version":"0.9.2.0"}]=] "REJECT")
check_metadata(version-resource-overflow [=[{"sequence":1,"phase":"A","code":"001A","version":"65536.0.0"}]=] "REJECT")
check_metadata(missing-code [=[{"sequence":1,"phase":"A","version":"0.9.2"}]=] "REJECT")
check_metadata(invalid-milestone [=[{"sequence":1,"phase":"A","code":"001A","version":"0.9.2","milestones":["A-01"]}]=] "REJECT")
check_metadata(milestones-not-array [=[{"sequence":1,"phase":"A","code":"001A","version":"0.9.2","milestones":"A.01"}]=] "REJECT")
check_metadata(invalid-json "{not-json}" "REJECT")
message(STATUS "ARK release metadata: ${passed} valid/invalid cases passed")
