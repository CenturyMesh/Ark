}
static void teamCandidateRefreshReceipt031b(){
    ark::AgentSession session;refresh031bSeed(session);ark::AgentTeam team;ark::AgentTeamConfig config;config.roles={role("owner",true)};config.roles[0].discipline=ark::AgentTeamDiscipline::PartDesigner;int round=0,applies=0;std::string original,returned;bool mismatch=false,unowned=false;
    config.roles[0].transport=[&](auto&,const V& request,auto*){switch(++round){case 1:return call("retained_authorization","doc_preview",R"({"expected_revision":1,"commands":[{"op":"feature.edit","id":1,"p":{"dy":14}}]})");case 2:original=refresh031bData(request).find("candidate_id")->str;return refresh031bCall("tampered_refresh_receipt","doc_preview",original,1);case 3:{const auto result=refresh031bOutput(request);mismatch=result.find("isError")&&result.find("isError")->b&&result.dump().find("unchanged authorized recipe")!=std::string::npos;return refresh031bCall("tampered_receipt_cannot_commit","doc_apply",returned,1);}default:{const auto result=refresh031bOutput(request);unowned=result.find("isError")&&result.find("isError")->b&&result.dump().find("owned by this role")!=std::string::npos;return done();}}};
