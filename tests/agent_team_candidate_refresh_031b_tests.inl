// Public, portable fixtures exercise real shared AgentSession transactions.
static V refresh031bOutput(const V& request){return writeWindowOutput(request);}
static V refresh031bData(const V& request){auto result=refresh031bOutput(request);if(result.find("isError")&&result.find("isError")->b)throw std::runtime_error("Unexpected candidate refresh fixture rejection: "+result.dump());const auto* data=result.find("structuredContent");return data?*data:result;}
static V refresh031bCall(const std::string& callId,const char* tool,const std::string& candidate,ark::u64 revision){V args=V::makeObj();args.set("candidate_id",V::makeStr(candidate));args.set("expected_revision",V::makeNum((double)revision));return call(callId,tool,args.dump());}
static void refresh031bSeed(ark::AgentSession& session,bool dependency=false){session.suppressFailureCapture();V args=json(dependency?R"({"expected_revision":0,"commands":[{"op":"param.set","name":"DrivingWidth","expr":10},{"op":"feature.add","type":"box","name":"Independent A","p":{"dx":"DrivingWidth","dy":12,"dz":3}},{"op":"feature.add","type":"box","name":"Independent B","p":{"dx":20,"dy":5,"dz":4}}]})":R"({"expected_revision":0,"commands":[{"op":"feature.add","type":"box","name":"Independent A","p":{"dx":10,"dy":12,"dz":3}},{"op":"feature.add","type":"box","name":"Independent B","p":{"dx":20,"dy":5,"dz":4}}]})");const auto result=session.call("doc_apply",args);check(!result.find("isError")->b&&session.revision==1,"Prepare real independent authoring targets");}
static void independentTeamCandidateRefresh031b(){
    ark::AgentSession session;refresh031bSeed(session);ark::AgentTeam team;ark::AgentTeamConfig config;config.maxWorkers=2;config.roles={role("author_a",true),role("author_b",true)};for(auto& author:config.roles)author.discipline=ark::AgentTeamDiscipline::PartDesigner;
    Gate prepared,firstCommitted;int aRound=0,bRound=0;std::string aId,bId,newA,newB;std::atomic_bool wrongRole=false,oldCommit=false,aUnchanged=false,bUnchanged=false;std::atomic_int previews=0,applies=0;
    const auto aRecipe=json(R"({"expected_revision":1,"commands":[{"op":"feature.edit","id":1,"p":{"dy":14}}]})"),bRecipe=json(R"({"expected_revision":1,"commands":[{"op":"feature.edit","id":2,"p":{"dz":9}}]})");
    config.roles[0].transport=[&](auto&,const V& request,auto*){switch(++aRound){
        case 1:return call("a_prepare","doc_preview",aRecipe.dump());
        case 2:aId=refresh031bData(request).find("candidate_id")->str;prepared.enter();return refresh031bCall("a_cannot_borrow","doc_preview",bId,2);
        case 3:{const auto rejected=refresh031bOutput(request);wrongRole=rejected.find("isError")&&rejected.find("isError")->b&&rejected.dump().find("owned by this role")!=std::string::npos;return refresh031bCall("a_old_apply","team_apply_step",aId,1);}
        case 4:{const auto rejected=refresh031bOutput(request);oldCommit=rejected.find("isError")&&rejected.find("isError")->b;return refresh031bCall("a_refresh","doc_preview",aId,2);}
        case 5:{const auto data=refresh031bData(request);newA=data.find("candidate_id")->str;aUnchanged=newA!=aId&&data.find("recipe")&&data.find("recipe")->find("commands")->dump()==aRecipe.find("commands")->dump()&&session.revision==2;return refresh031bCall("a_publish_refreshed","team_apply_step",newA,2);}
        case 6:(void)refresh031bData(request);firstCommitted.open();return done("A refreshed and committed only its own unchanged proposal.");
        default:return done("Independent authoring evidence retained.");}};
    config.roles[1].transport=[&](auto&,const V& request,auto*){switch(++bRound){
        case 1:return call("b_prepare","doc_preview",bRecipe.dump());
        case 2:bId=refresh031bData(request).find("candidate_id")->str;prepared.enter();firstCommitted.enter();return refresh031bCall("b_refresh_after_peer_commit","doc_preview",bId,3);
        case 3:{const auto data=refresh031bData(request);newB=data.find("candidate_id")->str;bUnchanged=newB!=bId&&data.find("recipe")&&data.find("recipe")->find("commands")->dump()==bRecipe.find("commands")->dump()&&session.revision==3;return refresh031bCall("b_publish_refreshed","doc_apply",newB,3);}
        default:(void)refresh031bData(request);return done("B retained its independent proposal across A's publication.");}};
    team.start(config,"Refresh independent prepared edits explicitly after an unrelated shared edit",ark::AgentSession::tools(),[&](const auto& name,const V& args){if(name=="doc_preview")++previews;if(name=="doc_apply")++applies;return session.call(name,args);});prepared.await(2);
    const auto unrelated=session.call("doc_apply",json(R"({"expected_revision":1,"commands":[{"op":"feature.add","type":"sphere","name":"Unrelated current work","p":{"r":2}}]})"));check(!unrelated.find("isError")->b&&session.revision==2,"Independent external edit changes the shared global revision");prepared.open();complete(team);
    check(wrongRole&&oldCommit,"Wrong-role refresh and direct unchanged stale commit both reject");check(aUnchanged&&bUnchanged,"Both authors refresh retained commands by candidate ID without retyping");check(previews==4&&applies==3,"Borrowed refresh never reaches executor; stale publication reaches the real revision guard");
    check(session.revision==4&&session.document.features.size()==3&&session.document.find(1)->get("dy")=="14"&&session.document.find(2)->get("dz")=="9","Both independent refreshed edits preserve unrelated current work");const auto snapshot=team.snapshot();check(snapshot.roles[0].stepsApplied==1&&snapshot.roles[1].stepsApplied==1,"Only the two measured refreshed commits count as construction steps");
}
static void teamCandidateDependencyConflict031b(){
    ark::AgentSession session;refresh031bSeed(session,true);ark::AgentTeam team;ark::AgentTeamConfig config;config.roles={role("author",true)};config.roles[0].discipline=ark::AgentTeamDiscipline::PartDesigner;Gate prepared;int round=0;std::string candidate;bool rejected=false;unsigned refreshCalls=0;
    config.roles[0].transport=[&](auto&,const V& request,auto*){switch(++round){case 1:return call("dependent_preview","doc_preview",R"({"expected_revision":1,"commands":[{"op":"feature.edit","id":1,"p":{"dy":18}}]})");case 2:candidate=refresh031bData(request).find("candidate_id")->str;prepared.enter();return refresh031bCall("dependent_refresh","doc_preview",candidate,2);default:{const auto result=refresh031bOutput(request);rejected=result.find("isError")&&result.find("isError")->b;return done("Changed driving dependency requires a reviewed new proposal.");}}};
    team.start(config,"Reject refresh after an actual driving dependency changes",ark::AgentSession::tools(),[&](const auto& name,const V& args){if(name=="doc_preview"&&args.find("candidate_id"))++refreshCalls;return session.call(name,args);});prepared.await(1);const auto edit=session.call("doc_apply",json(R"({"expected_revision":1,"commands":[{"op":"param.set","name":"DrivingWidth","expr":11}]})"));check(!edit.find("isError")->b,"Driving dependency edit is actual committed geometry");prepared.open();complete(team);
    check(rejected&&refreshCalls==1&&session.revision==2&&session.document.find(1)->get("dy")=="12"&&session.document.getParam("DrivingWidth")==11,"Core dependency conflict rejects refresh without publishing or losing the new dependency");
}
static void teamCandidateProjectBoundary031b(){
    ark::AgentSession session;refresh031bSeed(session);ark::AgentTeam team;ark::AgentTeamConfig config;config.roles={role("owner",true)};int round=0,refreshCalls=0;std::string candidate;bool rejected=false;
    config.roles[0].transport=[&](auto&,const V& request,auto*){switch(++round){case 1:return call("before_project_boundary","doc_preview",R"({"expected_revision":1,"commands":[{"op":"feature.edit","id":1,"p":{"dy":14}}]})");case 2:candidate=refresh031bData(request).find("candidate_id")->str;return call("explicit_new_project","doc_new",R"({"expected_revision":1})");case 3:(void)refresh031bData(request);return refresh031bCall("cannot_refresh_foreign_project","doc_preview",candidate,2);default:{const auto result=refresh031bOutput(request);rejected=result.find("isError")&&result.find("isError")->b&&result.dump().find("owned by this role")!=std::string::npos;return done();}}};
