    const auto path=std::filesystem::temp_directory_path()/("ark-history-growth-072a-"+std::to_string(Clock::now().time_since_epoch().count())+".ark");const auto serialized=ark::documentToJson(session.document);check(ark::saveDocument(session.document,path.string().c_str()),"grown journal saves without pruning");ark::AgentSession reopened;std::string error;check(ark::loadDocument(path.string().c_str(),reopened.document,&error),error.c_str());check(ark::documentToJson(reopened.document)==serialized,"binary reopen preserves complete grown history, pending redo and authoring");reopened.revision=session.revision;
