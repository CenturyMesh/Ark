    const auto revision=reopened.revision;const auto journal=reopened.document.iterationHistory.dump();const auto authoring=ark::iterationAuthoring(reopened.document).dump();V bad=apply(reopened,"901");bad.set("motivation",V::makeStr(std::string(4097,'m')));check(reopened.call("doc_apply",bad).find("isError")->b&&reopened.revision==revision&&reopened.document.iterationHistory.dump()==journal&&ark::iterationAuthoring(reopened.document).dump()==authoring,"invalid metadata rolls back a grown-journal transaction without dropping history");
    ark::Document invalid=reopened.document;auto& list=member(invalid.iterationHistory,"nodes");list.arr.back().set("parent_id",*list.arr.back().find("id"));bool cycle=false;try{ark::Document restored;ark::iterationRestore(invalid,list.arr.back().find("id")->str,restored);}catch(const std::exception&){cycle=true;}check(cycle,"actual visited-ID cycle detection rejects hostile ancestry without a node quota");
    invalid=reopened.document;member(invalid.iterationHistory,"undo_ids").arr.assign(invalid.iterationHistory.find("nodes")->arr.size()+1,*invalid.iterationHistory.find("baseline_id"));check(!ark::iterationValidate(invalid,invalid.iterationHistory,error),"undo stack cannot claim more retained targets than actual commits");
    invalid=reopened.document;member(invalid.iterationHistory,"nodes").arr.push_back(invalid.iterationHistory.find("nodes")->arr.front());check(!ark::iterationValidate(invalid,invalid.iterationHistory,error),"duplicate history IDs reject before traversal");
