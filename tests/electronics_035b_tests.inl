bool sameCableJson035B(const Value& a,const Value& b){
    if(a.t!=b.t)return false;
    if(a.t==Value::Obj){if(a.obj.size()!=b.obj.size())return false;for(const auto& field:a.obj){const auto* other=b.find(field.first.c_str());if(!other||!sameCableJson035B(field.second,*other))return false;}return true;}
    if(a.t==Value::Arr){if(a.arr.size()!=b.arr.size())return false;for(size_t i=0;i<a.arr.size();++i)if(!sameCableJson035B(a.arr[i],b.arr[i]))return false;return true;}
    return a.dump()==b.dump();
}
