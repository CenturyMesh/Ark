static void cooperativeWriteWindowLifecycle(){
    ark::AgentTeam team;ark::AgentTeamConfig config;config.maxWorkers=2;config.roles={role("owner",true),role("peer",true)};Gate held;ark::AgentSession session;int ownerRound=0,peerRound=0;bool expired=false;std::atomic_int writes=0;
