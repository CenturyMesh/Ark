    team.start(config,"Finish cleans owned reservation",ark::AgentSession::tools(),[&](const auto& name,const V& args){return session.call(name,args);});complete(team);check(finished,"accepted task finish releases reservation without treating needs_input as completion");
    Gate cancelHeld;round=0;config.roles[0].transport=[&](auto&,auto&,const std::atomic_bool* cancel){switch(++round){case 1:return call("read","doc_info","{}");case 2:return call("reserve","team_reserve_write",R"({"expected_revision":1})");default:{std::unique_lock lock(cancelHeld.mutex);++cancelHeld.arrivals;cancelHeld.condition.notify_all();lock.unlock();while(!cancel->load())std::this_thread::sleep_for(1ms);return done("Cancelled with active lease.");}}};
    team.start(config,"Cancellation releases lease",ark::AgentSession::tools(),[&](const auto& name,const V& args){return session.call(name,args);});cancelHeld.await(1);team.cancel();complete(team);check(team.snapshot().cancelled&&!team.snapshot().running,"cancellation cleans active reserved team without hanging workers");
