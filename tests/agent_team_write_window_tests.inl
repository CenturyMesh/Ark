    team.start(config,"Bounded lease expiry",ark::AgentSession::tools(),[&](const auto& name,const V& args){if(name=="doc_apply")++writes;return session.call(name,args);});complete(team);check(expired&&writes==1&&session.revision==1,"lease expiry unlocks peers while owner provider remains active");
    config.roles.resize(1);int round=0;bool finished=false;
