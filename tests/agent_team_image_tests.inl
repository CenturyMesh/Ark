static void userImageTeamChecks(){
    ark::Image pixels;pixels.w=4;pixels.h=3;pixels.px.resize(4*3*3,120);const auto image=ark::assistantImageAttachment(ark::encodePNG(pixels),"synthetic-team-reference.png");
    ark::AgentTeam team;ark::AgentTeamConfig config;config.focusedWorkflow=true;config.roles={role("engineer",true),role("designer",true)};config.roles[0].discipline=ark::AgentTeamDiscipline::Orchestrator;config.roles[1].discipline=ark::AgentTeamDiscipline::PartDesigner;
    int lead=0,designer=0;bool firstPixels=false,steeredPixels=false,designerPixels=false;
    config.roles[0].transport=[&](auto&,const V& request,auto*){++lead;const auto body=request.dump();if(lead==1){firstPixels=body.find(image.base64)!=std::string::npos&&body.find("Image to CAD")!=std::string::npos&&body.find("width=120 mm")!=std::string::npos&&body.find("height=")==std::string::npos;return call("image_assignment","team_send",R"({"to":"designer","kind":"assignment","message":"Review the shared reference pixels and the visible outline; report your evidence."})");}if(lead>=3&&body.find("Inspire design")!=std::string::npos)steeredPixels=body.find(image.base64)!=std::string::npos;return done("Image workflow evidence retained; no reconstruction accuracy claimed.");};
    config.roles[1].transport=[&](auto&,const V& request,auto*){++designer;const auto body=request.dump();designerPixels=body.find(image.base64)!=std::string::npos&&body.find("Image to CAD")!=std::string::npos;return done("Assigned image review retains actual pixels.");};
    const auto replica=ark::assistantUserMessage("Recreate the visible outline",image,ark::AssistantImageMode::ImageToCAD,ark::parseAssistantImageDimensions({"120","",""}));team.start(config,replica,V::makeArr(),{});complete(team);
    check(firstPixels&&designer==1&&designerPixels,"lead first turn and assigned specialist receive same original image bytes, mode and partial dimension estimates");
    const auto inspiration=ark::assistantUserMessage("Use its curves for a new concept",image,ark::AssistantImageMode::InspireDesign);check(team.steer(inspiration,"engineer"),"real multimodal steering queues to the selected lead");complete(team);check(steeredPixels,"image steering reaches retained lead conversation as actual provider content");
    const auto snapshot=team.snapshot(true);check(snapshot.roles[0].conversation.dump().find(image.base64)!=std::string::npos&&snapshot.roles[0].conversation.dump().find("Inspire design")!=std::string::npos,"team checkpoint preserves attachment bytes and selected intent consistently");
    config.roles[1].assistant.imageInputSupported=false;const int before=lead;fails([&]{team.start(config,replica,V::makeArr(),{});},"unsupported team image route rejects before starting a partial team");check(lead==before,"unsupported team route invokes no additional provider transport");
    config.roles[1].assistant.imageInputSupported=true;config.roles[0].assistant.imageInputSupported=false;fails([&]{team.start(config,replica,V::makeArr(),{});},"unsupported lead route cannot silently strip reference pixels");team.cancel();
}
