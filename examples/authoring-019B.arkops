{"tool":"doc_apply","arguments":{"expected_revision":1,"commands":[{"op":"feature.add","type":"native_solid","name":"Seed","native":{"op":"box"},"p":{"width":"thickness","depth":8,"height":20}},{"op":"skeleton.set","source":"input span = 120\ninput rib_count = 4\nrelation pitch = span / max(rib_count - 1, 1)\nrelation thickness = span / 30\narray stations[rib_count] = [index * pitch, 0, thickness]\npattern Ribs from Seed count rib_count step [pitch,0,0]\n"},{"op":"feature.add","type":"curve","name":"Editable helix","native":{"op":"helix","radius":20,"pitch":15,"turns":2.25,"origin":[40,60,0],"axis":[0,0,1],"x_axis":[1,0,0],"handedness":1}},{"op":"plane.set","name":"Loft top","p":{"oz":60}},{"op":"sketch.set","name":"Loft lower","sketch":{"plane":"XY","entities":[{"kind":"circle","name":"Lower ring","dof":[200,0,20]}],"constraints":[]}},{"op":"sketch.set","name":"Loft upper","sketch":{"plane":"Loft top","entities":[{"kind":"circle","name":"Upper ring","dof":[200,0,12]}],"constraints":[]}},{"op":"feature.add","type":"loft","name":"Aligned loft","native":{"sections":["Loft lower","Loft upper"],"controls":{"section_alignment":[{"reverse":false,"seam_edge":0,"seam_angle":30},{"reverse":false,"seam_edge":0,"seam_angle":30}]}},"p":{"solid":1,"compatible":0,"ruled":0}},{"op":"feature.add","type":"mesh_body","name":"Indexed edit seed","mesh":{"positions":[0,40,0,20,40,0,20,60,0,0,60,0,0,40,20,20,40,20,20,60,20,0,60,20],"indices":[0,2,1,0,3,2,4,5,6,4,6,7,0,1,5,0,5,4,1,2,6,1,6,5,2,3,7,2,7,6,3,0,4,3,4,7]}}]}}
