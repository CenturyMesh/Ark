{"tool":"doc_apply","arguments":{  "expected_revision": 0,  "commands": [    {"op":"param.set","name":"motor_x","expr":"120"},    {"op":"param.set","name":"motor_y","expr":"120"},    {"op":"param.set","name":"arm_len","expr":"sqrt(motor_x*motor_x+motor_y*motor_y)"},    {"op":"param.set","name":"arm_od","expr":"12"},    {"op":"param.set","name":"arm_wall","expr":"1.6"},    {"op":"param.set","name":"body_l","expr":"108"},    {"op":"param.set","name":"body_w","expr":"64"},    {"op":"param.set","name":"body_h","expr":"24"},    {"op":"param.set","name":"motor_r","expr":"14"},    {"op":"param.set","name":"motor_h","expr":"16"},    {"op":"param.set","name":"prop_r","expr":"58"},    {"op":"param.set","name":"prop_c","expr":"10"},    {"op":"param.set","name":"prop_t","expr":"1.8"},    {"op":"param.set","name":"leg_r","expr":"3.2"},    {"op":"param.set","name":"leg_h","expr":"18"},    {"op":"param.set","name":"skid_x","expr":"36"},    {"op":"param.set","name":"skid_y","expr":"22"},    {"op":"plane.set","name":"Belly","parent":"XY","p":{"oz":"arm_od/2"}},    {"op":"plane.set","name":"Waist","parent":"XY","p":{"oz":"arm_od/2+body_h*0.58"}},    {"op":"plane.set","name":"Crown","parent":"XY","p":{"oz":"arm_od/2+body_h"}},    {"op":"sketch.set","name":"Belly","sketch":{"plane":"Belly","tolerance":0.05,"entities":[{"kind":"spline","name":"skin","closed":true,"tension":0.22,"dof":["body_l/2","0","body_l*0.34","body_w*0.48","body_l*0.02","body_w/2","(-body_l*0.36)","body_w*0.42","(-body_l/2)","0","(-body_l*0.36)","(-body_w*0.42)","body_l*0.02","(-body_w/2)","body_l*0.34","(-body_w*0.48)"]}],"constraints":[]}},    {"op":"sketch.set","name":"Waist","sketch":{"plane":"Waist","tolerance":0.05,"entities":[{"kind":"spline","name":"skin","closed":true,"tension":0.22,"dof":["body_l*0.46","0","body_l*0.30","body_w*0.40","0","body_w*0.44","(-body_l*0.32)","body_w*0.36","(-body_l*0.46)","0","(-body_l*0.32)","(-body_w*0.36)","0","(-body_w*0.44)","body_l*0.30","(-body_w*0.40)"]}],"constraints":[]