{
  "tool": "doc_apply",
  "arguments": {
    "expected_revision": 0,
    "commands": [
      {
        "op": "param.set",
        "name": "front_teeth",
        "expr": "48"
      },
      {
        "op": "param.set",
        "name": "rear_teeth",
        "expr": "16"
      },
      {
        "op": "param.set",
        "name": "cadence_rpm",
        "expr": "60"
      },
      {
        "op": "param.set",
        "name": "chain_pitch_mm",
        "expr": "12.7"
      },
      {
        "op": "param.set",
        "name": "front_pitch_radius",
        "expr": "chain_pitch_mm*front_teeth/(2*pi)"
      },
      {
        "op": "param.set",
        "name": "rear_pitch_radius",
        "expr": "chain_pitch_mm*rear_teeth/(2*pi)"
      },
      {
        "op": "param.set",
        "name": "axle_span",
        "expr": "420"
      },
      {
        "op": "param.set",
        "name": "rear_height",
        "expr": "40"
      },
      {
        "op": "param.set",
        "name": "wheel_radius",
        "expr": "300"
      },
      {
        "op": "param.set",
        "name": "chain_distance",
        "expr": "sqrt(axle_span^2+rear_height^2)"
      },
      {
        "op": "param.set",
        "name": "chain_phi",
        "expr": "atan2(rear_height,-axle_span)"
      },
      {
        "op": "param.set",
        "name": "chain_beta",
        "expr": "acos((front_pitch_radius-rear_pitch_radius)/chain_distance)"
      },
      {
        "op": "param.set",
        "name": "chain_upper",
        "expr": "chain_phi-chain_beta"
      },
      {
        "op": "param.set",
        "name": "chain_lower",
        "expr": "chain_phi+chain_beta"
      },
      {
        "op": "param.set",
        "name": "gear_ratio",
        "expr": "front_teeth/rear_teeth"
      },
      {
        "op": "param.set",
        "name": "rear_rpm",
        "expr": "cadence_rpm*gear_ratio"
      },
