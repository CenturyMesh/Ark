{"tool":"doc_apply","arguments":{"expected_revision":1,"commands":[{"op":"param.set","name":"R","expr":12},{"op":"param.set","name":"Offset","expr":2},{"op":"param.set","name":"L","expr":25},{"op":"plane.set","name":"Raised datum","p":{"oz":10}},{"op":"sketch.set","name":"Parametric ring","sketch":{"entities":[{"kind":"circle","name":"ring","dof":[40,0,"R"],"construction":true},{"kind":"offset","name":"inset","source":"ring","distance":"Offset"}]}},{"op":"feature.add","type":"native_solid","name":"Base box","native":{"op":"box"},"p":{"width":20,"depth":20,"height":15}},{"op":"feature.add","type":"native_solid","name":"Offset box","inputs":[1],"native":{"op":"offset","join":"intersection"},"p":{"distance":"Offset"},"part":{"part_number":"DEMO-OFFSET","description":"Synthetic offset part","procurement":"make","representation":"exact"}},{"op":"feature.add","type":"curve","name":"XYZ helix","native":{"op":"equation","x":"R*cos(t)","y":"R*sin(t)","z":"5*t","t0":0,"t1":"2*pi","samples":64}},{"op":"feature.add","type":"curve","name":"Dimensioned spatial line","native":{"start":[40,0,20],"segments":[{"kind":"line","to":[50,10,30],"length":"L"}]}},{"op":"feature.add","type":"bspline_surface","name":"Warped surface","native":{"poles":[[[0,0,0],[0,20,0]],[[20,0,0],[20,20,4]]]},"p":{"u_degree":1,"v_degree":1}},{"op":"feature.add","type":"curve","name":"Raised loop","native":{"start":[5,5,10],"segments":[{"kind":"line","to":[15,5,10]},{"kind":"line","to":[15,15,10]},{"kind":"line","to":[5,15,10]},{"kind":"line","to":[5,5,10]}]}},{"op":"feature.add","type":"curve","name":"Surface projection","inputs":[6,5],"native":{"op":"project_surface","direction":[0,0,-1]}},{"op":"feature.add","type":"surface_edit","name":"Retained curved patch","inputs":[5,7],"native":{"op":"trim_wire","keep_point":[10,10,1]}}]}}
