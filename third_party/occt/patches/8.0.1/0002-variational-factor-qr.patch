+  const int continuity = order(myCurve->Base());
+  const int samples = myParameters->Length(), dimensions = myCurve->Dimension();
+  if (Quality.LowerRow() != 0 || Quality.UpperRow() != degree || Quality.LowerCol() != 0
+      || Quality.UpperCol() != degree || Factors.LowerRow() != 1 || Factors.UpperRow() != samples
+      || Factors.LowerCol() != 0 || Factors.UpperCol() != degree || Targets.LowerRow() != 1
+      || Targets.UpperRow() != samples || Targets.LowerCol() != 1
+      || Targets.UpperCol() != dimensions || Weights.Lower() != 1 || Weights.Upper() != samples)
+    throw Standard_DomainError("AppDef_LinearCriteria::LinearSystem: array dimensions");
+  Quality.Init(0.);
+  Factors.Init(0.);
+  Targets.Init(0.);
+  Weights.Init(0.);
+  const double first = myCurve->Knots()(Element), last = myCurve->Knots()(Element + 1);
+  math_Matrix  part(0, degree, 0, degree, 0.);
+  for (int criterion = 0; criterion < 3; ++criterion)
+  {
+    myCriteria[criterion]->Set(first, last);
+    myCriteria[criterion]->Hessian(1, 1, part);
+    const double scale = myQualityWeight * myPercent[criterion] / myEstimation[criterion];
+    for (int i = 0; i <= degree; ++i)
+      for (int j = 0; j <= degree; ++j)
+        Quality(i, j) += scale * part(i, j);
+  }
+  if (myE != Element)
+    BuildCache(Element);
+  const int                    points3d = AppDef_MyLineTool::NbP3d(mySSP);
+  const int                    points2d = AppDef_MyLineTool::NbP2d(mySSP);
+  NCollection_Array1<gp_Pnt>   p3(1, std::max(1, points3d));
+  NCollection_Array1<gp_Pnt2d> p2(1, std::max(1, points2d));
+  const double                 halfSpan = (last - first) / 2.;
+  const int                    offset   = myPntWeight.Lower() - myParameters->Lower();
+  for (int point = IF, cache = 1; point <= IL; ++point, cache += degree + 1)
+  {
+    const int row = point - myParameters->Lower() + 1;
+    Weights(row)  = myQuadraticWeight * (myPntWeight(offset + point) * 2.);
+    for (int i = 0; i <= degree; ++i)
+    {
+      const int power = i <= 2 * continuity + 1 ? (i <= continuity ? i : i - continuity - 1) : 0;
