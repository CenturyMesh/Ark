+// Return factors separately: summing a large least-squares Gram matrix with
+// a small positive regularizer can lose the regularizer in double precision.
+void AppDef_LinearCriteria::LinearSystem(const int                   Element,
+                                         NCollection_Array2<double>& Quality,
+                                         NCollection_Array2<double>& Factors,
+                                         NCollection_Array2<double>& Targets,
+                                         NCollection_Array1<double>& Weights)
+{
