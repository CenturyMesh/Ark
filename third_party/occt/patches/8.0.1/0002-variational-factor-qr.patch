+    }
+    if (points3d && points2d)
+      AppDef_MyLineTool::Value(mySSP, point, p3, p2);
+    else if (points3d)
+      AppDef_MyLineTool::Value(mySSP, point, p3);
+    else
+      AppDef_MyLineTool::Value(mySSP, point, p2);
+    int dimension = 1;
+    for (int i = 1; i <= points3d; ++i)
+      for (int coordinate = 1; coordinate <= 3; ++coordinate)
+        Targets(row, dimension++) = p3(i).Coord(coordinate);
+    for (int i = 1; i <= points2d; ++i)
+      for (int coordinate = 1; coordinate <= 2; ++coordinate)
+        Targets(row, dimension++) = p2(i).Coord(coordinate);
+  }
+}
