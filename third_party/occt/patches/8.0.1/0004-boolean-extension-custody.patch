+static occ::handle<Geom2d_Curve> ExtendedSharedPCurve(
+  const TopoDS_Edge& theEdge,
+  const TopoDS_Face& theFace,
+  const occ::handle<Geom2d_Curve>& theOriginal,
+  const double theOriginalFirst,
+  const double theOriginalLast,
+  const double theFirst,
+  const double theLast,
+  const double theTolerance)
+{
+  if(!std::isfinite(theOriginalFirst)||!std::isfinite(theOriginalLast)
+      ||!std::isfinite(theFirst)||!std::isfinite(theLast)||!std::isfinite(theTolerance)
+      ||theOriginalFirst>=theOriginalLast||theFirst>=theLast||theTolerance<=0.)
+    throw Standard_ConstructionError("BRepOffset: invalid shared edge interval");
+  const bool hasBefore = theFirst < theOriginalFirst - Precision::PConfusion();
+  const bool hasAfter = theLast > theOriginalLast + Precision::PConfusion();
+  if (!hasBefore && !hasAfter)
+    return theOriginal;
+  double aCF, aCL;
+  const occ::handle<Geom_Curve> aCurve = BRep_Tool::Curve(theEdge, aCF, aCL);
+  const occ::handle<Geom_Surface> aSurface = BRep_Tool::Surface(theFace);
+  if (aCurve.IsNull())
+    throw Standard_ConstructionError("BRepOffset: missing extended shared curve");
+  if(SharedCurveDeviation(aCurve,theOriginal,aSurface,theFirst,theLast)<=theTolerance)
+    return theOriginal;
+  occ::handle<Geom2d_Curve> aPC = theOriginal;
+  double aFirst = theOriginalFirst, aLast = theOriginalLast;
+  if (hasBefore)
+  {
+    const occ::handle<Geom2d_Curve> anExtension = ProjectOwnedExtension(
+      aCurve,aSurface,theOriginal,theFirst,theOriginalFirst,true,theTolerance);
+    aPC = JoinSharedPCurves(anExtension, theFirst, theOriginalFirst, aPC, aLast);
+    aFirst = theFirst;
+  }
+  if (hasAfter)
+  {
+    const occ::handle<Geom2d_Curve> anExtension = ProjectOwnedExtension(
+      aCurve,aSurface,theOriginal,theOriginalLast,theLast,false,theTolerance);
+    aPC = JoinSharedPCurves(aPC, aFirst, theOriginalLast, anExtension, theLast, true);
+    aLast = theLast;
+  }
+  if(SharedCurveDeviation(aCurve,aPC,aSurface,aFirst,aLast)>theTolerance)
+    throw Standard_ConstructionError("BRepOffset: inconsistent shared edge extension");
+  return aPC;
+}
