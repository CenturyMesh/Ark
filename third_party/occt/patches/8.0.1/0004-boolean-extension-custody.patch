+// Concatenate bounded pcurves without changing either parameter interval.
+// The original boundary supplies the common pole; the complete result is
+// checked in physical space by ExtendedSharedPCurve before publication.
+static bool PreservesCurveParameter(const occ::handle<Geom2d_Curve>& theCurve)
+{
+  if(theCurve.IsNull())return false;
+  occ::handle<Geom2d_Curve> aBasis=theCurve;
+  while(aBasis->IsKind(STANDARD_TYPE(Geom2d_TrimmedCurve)))
+    aBasis=occ::down_cast<Geom2d_TrimmedCurve>(aBasis)->BasisCurve();
+  return aBasis->IsKind(STANDARD_TYPE(Geom2d_Line))
+      || aBasis->IsKind(STANDARD_TYPE(Geom2d_BSplineCurve))
+      || aBasis->IsKind(STANDARD_TYPE(Geom2d_BezierCurve));
+}
+
+static double SharedCurveDeviation(const occ::handle<Geom_Curve>& theCurve,
+  const occ::handle<Geom2d_Curve>& thePC,const occ::handle<Geom_Surface>& theSurface,
+  const double theFirst,const double theLast)
+{
+  if(theCurve.IsNull()||thePC.IsNull()||theSurface.IsNull()
+      ||!std::isfinite(theFirst)||!std::isfinite(theLast)||theFirst>=theLast)
+    throw Standard_ConstructionError("BRepOffset: invalid shared curve verification input");
+  occ::handle<GeomAdaptor_Curve> aReference=new GeomAdaptor_Curve(theCurve,theFirst,theLast);
+  occ::handle<Geom2dAdaptor_Curve> aUV=new Geom2dAdaptor_Curve(thePC,theFirst,theLast);
+  occ::handle<GeomAdaptor_Surface> aSupport=new GeomAdaptor_Surface(theSurface);
+  occ::handle<Adaptor3d_CurveOnSurface> anOnSurface=new Adaptor3d_CurveOnSurface(aUV,aSupport);
+  GeomLib_CheckCurveOnSurface aCheck(aReference);aCheck.Perform(anOnSurface);
+  if(!aCheck.IsDone()||!std::isfinite(aCheck.MaxDistance()))
+    throw Standard_ConstructionError("BRepOffset: cannot verify shared edge pcurve");
+  double aMaximum=aCheck.MaxDistance();
+  for(const double aT:{theFirst,theLast})
+  {
+    const gp_Pnt2d aPoint=thePC->Value(aT);
+    const double aDistance=theCurve->Value(aT).Distance(theSurface->Value(aPoint.X(),aPoint.Y()));
+    if(!std::isfinite(aDistance))throw Standard_ConstructionError("BRepOffset: non-finite shared edge pcurve");
+    aMaximum=std::max(aMaximum,aDistance);
+  }
+  return aMaximum;
+}
+
+static occ::handle<Geom2d_BSplineCurve> JoinSharedPCurves(
+  const occ::handle<Geom2d_Curve>& theFirst,
+  const double theFirstStart,
+  const double theJoin,
+  const occ::handle<Geom2d_Curve>& theSecond,
+  const double theSecondEnd,
+  const bool theKeepFirstJoin = false)
+{
+  if(!PreservesCurveParameter(theFirst)||!PreservesCurveParameter(theSecond))
+    throw Standard_ConstructionError("BRepOffset: shared pcurve parameter conversion unsupported");
+  occ::handle<Geom2d_BSplineCurve> aFirst = Geom2dConvert::CurveToBSplineCurve(
+    new Geom2d_TrimmedCurve(theFirst, theFirstStart, theJoin));
+  occ::handle<Geom2d_BSplineCurve> aSecond = Geom2dConvert::CurveToBSplineCurve(
+    new Geom2d_TrimmedCurve(theSecond, theJoin, theSecondEnd));
+  for(const auto& anInterval:{std::make_pair(aFirst,std::make_pair(theFirstStart,theJoin)),
+      std::make_pair(aSecond,std::make_pair(theJoin,theSecondEnd))})
+  {
+    const auto& aSpline=anInterval.first;
+    const double aStart=anInterval.second.first,anEnd=anInterval.second.second;
+    if(aSpline->FirstParameter()!=aStart||aSpline->LastParameter()!=anEnd)
+    {
+      NCollection_Array1<double> aParameters(aSpline->Knots());
+      BSplCLib::Reparametrize(aStart,anEnd,aParameters);aSpline->SetKnots(aParameters);
+    }
+  }
+  const int aDegree = std::max(aFirst->Degree(), aSecond->Degree());
+  aFirst->IncreaseDegree(aDegree);
+  aSecond->IncreaseDegree(aDegree);
+  const int aNP1 = aFirst->NbPoles(), aNP2 = aSecond->NbPoles();
+  const int aNK1 = aFirst->NbKnots(), aNK2 = aSecond->NbKnots();
+  NCollection_Array1<gp_Pnt2d> aPoles(1, aNP1 + aNP2 - 1);
+  NCollection_Array1<double> aWeights(1, aNP1 + aNP2 - 1);
+  NCollection_Array1<double> aKnots(1, aNK1 + aNK2 - 1);
+  NCollection_Array1<int> aMults(1, aNK1 + aNK2 - 1);
+  const double aW1 = aFirst->Weight(aNP1), aW2 = aSecond->Weight(1);
+  for (int i = 1; i < aNP1; ++i)
+  {
+    aPoles(i) = aFirst->Pole(i);
+    aWeights(i) = aFirst->Weight(i) / aW1;
+  }
+  for (int i = 1; i <= aNP2; ++i)
+  {
+    aPoles(aNP1 + i - 1) = aSecond->Pole(i);
+    aWeights(aNP1 + i - 1) = aSecond->Weight(i) / aW2;
+  }
+  if (theKeepFirstJoin)
+  {
+    aPoles(aNP1) = aFirst->Pole(aNP1);
+    aWeights(aNP1) = 1.;
+  }
+  for (int i = 1; i < aNK1; ++i)
+  {
+    aKnots(i) = aFirst->Knot(i);
+    aMults(i) = aFirst->Multiplicity(i);
+  }
+  aKnots(aNK1) = theJoin;
+  aMults(aNK1) = aDegree;
+  for (int i = 2; i <= aNK2; ++i)
+  {
+    aKnots(aNK1 + i - 1) = aSecond->Knot(i);
+    aMults(aNK1 + i - 1) = aSecond->Multiplicity(i);
+  }
+  return new Geom2d_BSplineCurve(aPoles, aWeights, aKnots, aMults, aDegree, false);
+}
+
+static occ::handle<Geom_BSplineCurve> JoinOwnedCurves(
+  const occ::handle<Geom_Curve>& theFirst, const double theFirstStart,
+  const double theJoin, const occ::handle<Geom_Curve>& theSecond,
+  const double theSecondEnd, const bool theKeepFirstJoin)
+{
+  for(occ::handle<Geom_Curve> aBasis:{theFirst,theSecond})
+  {
+    while(aBasis->IsKind(STANDARD_TYPE(Geom_TrimmedCurve)))
+      aBasis=occ::down_cast<Geom_TrimmedCurve>(aBasis)->BasisCurve();
+    if(!aBasis->IsKind(STANDARD_TYPE(Geom_Line))
+        &&!aBasis->IsKind(STANDARD_TYPE(Geom_BSplineCurve))
+        &&!aBasis->IsKind(STANDARD_TYPE(Geom_BezierCurve)))
+      throw Standard_ConstructionError("BRepOffset: shared curve parameter conversion unsupported");
+  }
+  occ::handle<Geom_BSplineCurve> aFirst = GeomConvert::CurveToBSplineCurve(
+    new Geom_TrimmedCurve(theFirst, theFirstStart, theJoin));
+  occ::handle<Geom_BSplineCurve> aSecond = GeomConvert::CurveToBSplineCurve(
+    new Geom_TrimmedCurve(theSecond, theJoin, theSecondEnd));
+  for(const auto& anInterval:{std::make_pair(aFirst,std::make_pair(theFirstStart,theJoin)),
+      std::make_pair(aSecond,std::make_pair(theJoin,theSecondEnd))})
+  {
+    const auto& aSpline=anInterval.first;
+    const double aStart=anInterval.second.first,anEnd=anInterval.second.second;
+    if(aSpline->FirstParameter()!=aStart||aSpline->LastParameter()!=anEnd)
+    {
+      NCollection_Array1<double> aParameters(aSpline->Knots());
+      BSplCLib::Reparametrize(aStart,anEnd,aParameters);aSpline->SetKnots(aParameters);
+    }
+  }
+  const int aDegree = std::max(aFirst->Degree(), aSecond->Degree());
+  aFirst->IncreaseDegree(aDegree); aSecond->IncreaseDegree(aDegree);
+  const int aNP1=aFirst->NbPoles(), aNP2=aSecond->NbPoles();
+  const int aNK1=aFirst->NbKnots(), aNK2=aSecond->NbKnots();
+  NCollection_Array1<gp_Pnt> aPoles(1,aNP1+aNP2-1);
+  NCollection_Array1<double> aWeights(1,aNP1+aNP2-1),aKnots(1,aNK1+aNK2-1);
+  NCollection_Array1<int> aMults(1,aNK1+aNK2-1);
+  const double aW1=aFirst->Weight(aNP1),aW2=aSecond->Weight(1);
+  for(int i=1;i<aNP1;++i){aPoles(i)=aFirst->Pole(i);aWeights(i)=aFirst->Weight(i)/aW1;}
+  for(int i=1;i<=aNP2;++i){aPoles(aNP1+i-1)=aSecond->Pole(i);aWeights(aNP1+i-1)=aSecond->Weight(i)/aW2;}
+  if(theKeepFirstJoin){aPoles(aNP1)=aFirst->Pole(aNP1);aWeights(aNP1)=1.;}
+  for(int i=1;i<aNK1;++i){aKnots(i)=aFirst->Knot(i);aMults(i)=aFirst->Multiplicity(i);}
+  aKnots(aNK1)=theJoin;aMults(aNK1)=aDegree;
+  for(int i=2;i<=aNK2;++i){aKnots(aNK1+i-1)=aSecond->Knot(i);aMults(aNK1+i-1)=aSecond->Multiplicity(i);}
+  return new Geom_BSplineCurve(aPoles,aWeights,aKnots,aMults,aDegree,false);
+}
+
+static occ::handle<Geom_Curve> MaterializeOwnedCurve(
+  const TopoDS_Edge& theEdge, const TopoDS_Face& theFace,
+  const double theFirst, const double theLast, const double theTolerance)
+{
+  if(!std::isfinite(theFirst)||!std::isfinite(theLast)||!std::isfinite(theTolerance)
+      ||theFirst>=theLast||theTolerance<=0.)
+    throw Standard_ConstructionError("BRepOffset: invalid constructed edge interval");
+  double aPF,aPL;
+  const occ::handle<Geom2d_Curve> aPC=BRep_Tool::CurveOnSurface(theEdge,theFace,aPF,aPL);
+  if(aPC.IsNull())throw Standard_ConstructionError("BRepOffset: missing constructed edge pcurve");
+  double aCF,aCL;
+  const occ::handle<Geom_Curve> anExisting=BRep_Tool::Curve(theEdge,aCF,aCL);
+  if(!anExisting.IsNull()&&anExisting->FirstParameter()<=theFirst&&anExisting->LastParameter()>=theLast)
+  {
+    if(SharedCurveDeviation(anExisting,aPC,BRep_Tool::Surface(theFace),theFirst,theLast)>theTolerance)
+      throw Standard_ConstructionError("BRepOffset: inconsistent original edge curve");
+    return anExisting;
+  }
+  occ::handle<Geom2dAdaptor_Curve> aUV=new Geom2dAdaptor_Curve(aPC,theFirst,theLast);
+  occ::handle<GeomAdaptor_Surface> aSupport=new GeomAdaptor_Surface(BRep_Tool::Surface(theFace));
+  Adaptor3d_CurveOnSurface anOnSurface(aUV,aSupport);occ::handle<Geom_Curve> aCurve;
+  double aMaximum,anAverage;
+  GeomLib::BuildCurve3d(theTolerance,anOnSurface,theFirst,theLast,aCurve,aMaximum,anAverage);
+  const double aPhysical=aCurve.IsNull()?Precision::Infinite():
+    SharedCurveDeviation(aCurve,aPC,BRep_Tool::Surface(theFace),theFirst,theLast);
+  if(aCurve.IsNull()||!std::isfinite(aMaximum)||!std::isfinite(anAverage)||aMaximum>theTolerance
+      ||aPhysical>theTolerance)
+    throw Standard_ConstructionError("BRepOffset: cannot materialize constructed edge");
+  return aCurve;
+}
