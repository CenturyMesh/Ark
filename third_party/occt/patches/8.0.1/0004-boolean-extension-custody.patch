+static occ::handle<Geom2d_Curve> ProjectOwnedExtension(
+  const occ::handle<Geom_Curve>& theCurve,const occ::handle<Geom_Surface>& theSurface,
+  const occ::handle<Geom2d_Curve>& theOriginal,const double theFirst,const double theLast,
+  const bool theAnchorAtLast,const double theTolerance)
+{
+  double aReached=theTolerance;
+  occ::handle<Geom_Curve> aRestricted=theCurve;
+  if(const occ::handle<Geom_BSplineCurve> aSpline=occ::down_cast<Geom_BSplineCurve>(theCurve))
+  {
+    const occ::handle<Geom_BSplineCurve> aSegment=occ::down_cast<Geom_BSplineCurve>(aSpline->Copy());
+    aSegment->Segment(theFirst,theLast);
+    aRestricted=aSegment;
+  }
+  const occ::handle<Geom2d_Curve> aProjected=GeomProjLib::Curve2d(
+    aRestricted,theFirst,theLast,theSurface,aReached);
+  if(aProjected.IsNull()||!std::isfinite(aReached)||!PreservesCurveParameter(aProjected))
+    throw Standard_ConstructionError("BRepOffset: cannot project shared edge extension");
+  occ::handle<Geom2d_BSplineCurve> aBasis=Geom2dConvert::CurveToBSplineCurve(
+    new Geom2d_TrimmedCurve(aProjected,theFirst,theLast));
+  if(aBasis->FirstParameter()!=theFirst||aBasis->LastParameter()!=theLast)
+  {
+    NCollection_Array1<double> aParameters(aBasis->Knots());
+    BSplCLib::Reparametrize(theFirst,theLast,aParameters);aBasis->SetKnots(aParameters);
+  }
+  const double anAnchorParameter=theAnchorAtLast?theLast:theFirst;
+  const gp_Pnt2d anAnchor=theOriginal->Value(anAnchorParameter);
+  const gp_Pnt2d aProjectedAnchor=aBasis->Value(anAnchorParameter);
+  const double aShiftU=theSurface->IsUPeriodic()
+    ?std::round((anAnchor.X()-aProjectedAnchor.X())/theSurface->UPeriod())*theSurface->UPeriod():0.;
+  const double aShiftV=theSurface->IsVPeriodic()
+    ?std::round((anAnchor.Y()-aProjectedAnchor.Y())/theSurface->VPeriod())*theSurface->VPeriod():0.;
+  aBasis->Translate(gp_Vec2d(aShiftU,aShiftV));
+  const double aNewEndParameter=theAnchorAtLast?theFirst:theLast;
+  const gp_Pnt2d aBranch=theOriginal->Value(aNewEndParameter);
+  GeomAPI_ProjectPointOnSurf anEndProjection(theCurve->Value(aNewEndParameter),theSurface,theTolerance);
+  bool hasEndpoint=false;gp_Pnt2d aNewEnd;
+  for(int i=1;i<=anEndProjection.NbPoints();++i)
+  {
+    if(!std::isfinite(anEndProjection.Distance(i))||anEndProjection.Distance(i)>theTolerance)continue;
+    double aU,aV;anEndProjection.Parameters(i,aU,aV);
+    if(theSurface->IsUPeriodic())aU+=std::round((aBranch.X()-aU)/theSurface->UPeriod())*theSurface->UPeriod();
+    if(theSurface->IsVPeriodic())aV+=std::round((aBranch.Y()-aV)/theSurface->VPeriod())*theSurface->VPeriod();
+    const gp_Pnt2d aCandidate(aU,aV);
+    if(hasEndpoint&&aCandidate.Distance(aNewEnd)>Precision::PConfusion())
+      throw Standard_ConstructionError("BRepOffset: ambiguous shared edge endpoint projection");
+    aNewEnd=aCandidate;hasEndpoint=true;
+  }
+  if(!hasEndpoint)throw Standard_ConstructionError("BRepOffset: missing shared edge endpoint projection");
+  aBasis->SetPole(theAnchorAtLast?1:aBasis->NbPoles(),aNewEnd);
+  if(!std::isfinite(aNewEnd.X())||!std::isfinite(aNewEnd.Y()))
+    throw Standard_ConstructionError("BRepOffset: non-finite shared edge endpoint projection");
+  // Constrain the known original endpoint. Refine only the terminal span;
+  // knot insertion is exact before anchoring and the physical criterion is
+  // unchanged. A singular support cannot silently choose another UV branch.
+  for(;;)
+  {
+    occ::handle<Geom2d_BSplineCurve> aCandidate=occ::down_cast<Geom2d_BSplineCurve>(aBasis->Copy());
+    aCandidate->SetPole(theAnchorAtLast?aCandidate->NbPoles():1,anAnchor);
+    if(SharedCurveDeviation(theCurve,aCandidate,theSurface,theFirst,theLast)<=theTolerance)
+      return aCandidate;
+    const int aKnot=theAnchorAtLast?aBasis->NbKnots()-1:1;
+    const double aLeft=aBasis->Knot(aKnot),aRight=aBasis->Knot(aKnot+1);
+    if(aRight-aLeft<=2.*Precision::PConfusion())
+      throw Standard_ConstructionError("BRepOffset: cannot anchor shared edge extension");
+    const int anOldCount=aBasis->NbKnots();
+    aBasis->InsertKnot((aLeft+aRight)*.5,aBasis->Degree(),Precision::PConfusion());
+    if(aBasis->NbKnots()==anOldCount)
+      throw Standard_ConstructionError("BRepOffset: cannot refine shared edge endpoint");
+  }
+}
