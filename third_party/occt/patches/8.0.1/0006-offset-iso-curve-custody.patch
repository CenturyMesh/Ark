+static bool CheckOffsetIsoCurve(const occ::handle<Geom_Curve>& theCurve,
+  Adaptor3d_CurveOnSurface& theSource,const double theFirst,const double theLast,
+  const double theTolerance,double& theMaximum,double& theAverage)
+{
+  occ::handle<GeomAdaptor_Curve> aReference=new GeomAdaptor_Curve(theCurve,theFirst,theLast);
+  occ::handle<Adaptor3d_CurveOnSurface> aSource=
+    new Adaptor3d_CurveOnSurface(
+      theSource.GetCurve()->Trim(theFirst,theLast,0.0),theSource.GetSurface());
+  GeomLib_CheckCurveOnSurface aCheck(aReference);aCheck.Perform(aSource);
+  if(!aCheck.IsDone()||!std::isfinite(aCheck.MaxDistance()))return false;
+  theMaximum=aCheck.MaxDistance();theAverage=0.;
+  math_Vector aPoints(1,16),aWeights(1,16);
+  math::GaussPoints(16,aPoints);math::GaussWeights(16,aWeights);
+  for(int i=1;i<=16;++i)
+  {
+    const double aT=(theFirst+theLast)*.5+(theLast-theFirst)*.5*aPoints(i);
+    const double aDistance=theCurve->Value(aT).Distance(theSource.Value(aT));
+    if(!std::isfinite(aDistance))return false;
+    theAverage+=.5*aWeights(i)*aDistance;
+  }
+  for(const double aT:{theFirst,theLast})
+  {
+    const double aDistance=theCurve->Value(aT).Distance(theSource.Value(aT));
+    if(!std::isfinite(aDistance))return false;
+    theMaximum=std::max(theMaximum,aDistance);
+  }
+  return std::isfinite(theAverage)&&theMaximum<=theTolerance;
+}
