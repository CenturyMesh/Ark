<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Every colour of the installer lives here, so matching Studio's theme is a one-file change.
        Graphite surfaces and orange actions over the navy MeshSphere key art. ARK blue appears only in the logo.
    -->

    <!-- base colours -->
    <Color x:Key="DeepColor">#0B1320</Color>              <!-- navy behind the key art, window background -->
    <Color x:Key="GraphiteColor">#303236</Color>          <!-- neutral surface -->
    <Color x:Key="WindowEdgeColor">#3A3D42</Color>        <!-- DWM border on Windows 11 -->
    <Color x:Key="PrimaryColor">#FFA24C</Color>
    <Color x:Key="DangerColor">#E5534B</Color>

    <!-- surfaces and lines -->
    <SolidColorBrush x:Key="Deep" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="Surface" Color="#E0303236" />
    <SolidColorBrush x:Key="Field" Color="#A61A1C20" />
    <SolidColorBrush x:Key="Line" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="LineStrong" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="Track" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Hairline" Color="#2EFFFFFF" />

    <!-- text -->
    <SolidColorBrush x:Key="Text" Color="#F3F5F7" />
    <SolidColorBrush x:Key="TextSoft" Color="#C8D0D7" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA3AD" />
    <SolidColorBrush x:Key="TextDim" Color="#6E7781" />

    <!-- actions -->
    <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHover" Color="#FFB46B" />
    <SolidColorBrush x:Key="PrimaryPressed" Color="#E98E3A" />
    <SolidColorBrush x:Key="OnPrimary" Color="#1A1C20" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#1FFFA24C" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHover" Color="#EC6B63" />
    <SolidColorBrush x:Key="DangerPressed" Color="#C9453E" />
    <SolidColorBrush x:Key="DangerSoft" Color="#1FE5534B" />
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CloseHover" Color="#E5534B" />
    <SolidColorBrush x:Key="OnClose" Color="#FFFFFF" />

    <!-- shades over the key art -->
    <!-- graphite #303236 at about 90 % over the art, easing out before the sphere -->
    <LinearGradientBrush x:Key="PanelShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EB303236" Offset="0" />
        <GradientStop Color="#E3303236" Offset="0.36" />
        <GradientStop Color="#A3303236" Offset="0.46" />
        <GradientStop Color="#3D303236" Offset="0.56" />
        <GradientStop Color="#00303236" Offset="0.66" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#800B1320" Offset="0" />
        <GradientStop Color="#000B1320" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B1320" Offset="0" />
        <GradientStop Color="#990B1320" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DialogShade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F0303236" Offset="0" />
        <GradientStop Color="#DB303236" Offset="0.55" />
        <GradientStop Color="#8C303236" Offset="1" />
    </LinearGradientBrush>
    <!-- the key art fades in from its left and top edges, so they never show a seam -->
    <LinearGradientBrush x:Key="ArtFadeLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.16" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ArtFadeTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.1" />
    </LinearGradientBrush>

    <!-- Windows fonts only (nothing bundled); Segoe UI where the variable faces are absent. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="WindowRadius">14</CornerRadius>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Kicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Main action: flat orange. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryPressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary action: hairline outline. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="{StaticResource ControlRadius}" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Line}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive action (uninstall). -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource OnDanger}" />
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DangerHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DangerPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text link (Options, Open the log). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar buttons (minimise, close). -->
    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource CloseHover}" />
                            <Setter Property="Foreground" Value="{StaticResource OnClose}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box: rounded square, orange when on. -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{StaticResource Field}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 4,9 L 7.5,12.5 L 14,5.5" Stroke="{StaticResource OnPrimary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" Margin="-1" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Path field. -->
    <Style x:Key="PathField" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" CornerRadius="{StaticResource ControlRadius}" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Icons (24x24 strokes). -->
    <Geometry x:Key="IconMinimize">M 0,0.5 L 10,0.5</Geometry>
    <Geometry x:Key="IconClose">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>
    <Geometry x:Key="IconChevronRight">M 9,6 L 15,12 L 9,18</Geometry>
    <Geometry x:Key="IconChevronLeft">M 15,6 L 9,12 L 15,18</Geometry>
    <Geometry x:Key="IconFolder">M 3,7 A 2,2 0 0 1 5,5 L 9.5,5 L 11.5,7.5 L 19,7.5 A 2,2 0 0 1 21,9.5 L 21,17 A 2,2 0 0 1 19,19 L 5,19 A 2,2 0 0 1 3,17 Z</Geometry>
    <Geometry x:Key="IconCheck">M 5,12.5 L 10,17.5 L 19.5,7</Geometry>
    <Geometry x:Key="IconAlert">M 12,7 L 12,13.5 M 12,17 L 12,17.2</Geometry>

</ResourceDictionary>
