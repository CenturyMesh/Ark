<w:ChromeWindow x:Class="ArkSetup.Windows.SetupWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:w="clr-namespace:ArkSetup.Windows"
                xmlns:c="clr-namespace:ArkSetup.Controls"
                Width="1148" Height="688">

    <Grid x:Name="Root" Margin="24">
        <!-- shadow, drawn once behind the content (Windows 10 only; DWM draws it on Windows 11) -->
        <Border x:Name="Shadow" CornerRadius="{StaticResource WindowRadius}" Background="{StaticResource Deep}">
            <Border.CacheMode>
                <BitmapCache />
            </Border.CacheMode>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black" />
            </Border.Effect>
        </Border>

        <Grid x:Name="Surface" Background="{StaticResource Deep}">
            <c:ArtBackdrop FocusX="0.75" FocusY="0.52" ArtHeight="1.12" />
            <Rectangle IsHitTestVisible="False" Fill="{StaticResource PanelShade}" />
            <Rectangle IsHitTestVisible="False" VerticalAlignment="Top" Height="96" Fill="{StaticResource TopShade}" />
            <Rectangle IsHitTestVisible="False" VerticalAlignment="Bottom" Height="180" Fill="{StaticResource BottomShade}" />

            <!-- drag anywhere on the art -->
            <Border Background="Transparent" MouseLeftButtonDown="DragArea_MouseDown" />

            <!-- title bar -->
            <Grid VerticalAlignment="Top" Height="44">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image x:Name="TitleIcon" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="ARK" Margin="9,0,0,0" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SetupLabel" Margin="7,0,0,0" FontFamily="{StaticResource TextFont}" FontSize="13" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" Click="Minimize_Click">
                        <Path Data="{StaticResource IconMinimize}" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="Close_Click">
                        <Path Data="{StaticResource IconClose}" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- pages (left panel) -->
            <Grid x:Name="Pages" Width="492" HorizontalAlignment="Left" Margin="0,44,0,0">

                <!-- WELCOME -->
                <Grid x:Name="WelcomePage" Margin="56,40,36,44">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="PublisherKicker" Style="{StaticResource Kicker}" />
                        <Image x:Name="WelcomeLogo" Width="268" HorizontalAlignment="Left" Margin="0,22,0,0" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TaglineText" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource Text}"
                                   TextWrapping="Wrap" Margin="0,30,0,0" LineHeight="29" />
                        <TextBlock x:Name="BlurbText" Style="{StaticResource Body}" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,14" TextWrapping="NoWrap" />
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Width="300" HorizontalAlignment="Left" Click="Install_Click" IsDefault="True">
                            <TextBlock x:Name="InstallButtonText" />
                        </Button>
                        <Grid Width="300" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <TextBlock x:Name="InstallPathText" Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDim}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,84,0" VerticalAlignment="Center" />
                            <Button x:Name="OptionsLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="Options_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OptionsLinkText" />
                                    <Path Data="{StaticResource IconChevronRight}" Width="5" Height="9" Stretch="Fill" StrokeThickness="1.5" Margin="7,1,0,0" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- OPTIONS -->
                <Grid x:Name="OptionsPage" Margin="56,40,36,44" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="OptionsKicker" Style="{StaticResource Kicker}" />
                        <TextBlock x:Name="OptionsTitle" Style="{StaticResource Heading}" Margin="0,10,0,0" />
                        <TextBlock x:Name="OptionsSub" Style="{StaticResource Body}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        <TextBlock x:Name="FolderLabel" Style="{StaticResource Kicker}" Margin="0,26,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DirBox" Style="{StaticResource PathField}" TextChanged="DirBox_TextChanged" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="40" Padding="14,0" Margin="8,0,0,0" Click="Browse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Width="15" Height="12" Stretch="Fill" StrokeThickness="1.4" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock x:Name="BrowseText" Margin="8,0,0,0" FontWeight="Normal" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DirError" Style="{StaticResource Body}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed" />
                        <CheckBox x:Name="DesktopCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,20,0,0" />
                        <CheckBox x:Name="StartMenuCheck" Style="{StaticResource Check}" IsChecked="True" Margin="0,12,0,0" />
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,22,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SpaceRequiredLabel" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextMuted}" />
                            <TextBlock Grid.Column="1" x:Name="SpaceRequiredValue" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="NoWrap" />
                            <TextBlock Grid.Row="1" x:Name="SpaceAvailableLabel" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SpaceAvailableValue" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextSoft}" TextWrapping="NoWrap" Margin="0,4,0,0" />
                        </Grid>
                        <TextBlock x:Name="DataNote" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource TextDim}" Margin="0,14,0,0" LineHeight="18" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Click="Back_Click" Padding="16,0,22,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChevronLeft}" Width="5" Height="9" Stretch="Fill" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="BackText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OptionsInstallButton" Style="{StaticResource PrimaryButton}" Width="196" Margin="10,0,0,0" Click="Install_Click">
                            <TextBlock x:Name="OptionsInstallText" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- INSTALLING -->
                <Grid x:Name="InstallingPage" Margin="56,40,36,44" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="InstallingKicker" Style="{StaticResource Kicker}" />
                        <TextBlock x:Name="InstallingTitle" Style="{StaticResource Heading}" Margin="0,10,0,0" />
                        <TextBlock x:Name="PercentText" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="76" Foreground="{StaticResource Text}"
                                   Margin="-4,34,0,6" Text="0%" />
                        <Grid x:Name="BarTrack" Height="4">
                            <Border CornerRadius="2" Background="{StaticResource Track}" />
                            <Border x:Name="BarFill" CornerRadius="2" Background="{StaticResource Primary}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="StatusText" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,150,0" />
                            <TextBlock x:Name="BytesText" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="QuietText" VerticalAlignment="Bottom" Style="{StaticResource Body}" FontSize="13" Foreground="{StaticResource TextDim}" />
                </Grid>

                <!-- DONE -->
                <Grid x:Name="DonePage" Margin="56,40,36,44" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <Grid x:Name="DoneBadge" Width="52" Height="52" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{StaticResource PrimarySoft}" Stroke="{StaticResource Primary}" StrokeThickness="1.5" />
                            <Path Data="{StaticResource IconCheck}" Width="20" Height="14" Stretch="Fill" Stroke="{StaticResource Primary}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                        <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" FontSize="34" Margin="0,28,0,0" />
                        <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" FontSize="15" Foreground="{StaticResource Text}" Margin="0,8,0,0" />
                        <TextBlock x:Name="DoneShortcuts" Style="{StaticResource Body}" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        <TextBlock x:Name="DonePath" Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextDim}" Margin="0,20,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button x:Name="OpenArkButton" Style="{StaticResource PrimaryButton}" Width="214" Click="OpenArk_Click">
                            <TextBlock x:Name="OpenArkText" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Close_Click">
                            <TextBlock x:Name="DoneCloseText" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ERROR -->
                <Grid x:Name="ErrorPage" Margin="56,40,36,44" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top">
                        <Grid Width="52" Height="52" HorizontalAlignment="Left">
                            <Ellipse Fill="{StaticResource DangerSoft}" Stroke="{StaticResource Danger}" StrokeThickness="1.5" />
                            <Path Data="{StaticResource IconAlert}" Width="2.2" Height="16" Stretch="Fill" Stroke="{StaticResource Danger}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock x:Name="ErrorTitle" Style="{StaticResource Heading}" Margin="0,28,0,0" />
                        <ScrollViewer MaxHeight="168" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <TextBlock x:Name="ErrorText" Style="{StaticResource Body}" FontSize="14.5" />
                        </ScrollViewer>
                        <Button x:Name="OpenLogLink" Style="{StaticResource LinkButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="OpenLog_Click">
                            <TextBlock x:Name="OpenLogText" />
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Width="196" Click="TryAgain_Click">
                            <TextBlock x:Name="TryAgainText" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Close_Click">
                            <TextBlock x:Name="ErrorCloseText" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- hairline edge (Windows 10) -->
            <Border x:Name="Hairline" CornerRadius="{StaticResource WindowRadius}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</w:ChromeWindow>
